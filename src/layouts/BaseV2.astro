---
/**
 * Basislayout van het Engelse cluster. Sinds 25 oktober 2026 gebruikt elke pagina in
 * src/pages deze; Base.astro is daarmee verdwenen en er is weer één <head>.
 *
 * Het bevroren Nederlandse cluster in public/ staat hier los van: die 30 pagina's
 * laden /css/style.css en /js/main.js rechtstreeks. Die twee bestanden blijven dus
 * staan, ook al verwijst er niets in src/ meer naar.
 *
 * De stylesheet is een statisch bestand (public/css/ha.css), niet een import uit
 * src/. De bundelaar van Astro kan moderne CSS (light-dark(), @layer) herschrijven
 * voor oudere doelen; dit bestand moet precies zo in de browser komen als het is
 * ontworpen en getest.
 *
 * De tint van de metriek (`hue`) en de zes kaartkleuren staan als variabelen op <html>,
 * op de server uitgerekend (src/lib/hue.js). Daar is geen clientcode voor nodig.
 *
 * Het thema: de bezoeker volgt het systeem tot hij zelf kiest. Die keuze staat in het
 * profiel (`humanaverage:profile`, dezelfde ene sleutel als land en leeftijd), en wordt
 * vóór de eerste verf gezet zodat er geen flits is. Schrijf het profiel dus altijd als
 * samenvoeging van wat er al staat, nooit als vervanging.
 */
import { hueStyle } from '../lib/hue.js';
import { localeOf, prefixOf, alternatesOf } from '../lib/locales.js';
import { CATALOGUE } from '../lib/catalogue.js';
import { NOTES, NOTES_LINK } from '../lib/notes.js';

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
  /** Tint van de metriek, zie STAGES in src/lib/hue.js. */
  hue?: number;
  /** Pad naar een voorbeeldafbeelding voor links in sociale media. Zonder: geen og:image. */
  ogImage?: string;
}

const { title, description, canonical, noindex = false, hue = 262, ogImage } = Astro.props;
/**
 * De taal komt uit het pad, niet uit een prop. Zo hoeft geen van de twintig pagina's
 * ervan te weten: die geven hun canonieke pad zonder voorvoegsel door ("/wealth/") en
 * deze layout zet het voorvoegsel van de taal ervoor. Zolang Engels de enige taal is,
 * is dat voorvoegsel leeg en verandert er niets aan de uitvoer.
 */
const lang = localeOf(Astro.url.pathname);
const canonicalUrl = new URL(`${prefixOf(lang)}${canonical}`, Astro.site).href;

/** Leeg zolang er één taal is; zie alternatesOf() in src/lib/locales.js. */
const alternates = alternatesOf(canonical);

const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : null;

/**
 * Zonder taalvoorvoegsel, want de navigatie vergelijkt dit met paden als "/wealth/"
 * uit de catalogus. Zonder deze regel zou het menu op een Nederlandse pagina niets
 * meer markeren — en dat zou pas opvallen als de tweede taal er al stond.
 */
const here = Astro.url.pathname.slice(prefixOf(lang).length) || '/';

const isCurrent = (href: string) => here === href || here.startsWith(href);

/**
 * Staan we zelf op een metriekpagina? Alleen dan is een klik in het paneel een
 * tweede metriek, en alleen dan hoort `second_metric_opened` af te gaan. Vanaf de
 * homepage is het de eerste.
 */
const onMetric = CATALOGUE.some((metric) => isCurrent(metric.path));

/** Alleen --h: de rest van de tintvariabelen leidt ha.css zelf af op .hued. */
const cardStyle = (metric: (typeof CATALOGUE)[number], i: number) =>
  [`--i:${i}`, `--h:${metric.hue}`, metric.at === null ? '' : `--at:${metric.at.toFixed(1)}%`]
    .filter(Boolean)
    .join(';');
---

<!doctype html>
<html lang={lang} style={hueStyle(hue)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/*
      Elke taalversie van deze pagina, en een x-default naar de Engelse. Dit blok is
      leeg zolang LOCALES één taal bevat, zodat deze fase de HTML niet verandert.

      Let op bij het uitbreiden: `lang` hierboven en deze hreflang moeten het altijd
      met elkaar eens zijn. Op eudebtmap.com staat <html lang="en"> óók op /de, /nl en
      /fr — de hreflang zegt daar Duits en het lang-attribuut Engels. De poort uit
      research/i18n-plan.md hoort daar precies op te controleren.
    */}
    {alternates.map(({ lang: alt, path }) => (
      <link rel="alternate" hreflang={alt} href={new URL(path, Astro.site).href} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={new URL(canonical, Astro.site).href} />
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f9fafd" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#050815" />

    {/*
      Vier verwijzingen voor één icoon, en dat is nodig. De SVG is wat een browser
      in het tabblad zet; **Google haalt daarnaast /favicon.ico op** en die bestond
      niet, waardoor er in de zoekresultaten de terugval van Google stond in plaats
      van ons logo. De PNG's zijn er voor Android en iOS. Alle vier komen uit
      dezelfde SVG via scripts/build-icons.mjs.
    */}
    <link rel="icon" href="/favicon-ha.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/bricolage-grotesque-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-variable.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var profile = JSON.parse(localStorage.getItem('humanaverage:profile') || 'null');
          if (profile && (profile.theme === 'light' || profile.theme === 'dark')) {
            root.dataset.theme = profile.theme;
            return;
          }
        } catch (error) {
          // Privémodus of geblokkeerde opslag: dan volgt de pagina gewoon het systeem.
        }
        root.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
    <link rel="stylesheet" href="/css/ha.css" />
    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#content">Skip to content</a>

    <header class="nav-shell">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="HumanAverage home">
          <svg class="mark" viewBox="0 0 36 16" aria-hidden="true">
            <defs>
              <linearGradient id="ha-spectrum" x1="0" x2="1">
                <stop offset="0" style="stop-color: var(--sp0)"></stop>
                <stop offset=".25" style="stop-color: var(--sp1)"></stop>
                <stop offset=".5" style="stop-color: var(--sp2)"></stop>
                <stop offset=".75" style="stop-color: var(--sp3)"></stop>
                <stop offset="1" style="stop-color: var(--sp4)"></stop>
              </linearGradient>
            </defs>
            <rect width="36" height="16" rx="8" fill="url(#ha-spectrum)"></rect>
            <circle cx="24" cy="8" r="4.6" fill="#fff"></circle>
          </svg>
          <span>HumanAverage</span>
        </a>

        <button class="cat-btn" type="button" popovertarget="metrics-menu" aria-expanded="false">
          <span>Metrics</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>

        <a class="nav-method" href={NOTES_LINK} aria-current={here.startsWith('/notes/') ? 'page' : undefined}>Notes</a>

        <a class="nav-method" href="/method/" aria-current={isCurrent('/method/') ? 'page' : undefined}>Method</a>

        <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Switch theme">
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>

      </nav>

      <div id="metrics-menu" class="catalogue" popover data-on-metric={onMetric ? 'yes' : 'no'}>
        <nav aria-label="All metrics">
            <div class="cat-grid">
          {
            CATALOGUE.map((metric, i) => (
              <a
                class="cat-card hued"
                href={metric.path}
                style={cardStyle(metric, i)}
                aria-current={isCurrent(metric.path) ? 'page' : undefined}
                data-metric={metric.key}
              >
                <span class="name">{metric.label}</span>
                {metric.value && (
                  <span class="val">
                    <span data-count>{metric.value}</span>
                    <small>{metric.unit}</small>
                  </span>
                )}
                {metric.at !== null && (
                  <span class="bar">
                    <span class="track"><i /></span>
                    <span class="ends">
                      <span>{metric.low}</span>
                      <span>{metric.high}</span>
                    </span>
                  </span>
                )}
              </a>
            ))
          }

          <a class="cat-card cat-method" href="/method/" style={`--i:${CATALOGUE.length}`} data-method-card>
            <span class="cue">How we read it</span>
            <span class="name">Sources, and the breaks we refuse to cross</span>
            <span class="go" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h13M12 5l7 7-7 7"></path>
              </svg>
            </span>
          </a>
        </div>

            {
              NOTES.length > 0 && (
                <div class="cat-notes">
                  {NOTES.slice(0, 1).map((note) => (
                    <a class="cat-note" href={note.path} data-note-card>
                      <span class="cue">Note</span>
                      <span class="name">{note.card}</span>
                      <span class="go" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 12h13M12 5l7 7-7 7"></path>
                        </svg>
                      </span>
                    </a>
                  ))}

                  {/*
                    De weg naar het overzicht hoort in het paneel, niet alleen in de
                    balk. Onder 560px verbergt de balk zijn losse links (.nav-method)
                    en dan was /notes/ nergens meer vanaf de kop te bereiken: de
                    strip hierboven wijst naar het nieuwste artikel, niet naar de
                    lijst. Op een telefoon bestond het overzicht dus niet.
                  */}
                  <a class="cat-note cat-note--all" href={NOTES_LINK} data-note-card>
                    <span class="cue">All</span>
                    <span class="name">{NOTES.length === 1 ? 'Every note' : `All ${NOTES.length} notes`}</span>
                    <span class="go" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h13M12 5l7 7-7 7"></path>
                      </svg>
                    </span>
                  </a>
                </div>
              )
            }
          </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-cols">
          <div>
            <p>
              One question per page, answered from figures that Eurostat, the OECD and the ECB
              publish themselves. Nothing is estimated on top, and every number is traceable to
              its source.
            </p>
          </div>
          <div>
            <h3>Every metric</h3>
            <div class="foot-links">
              {CATALOGUE.map((metric) => <a href={metric.path}>{metric.label}</a>)}
              <a href="/method/">How we calculate it</a>
            </div>
          </div>
          <div>
            <h3>About</h3>
            <div class="foot-links">
              <a href="/about/">About</a>
              <a href="/contact/">Contact</a>
              <a href="/privacy/">Privacy</a>
              {NOTES.slice(0, 3).map((note) => <a href={note.path}>{note.title}</a>)}
              {NOTES.length > 3 && <a href="/notes/">All notes</a>}
            </div>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© <span data-current-year>2026</span> HumanAverage</span>
          <span>Not medical advice. Informational comparison only.</span>
        </div>
        <div class="wordmark" aria-hidden="true">HumanAverage</div>
      </div>
    </footer>

    <script>
      /**
       * Wat elke v2-pagina nodig heeft: de themaknop, het onthullen bij scrollen en het jaartal.
       * Alles hier is versiering of gemak: zonder JavaScript staat de inhoud er gewoon,
       * leesbaar en in het thema van het systeem.
       */
      import { readProfile, mergeProfile } from '../lib/profile.js';
      import { track, EVENTS } from '../lib/analytics.js';
      import { readCounter, animate, countWhenVisible } from '../lib/countup.js';

      const root = document.documentElement;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /**
       * Samenvoegen, niet vervangen: land en leeftijd staan in dezelfde sleutel.
       * mergeProfile doet dat en gooit nooit, ook niet zonder localStorage.
       */
      const saveTheme = (theme: 'light' | 'dark') => mergeProfile({ theme });

      const currentTheme = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');
      const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')];

      function labelButtons() {
        const label = currentTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
        for (const button of buttons) button.setAttribute('aria-label', label);
      }

      labelButtons();

      for (const button of buttons) {
        button.addEventListener('click', () => {
          const next = currentTheme() === 'dark' ? 'light' : 'dark';
          const apply = () => {
            root.dataset.theme = next;
            saveTheme(next);
            labelButtons();
          };

          // Een cirkel die uit de knop groeit, waar View Transitions bestaan; anders gewoon wisselen.
          if (!('startViewTransition' in document) || reduceMotion) return apply();

          const box = button.getBoundingClientRect();
          const x = box.left + box.width / 2;
          const y = box.top + box.height / 2;
          const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          const transition = (document as any).startViewTransition(apply);
          transition.ready
            .then(() =>
              root.animate(
                { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
                { duration: 650, easing: 'cubic-bezier(.2,.8,.2,1)', pseudoElement: '::view-transition-new(root)' },
              ),
            )
            .catch(() => {});
        });
      }

      // Zolang de bezoeker niets koos, volgt het thema het systeem.
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
        if (readProfile().theme) return;
        root.dataset.theme = event.matches ? 'dark' : 'light';
        labelButtons();
      });

      // De nav-pil wordt donker zolang hij boven een donker podium (.stage-sec) zweeft.
      const shell = document.querySelector<HTMLElement>('.nav-shell');
      const stages = [...document.querySelectorAll<HTMLElement>('.stage-sec')];
      if (shell && stages.length) {
        let waiting = false;
        const check = () => {
          waiting = false;
          const over = stages.some((stage) => {
            const box = stage.getBoundingClientRect();
            return box.top <= 44 && box.bottom >= 44;
          });
          shell.toggleAttribute('data-dark', over);
        };
        addEventListener(
          'scroll',
          () => {
            if (waiting) return;
            waiting = true;
            requestAnimationFrame(check);
          },
          { passive: true },
        );
        addEventListener('resize', check);
        check();
      }

      const reveals = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              observer.unobserve(entry.target);
            }
          },
          /**
           * Drempel 0, niet 0,15. Een blok dat hoger is dan het venster gedeeld door
           * de drempel kan die drempel nooit halen: op een telefoon van 740px is dat
           * alles boven ~4.900px, en zo'n blok bleef dus voor altijd onzichtbaar. De
           * OECD-sectie op /pension-age/ is op mobiel ruim 8.000px hoog en viel daar
           * precies in. De marge onderaan doet nu het werk dat de drempel deed: een
           * blok verschijnt zodra zijn bovenrand de onderste 12% van het venster in
           * komt, ongeacht hoe hoog het is.
           */
          { threshold: 0, rootMargin: '0px 0px -12% 0px' },
        );
        for (const element of reveals) observer.observe(element);
      } else {
        for (const element of reveals) element.classList.add('in');
      }

      for (const node of document.querySelectorAll('[data-current-year]')) {
        node.textContent = String(new Date().getFullYear());
      }

      /**
       * Het kopcijfer van de pagina loopt op zodra het in beeld komt. Elke pagina heeft er
       * precies één (.giant). De echte waarde staat in de HTML en komt daar na afloop weer
       * terug te staan, dus zonder JavaScript of met beperkte beweging mist er niets.
       */
      countWhenVisible(document.querySelectorAll<HTMLElement>('.giant'));

      /**
       * Het paneel met de metrieken. Alles wat beweegt doet CSS — het openen, de kaarten na
       * elkaar, en de balk die naar zijn breedte groeit. Alleen de cijfers hebben een script,
       * en dat is dezelfde lib als hierboven; hier alleen bij het openen in plaats van bij
       * het in beeld komen.
       */
      const panel = document.getElementById('metrics-menu');
      const catButton = document.querySelector<HTMLButtonElement>('.cat-btn');

      if (panel && catButton) {
        const counters = [];
        for (const node of panel.querySelectorAll<HTMLElement>('[data-count]')) {
          const counter = readCounter(node);
          if (counter) counters.push(counter);
        }

        let stop = () => {};

        // `toggle` vuurt ná de wissel, dus :popover-open staat er al goed voor.
        panel.addEventListener('toggle', () => {
          const open = panel.matches(':popover-open');
          catButton.setAttribute('aria-expanded', String(open));
          stop();
          if (open && !reduceMotion) stop = animate(counters);
        });

        // Een klik hierin is pas een tweede metriek als je er al op een staat.
        if (panel.dataset.onMetric === 'yes') {
          for (const card of panel.querySelectorAll<HTMLAnchorElement>('[data-metric]')) {
            card.addEventListener('click', () => {
              track(EVENTS.secondMetricOpened, { from: location.pathname, to: card.dataset.metric });
            });
          }
        }

        for (const card of panel.querySelectorAll('[data-method-card]')) {
          card.addEventListener('click', () => {
            track(EVENTS.methodologyOpened, { from: location.pathname });
          });
        }
      }
    </script>
  </body>
</html>
