---
/**
 * Basislayout voor het Engelstalige percentielproduct.
 *
 * Hergebruikt /css/style.css uit het bevroren Nederlandse cluster, inclusief de
 * toegankelijkheidspatronen daar: skip-link, aria-labels en .visually-hidden.
 *
 * De merknaam linkt naar /, de Engelse homepage. Tot 24 oktober 2026 wees hij naar
 * /height/ omdat er toen nog geen Engelse root was.
 */
interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="theme-color" content="#15231f" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/style.css" />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="HumanAverage home">
          <span class="brand-mark" aria-hidden="true"></span>
          HumanAverage
        </a>
        <button
          class="menu-button"
          type="button"
          data-menu-button
          aria-expanded="false"
          aria-controls="main-navigation"
        >
          <span aria-hidden="true">☰</span>
          <span class="visually-hidden">Open menu</span>
        </button>
        <nav class="site-nav" id="main-navigation" data-navigation aria-label="Main navigation">
          <a href="/leaving-home/">Leaving home</a>
          <a href="/wealth/">Wealth</a>
          <a href="/method/">Method</a>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/" style="color: var(--ink)">
              <span class="brand-mark" aria-hidden="true" style="border-color: var(--ink)"></span>
              HumanAverage
            </a>
            <p>
              One question per page, answered from figures that Eurostat, the OECD and the ECB
              publish themselves. Nothing is estimated on top, and every number is traceable to
              its source.
            </p>
          </div>
          <div>
            <h3>Compare yourself</h3>
            <div class="footer-links">
              <a href="/leaving-home/">Leaving home in Europe</a>
              <a href="/wealth/">European wealth</a>
              <a href="/method/">How we calculate it</a>
            </div>
          </div>
          <div>
            <h3>About</h3>
            <div class="footer-links">
              <a href="/about/">About</a>
              <a href="/contact/">Contact</a>
              <a href="/privacy/">Privacy</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© <span data-current-year>2026</span> HumanAverage</span>
          <span>Not medical advice. Informational comparison only.</span>
        </div>
      </div>
    </footer>

    <script src="/js/main.js" is:inline></script>
  </body>
</html>
