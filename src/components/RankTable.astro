---
/**
 * De volledige tabel onder de kaart, in de nieuwe vormtaal. Vervangt in stap 4
 * CountryTable.astro op dezelfde plek; de kolommen, de volgorde en het sorteergedrag zijn
 * dezelfde, er komt een kolom bij: het trendlijntje.
 *
 * Dit is niet de "toegankelijke versie" van de kaart maar de echte inhoud: hier staat elk
 * cijfer, hier leest een zoekmachine de pagina, en hier komt iemand die zijn eigen land
 * zoekt in plaats van naar een plaatje te kijken. De kaart is de samenvatting; deze tabel
 * is het bewijs.
 *
 * Het lijntje breekt af bij elke reeksbreuk van Eurostat (src/lib/sparkline.js): een lijn
 * die over een breuk heen loopt toont een sprong die niets betekent. Het lijntje is
 * versiering voor wie ziet; wat een schermlezer hoort is het bereik en de breukjaren, en
 * uitdrukkelijk geen "gestegen" of "gedaald", want juist dat laat een breuk niet toe.
 *
 * Sorteren gebeurt in de browser, maar de tabel staat volledig en in een zinnige volgorde
 * (van vroeg naar laat) in de HTML. Zonder JavaScript mis je alleen het sorteren.
 */
import { localeOf } from '../lib/locales.js';
import { ui, fill } from '../lib/ui.js';
import { formatAmount, formatValue } from '../lib/metric.js';
import { periodLabel, periodNumber, periodShort, periodUnit } from '../lib/period.js';
import { sparkline, sparkElements, SPARK_SIZES } from '../lib/sparkline.js';

/** De taal van deze pagina, en de vaste tekst erin. Zie src/lib/ui.js. */
const lang = localeOf(Astro.url.pathname);
const t = ui(lang).rankTable;

interface Props {
  /** Het gebouwde databestand van de metriek. */
  index: any;
  /** De beschrijving uit src/lib/metrics/: eenheid en decimalen. */
  metric: any;
}

const { index, metric } = Astro.props;
const latestYear: string = index.latestYear;
const yearMin: string = index.years[0];
const yearMax: string = latestYear;

/** 'year' bij de jaarreeksen, 'month' bij werkloosheid. Bepaalt de woorden, niet de opmaak. */
/**
 * Het woord voor de periode-eenheid, in de taal van deze pagina. periodUnit() geeft
 * een sleutel ('year' bij de jaarreeksen, 'month' bij werkloosheid) en ui.json geeft
 * het woord — anders stond er "hun meest recente year" op een Nederlandse pagina, en
 * dat stond er tot 5 november 2026 ook.
 */
const grain = ui(lang).periodUnits[periodUnit(latestYear)];

const rows = [...(index.countries as any[])].sort((a, b) => a.total - b.total);
const behind = rows.filter((row) => row.year !== latestYear).length;

/** De perioden waar het lijntje van een rij werkelijk een kerfje krijgt: alles ná de eerste waarneming. */
const notchedIn = (row: any) => {
  const first = Math.min(...Object.keys(row.series).map(periodNumber));
  return (row.breaks as string[]).filter((period) => periodNumber(period) > first);
};

/**
 * Tellen op `index.lastBreak` was goed genoeg zolang elke dataset op één moment brak:
 * Eurostat herzag in 2021 de hele Labour Force Survey, dus vrijwel elk land had dezelfde
 * vlag. Werkloosheid breekt per land — Malta in januari 2025, Denemarken in oktober 2023 —
 * en dan zei deze voetnoot "1 van de 30" onder een tabel met twee kerfjes.
 */
const broken = rows.filter((row) => notchedIn(row).length > 0).length;
const breakPeriods = [...new Set(rows.flatMap(notchedIn))].sort(
  (a, b) => periodNumber(a) - periodNumber(b),
);

/**
 * De voetnoot onder de tabel paste maar op één dataset.
 *
 * Hij beloofde "de gap is mannen min vrouwen" onder twee lege kolommen, schreef elke
 * breuk toe aan de Labour Force Survey (terwijl huishoudgrootte uit EU-SILC komt), en
 * bij een dataset zonder breuk werd het "in  the EU Labour Force Survey was
 * reorganized". Drie beweringen, drie keer onwaar op minstens één pagina. Nu zegt hij
 * alleen wat voor déze dataset geldt.
 */
const hasSexes = rows.some((row) => row.men !== null && row.women !== null);
const oneYear = (index.years as string[]).length === 1;
const publisher = index.source?.publisher ?? 'The publisher';

const gapOf = (row: any) => (row.men !== null && row.women !== null ? row.men - row.women : null);

/** "A", "A and B", "A, B and C". */
/** "a and b", "a, b and c" — het voegwoord komt uit het woordenbestand van de taal. */
const list = (items: string[]) =>
  items.length < 3
    ? items.join(` ${t.and} `)
    : `${items.slice(0, -1).join(', ')} ${t.and} ${items[items.length - 1]}`;

const line = (row: any) => {
  const spark = sparkline(row.series, row.breaks, { ...SPARK_SIZES.row, yearMin, yearMax });
  const periods = Object.keys(row.series).sort((a, b) => periodNumber(a) - periodNumber(b));
  const breaks = notchedIn(row);
  return {
    spark,
    note:
      fill(t.trendFrom, {
        from: periodLabel(periods[0], { locale: lang }),
        to: periodLabel(periods[periods.length - 1], { locale: lang }),
      }) +
      (breaks.length
        ? ` ${fill(t.breaksIn, { periods: breaks.map((p) => periodLabel(p, { locale: lang })).join(', ') })}`
        : ''),
  };
};

/**
 * De tabeltitel voor een schermlezer en voor een zoekmachine.
 *
 * Hier stond één vaste zin over de leeftijd waarop jongeren het huis uit gaan — op alle
 * negen metriekpagina's, dus op acht ervan onwaar. Dezelfde fout als de legenda van de
 * kaart eerder, en dezelfde oplossing: de zin komt uit de beschrijving van de metriek.
 */
const caption =
  `${metric.words.legend}. ${fill(t.captionAt, {
    count: rows.length - behind,
    period: periodLabel(latestYear, { locale: lang }),
  })}` + (behind > 0 ? `; ${fill(t.captionBehind, { count: behind, grain })}` : '.');
---

<div class="tablewrap" tabindex="0" role="region" aria-label={t.everyCountrySortableTable} data-reveal>
  <table data-rank-table>
    <caption class="vh">{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="sortable" aria-sort="none">
          <button type="button" data-sort="name" data-type="text">{t.country}</button>
        </th>
        <th scope="col" class="n sortable" aria-sort="ascending">
          <button type="button" data-sort="total" data-type="number">{t.everyone}</button>
        </th>
        <th scope="col" class="n sortable" aria-sort="none">
          <button type="button" data-sort="men" data-type="number">{t.men}</button>
        </th>
        <th scope="col" class="n sortable" aria-sort="none">
          <button type="button" data-sort="women" data-type="number">{t.women}</button>
        </th>
        <th scope="col" class="n sortable" aria-sort="none">
          <button type="button" data-sort="gap" data-type="number">{t.gap}<span class="vh">{' '}{t.gapBetween}</span></button>
        </th>
        <th scope="col">{fill(t.trendColumn, { from: periodShort(yearMin, { locale: lang }), to: periodShort(yearMax, { locale: lang }) })}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => {
          const gap = gapOf(row);
          const { spark, note } = line(row);
          return (
            <tr data-name={row.name} data-total={row.total} data-men={row.men ?? ''} data-women={row.women ?? ''} data-gap={gap ?? ''}>
              <th scope="row">
                {row.name}
                {row.year !== latestYear && <span class="stale-year">{periodShort(row.year, { locale: lang })}</span>}
              </th>
              <td class="n strong">{formatValue(row.total, metric)}</td>
              <td class="n">{formatValue(row.men, metric)}</td>
              <td class="n">{formatValue(row.women, metric)}</td>
              <td class="n">{gap === null ? '—' : formatAmount(gap, metric, { sign: true })}</td>
              <td class="trend">
                {
                  spark ? (
                    <>
                      <svg
                        class="spark"
                        viewBox={`0 0 ${SPARK_SIZES.row.width} ${SPARK_SIZES.row.height}`}
                        preserveAspectRatio="none"
                        aria-hidden="true"
                      >
                        {
                          sparkElements(spark).map((item) => {
                            const Tag = item.tag as any;
                            return <Tag {...item.attrs} />;
                          })
                        }
                      </svg>
                      <span class="vh">{note}</span>
                    </>
                  ) : (
                    '—'
                  )
                }
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<p class="brk-foot">
  {hasSexes && <>{t.gapExplained}{' '}</>}
  {behind > 0 && (
    <>
      {fill(t.behindExplained, {
        grain,
        publisher,
        period: periodLabel(latestYear, { locale: lang }),
      })}{' '}
    </>
  )}
  {oneYear
    ? fill(t.oneYearOnly, { publisher, period: periodLabel(latestYear, { locale: lang }) })
    : breakPeriods.length > 0
      ? fill(t.breaksExplained, {
          broken,
          of: rows.length,
          periods: list(breakPeriods.map((p) => periodLabel(p, { locale: lang }))),
        })
      : fill(t.noBreaks, {
          publisher,
          from: periodLabel(index.years[0], { locale: lang }),
          to: periodLabel(latestYear, { locale: lang }),
        })}
</p>

<script>
  /**
   * Sorteren op de kolomknoppen. Bewust geen bibliotheek: het is een tabel met 34 rijen en de
   * waarden staan al als data-attributen op de rij.
   */
  for (const table of document.querySelectorAll<HTMLTableElement>('[data-rank-table]')) {
    const body = table.querySelector('tbody');
    if (!body) continue;

    for (const button of table.querySelectorAll<HTMLButtonElement>('th button[data-sort]')) {
      button.addEventListener('click', () => {
        const key = button.dataset.sort ?? '';
        const numeric = button.dataset.type === 'number';
        const header = button.closest('th');
        const direction = header?.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';

        for (const other of table.querySelectorAll('th[aria-sort]')) other.setAttribute('aria-sort', 'none');
        header?.setAttribute('aria-sort', direction);

        const rows = [...body.querySelectorAll<HTMLTableRowElement>('tr')];
        rows.sort((a, b) => {
          const left = a.dataset[key] ?? '';
          const right = b.dataset[key] ?? '';

          // Rijen zonder waarde horen onderaan, in welke richting je ook sorteert.
          if (left === '' && right === '') return 0;
          if (left === '') return 1;
          if (right === '') return -1;

          const result = numeric ? Number(left) - Number(right) : left.localeCompare(right);
          return direction === 'ascending' ? result : -result;
        });

        for (const row of rows) body.appendChild(row);
      });
    }
  }
</script>
