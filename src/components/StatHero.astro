---
/**
 * De kop van de pagina: het antwoord eerst, op posterformaat, naast een donker paneel
 * met de stippengrafiek en een landkiezer.
 *
 * De kop volgt de definitie van Eurostat en niet zijn label (zie src/lib/leaving-home.js):
 * dit is de leeftijd waarop de helft niet meer bij de ouders woont, een middelpunt, geen
 * gemiddelde. De zoekvraag luidt wel "average age", dus die formulering staat in de
 * noot onder de knop en wordt daar uitgelegd in plaats van weggelaten.
 *
 * Elk getal komt uit de bibliotheek. De eindwaarde staat in de HTML, ook zonder
 * JavaScript; de browser voegt alleen toe wat een keuze oplevert: de zin onder de kiezer
 * en de markering in de grafiek.
 *
 * ELKE ZIN KOMT UIT ui.json, SINDS 8 NOVEMBER 2026
 *
 * Tot die dag stond alle tekst hier in het Engels, ook op /nl/leaving-home/ — het
 * paginabestand was Nederlands, dit onderdeel niet, en dat liep dóór een zin heen:
 * "In Kroatië it does not arrive until 31,5". De groep `statHero` stond al klaar en was
 * leeg op vier sleutels na.
 *
 * Drie zinnen dragen opmaak in het midden (de twee vetgezette landnamen, de cursieve
 * zoekterm, de link naar de methode) en worden daarom met `set:html` gezet. Wat erin
 * gevuld wordt komt uit onze eigen data — landnamen uit CLDR en getallen uit de
 * bibliotheek — nooit uit invoer van een bezoeker.
 *
 * Contract met de pagina: de pagina rendert `<script type="application/json"
 * id="leaving-home-data">` met `clientData(index)` (src/lib/leaving-home-copy.js).
 * De kiezer stuurt `ha:country` op `document` en luistert ernaar, zodat hij gelijk
 * loopt met de landkiezer van het formulier en de grafiek. Het onthouden van de keuze
 * is aan de pagina, niet aan dit onderdeel.
 */
import { localeOf } from '../lib/locales.js';
import { ui, fill } from '../lib/ui.js';
import { grammarOf } from '../lib/grammar.js';
import DotPlot from './DotPlot.astro';
import { age, years, headline, ranked, currentCountries } from '../lib/leaving-home.js';
import { euChange } from '../lib/leaving-home-copy.js';

/** De taal van deze pagina, en de vaste tekst erin. Zie src/lib/ui.js. */
const lang = localeOf(Astro.url.pathname);
const t = ui(lang).statHero;
const g = grammarOf(lang);

interface Props {
  index: any;
}

const { index } = Astro.props;

const h = headline(index);
const order = ranked(index);
/** De locale hoorde ook op dit terugvalpad: zonder EU-rij schreef het "26.3" op /nl/. */
const euValue = age(
  (h.eu ? h.eu : order[Math.floor(order.length / 2)]).total,
  { locale: lang },
);
const change = euChange(index);

const rows = order.map(({ code, name, total }) => ({ code, name, total }));
const options = [...currentCountries(index)].sort((a, b) => a.name.localeCompare(b.name));

const low = g.withArticle(h.earliest.name);
const high = g.withArticle(h.latest.name);
const lowAge = age(h.earliest.total, { locale: lang });
const highAge = age(h.latest.total, { locale: lang });
const gap = years(h.gap, { locale: lang });

const plotLabel =
  fill(t.plotLabel, { countries: h.countries, lowAge, low: h.earliest.name, highAge, high: h.latest.name }) +
  (h.eu ? fill(t.plotLabelEu, { euAge: age(h.eu.total, { locale: lang }) }) : '.');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow mono" data-reveal>
        {fill(t.eyebrow, { countries: h.countries, year: h.year })}
      </p>
      <h1 id="hero-title" data-reveal>
        {t.h1} <span class="giant num">{euValue}</span>
      </h1>
      <p class="unit mono" data-reveal>
        {t.unit} <b>{h.year}</b>{change && <> · {years(change.delta, { sign: true, locale: lang })}{' '}{t.versus}{' '}{change.previousYear}</>}
      </p>
      <p
        class="lead"
        data-reveal
        set:html={fill(t.lead, {
          low: `<b>${low}</b>`,
          lowAge,
          high: `<b>${high}</b>`,
          highAge,
          gap,
        })}
      />
      <div class="hero-cta" data-reveal>
        <a class="btn" href="#compare">
          {t.whereDoYouFit}
          <span class="arr"><svg class="arr-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg></span>
        </a>
        <span class="hint">{t.nothingIsSentAnywhere}</span>
      </div>
      <p
        class="hero-note"
        data-reveal
        set:html={fill(t.note, {
          term: `<em>${t.noteTerm}</em>`,
          link: `<a href="#method">${t.noteLink}</a>`,
        })}
      />
    </div>

    <figure class="panel hued" data-reveal aria-labelledby="hero-panel-label">
      <div class="panel-head mono">
        <span id="hero-panel-label">{fill(t.everyCountry, { year: h.year })}</span>
        <span class="delta num">{fill(t.apart, { gap })}</span>
      </div>
      <div class="picker">
        <label class="mono" for="hero-country">{t.whereDoYouLive}</label>
        <div class="select">
          <select id="hero-country" data-hero-country>
            <option value="" selected disabled>{t.chooseYourCountry}</option>
            {options.map((country) => <option value={country.code}>{country.name}</option>)}
          </select>
        </div>
      </div>
      <p class="you-line" data-hero-you aria-live="polite">{t.chooseYourCountryTo}</p>
      <DotPlot rows={rows} eu={h.eu ? h.eu.total : null} mode="hero" label={plotLabel} />
      <div class="panel-foot">
        {h.eu && h.eu.women !== null && <span class="chip">{t.women} <b>{age(h.eu.women, { locale: lang })}</b></span>}
        {h.eu && h.eu.men !== null && <span class="chip">{t.men} <b>{age(h.eu.men, { locale: lang })}</b></span>}
        <span class="chip">{t.countries} <b>{h.countries}</b></span>
      </div>
    </figure>
  </div>
</section>

<script>
  import { youLine } from '../lib/leaving-home-copy.js';
  import { fillParts, replay } from '../lib/parts.js';

  const holder = document.getElementById('leaving-home-data');
  const select = document.querySelector<HTMLSelectElement>('[data-hero-country]');
  const line = document.querySelector<HTMLElement>('[data-hero-you]');

  if (holder && select && line) {
    const data = JSON.parse(holder.textContent ?? '{}');
    const idle = line.textContent ?? '';

    function render(code: string | undefined) {
      const parts = code ? youLine(data, code) : null;
      if (!parts) {
        line!.textContent = idle;
        return;
      }
      fillParts(line!, parts);
      replay(line!);
    }

    select.addEventListener('change', () => {
      document.dispatchEvent(new CustomEvent('ha:country', { detail: { code: select.value, source: 'hero' } }));
    });

    document.addEventListener('ha:country', (event) => {
      const code = (event as CustomEvent<{ code?: string }>).detail?.code;
      if (code && select.value !== code) select.value = code;
      render(code);
    });
  }
</script>
