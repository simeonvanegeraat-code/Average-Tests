---
/**
 * De volledige tabel onder de kaart.
 *
 * Dit is niet de "toegankelijke versie" van de kaart maar de echte inhoud: hier
 * staat elk cijfer, hier leest een zoekmachine de pagina, en hier komt iemand die
 * zijn eigen land zoekt in plaats van naar een plaatje te kijken. De kaart is de
 * samenvatting; deze tabel is het bewijs.
 *
 * Bouwt op `.data-table` uit public/css/style.css. Alleen wat die klasse niet
 * heeft staat hieronder: sorteerknoppen, een meeschuivende kop, rijkoppen zonder
 * hoofdletters en het jaarlabel voor landen die achterlopen.
 *
 * Sorteren gebeurt in de client, maar de tabel staat volledig en in een zinnige
 * volgorde in de HTML. Zonder JavaScript mis je alleen het sorteren.
 */
import { age, years } from '../lib/leaving-home.js';

interface Row {
  code: string;
  name: string;
  year: string;
  total: number;
  men: number | null;
  women: number | null;
}

interface Props {
  rows: Row[];
  latestYear: string;
  caption: string;
}

const { rows, latestYear, caption } = Astro.props;

const sorted = [...rows].sort((a, b) => a.total - b.total);

function gapOf(row: Row) {
  return row.men !== null && row.women !== null ? row.men - row.women : null;
}
---

<div class="data-table-wrap">
  <table class="data-table country-table" data-sortable>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col" aria-sort="none">
          <button type="button" data-sort="name" data-type="text">Country</button>
        </th>
        <th scope="col" class="num" aria-sort="ascending">
          <button type="button" data-sort="total" data-type="number">Everyone</button>
        </th>
        <th scope="col" class="num" aria-sort="none">
          <button type="button" data-sort="men" data-type="number">Men</button>
        </th>
        <th scope="col" class="num" aria-sort="none">
          <button type="button" data-sort="women" data-type="number">Women</button>
        </th>
        <th scope="col" class="num" aria-sort="none">
          <button type="button" data-sort="gap" data-type="number">
            Gap<span class="visually-hidden"> between men and women</span>
          </button>
        </th>
      </tr>
    </thead>
    <tbody>
      {
        sorted.map((row) => {
          const gap = gapOf(row);
          return (
            <tr
              data-name={row.name}
              data-total={row.total}
              data-men={row.men ?? ''}
              data-women={row.women ?? ''}
              data-gap={gap ?? ''}
            >
              <th scope="row">
                {row.name}
                {row.year !== latestYear && <span class="stale-year">{row.year}</span>}
              </th>
              <td class="num strong">{age(row.total)}</td>
              <td class="num">{age(row.men)}</td>
              <td class="num">{age(row.women)}</td>
              <td class="num">{gap === null ? '—' : years(gap, { sign: true })}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<script>
  /**
   * Sorteren op de kolomknoppen. Bewust geen bibliotheek: het is een tabel met
   * 34 rijen, en de waarden staan al als data-attributen op de rij.
   */
  for (const table of document.querySelectorAll<HTMLTableElement>('[data-sortable]')) {
    const body = table.querySelector('tbody');
    if (!body) continue;

    for (const button of table.querySelectorAll<HTMLButtonElement>('th button[data-sort]')) {
      button.addEventListener('click', () => {
        const key = button.dataset.sort ?? '';
        const numeric = button.dataset.type === 'number';
        const header = button.closest('th');
        const direction = header?.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';

        for (const other of table.querySelectorAll('th[aria-sort]')) {
          other.setAttribute('aria-sort', 'none');
        }
        header?.setAttribute('aria-sort', direction);

        const rows = [...body.querySelectorAll<HTMLTableRowElement>('tr')];
        rows.sort((a, b) => {
          const left = a.dataset[key] ?? '';
          const right = b.dataset[key] ?? '';

          // Rijen zonder waarde horen onderaan, in welke richting je ook sorteert.
          if (left === '' && right === '') return 0;
          if (left === '') return 1;
          if (right === '') return -1;

          const result = numeric ? Number(left) - Number(right) : left.localeCompare(right);
          return direction === 'ascending' ? result : -result;
        });

        for (const row of rows) body.appendChild(row);
      });
    }
  }
</script>

<style>
  .country-table caption {
    text-align: left;
    padding: 15px 15px 8px;
    font-size: 0.86rem;
    color: var(--ink-soft);
  }

  /* De globale .data-table zet elke th in hoofdletters. Voor een kolomkop is dat
     goed, voor een landnaam niet. */
  .country-table tbody th {
    text-transform: none;
    letter-spacing: normal;
    font-size: 0.94rem;
    font-weight: 600;
    background: transparent;
  }

  .country-table thead th {
    position: sticky;
    top: 0;
    padding: 0;
    white-space: nowrap;
    z-index: 1;
  }

  .country-table thead th button {
    font: inherit;
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: none;
    border: 0;
    padding: 13px 15px;
    width: 100%;
    text-align: inherit;
    cursor: pointer;
  }

  .country-table thead th button:hover {
    color: var(--ink);
  }

  .country-table thead th button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .country-table thead th[aria-sort='ascending'] button::after {
    content: ' ↑';
  }

  .country-table thead th[aria-sort='descending'] button::after {
    content: ' ↓';
  }

  .country-table .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .country-table thead th.num button {
    text-align: right;
  }

  .country-table .strong {
    font-weight: 700;
  }

  .country-table tbody tr:last-child th {
    border-bottom: 0;
  }

  .stale-year {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--warning);
    background: var(--warning-soft);
  }

  .country-table tbody tr:hover th,
  .country-table tbody tr:hover td {
    background: var(--data-soft);
  }
</style>
