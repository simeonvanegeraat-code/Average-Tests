---
/**
 * De feiten uit de gegevens, als losse tegels met één groot getal elk.
 *
 * Alles wordt berekend door de bibliotheek (genderGap, trend, headline); er staat geen
 * getal met de hand in dit onderdeel. De tegels over verandering in de tijd verschijnen
 * alleen als trend() een uitkomst geeft: die weigert te rekenen over een reeksbreuk, en
 * dan ontbreken die tegels in plaats van dat er iets staat dat niets betekent.
 *
 * De sectiekop hoort bij de pagina; dit onderdeel levert alleen de tegels en de voetnoot.
 *
 * DE ZINNEN STAAN IN copy/, NIET IN ui.json, SINDS 8 NOVEMBER 2026
 *
 * Tot die dag stonden ze hier in het Engels en liepen ze mee naar /nl/leaving-home/. Ze
 * horen niet in ui.json omdat het geen vaste teksten zijn maar zinnen die uit de data
 * gerekend worden, met een enkelvoud/meervoud erin ("1 land ging" tegenover "4 landen
 * gingen") en een opsomming die het Nederlands met "en" afsluit en het Engels niet.
 *
 * Dit onderdeel rekent en formatteert; `src/locales/<taal>/copy/leaving-home.js` verwoordt.
 */
import { localeOf } from '../lib/locales.js';
import { grammarOf } from '../lib/grammar.js';
import { age, years, genderGap, trend, headline } from '../lib/leaving-home.js';
import { copyOf } from '../lib/leaving-home-copy.js';
import { decimal } from '../lib/format.js';

/** De taal van de pagina waar dit onderdeel op staat; elk getal hieronder gaat erdoor. */
const lang = localeOf(Astro.url.pathname);
const copy = copyOf(lang).facts;
const g = grammarOf(lang);

interface Props {
  index: any;
}

const { index } = Astro.props;
const h = headline(index);
const gender = genderGap(index);
const movement = trend(index);

const sign = (value: number) => (value > 0 ? '+' : '−');

/** De grootste verschuiving in beide richtingen, naar absolute grootte. */
const biggest = movement
  ? [...movement.earlier, ...movement.later].sort((a, b) => Math.abs(b.change) - Math.abs(a.change))[0]
  : null;

const tiles = [
  gender && {
    className: 'tile s4 dark',
    value: copy.genderValue({ womenEarlier: gender.womenEarlier, of: gender.of }),
    text: copy.gender({
      year: h.year,
      mean: years(gender.mean, { locale: lang }),
      exceptions: gender.exceptions.map((country: { name: string }) => country.name),
    }),
  },
  movement && {
    className: 'tile',
    value: [age(movement.spreadThen, { locale: lang }), age(movement.spreadNow, { locale: lang })],
    text: copy.spread({
      since: movement.since,
      until: movement.until,
      countries: movement.countries,
    }),
  },
  movement &&
    movement.euThen !== null &&
    movement.euNow !== null && {
      className: 'tile',
      value: [age(movement.euThen, { locale: lang }), age(movement.euNow, { locale: lang })],
      text: copy.eu({
        since: movement.since,
        until: movement.until,
        earlier: movement.earlier.length,
        minimumMove: years(movement.minimumMove, { locale: lang }),
        later: movement.later.length,
      }),
    },
  biggest && {
    className: 'tile',
    // Het teken blijft van `sign` hierboven: die schrijft − bij nul, waar signed() in
    // metric.js niets schrijft. Alleen het getal gaat door de taalgrens.
    value: `${sign(biggest.change)}${decimal(Math.abs(biggest.change), 1, { locale: lang })}`,
    text: copy.biggest({
      since: movement!.since,
      name: biggest.name,
      from: age(biggest.series[movement!.since], { locale: lang }),
      to: age(biggest.series[movement!.until], { locale: lang }),
      g,
    }),
  },
  gender && {
    className: 'tile',
    value: age(gender.widestGap, { locale: lang }),
    text: copy.widest({
      year: h.year,
      name: gender.widest.name,
      men: age(gender.widest.men, { locale: lang }),
      women: age(gender.widest.women, { locale: lang }),
      g,
    }),
  },
].filter(Boolean) as { className: string; value: string | string[]; text: string }[];
---

<div class="bento">
  {
    tiles.map((tile, i) => (
      <div class={tile.className} data-reveal style={`--d:${i * 70}ms`}>
        <b>
          {Array.isArray(tile.value) ? (
            <>
              {tile.value[0]} <svg class="arr-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg> {tile.value[1]}
            </>
          ) : (
            tile.value
          )}
        </b>
        <p>{tile.text}</p>
      </div>
    ))
  }
</div>
{
  movement && (
    <p class="brk-foot">
      {copy.breakFoot({ since: index.comparableSince, lastBreak: index.lastBreak })}
    </p>
  )
}
