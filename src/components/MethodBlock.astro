---
/**
 * De zichtbare methodologiesectie: wat het getal is, wat het niet is, hoe ver het reikt,
 * waar de reeks breekt, en waar het vandaan komt. Regel 5 uit CLAUDE.md: elke metriekpagina
 * heeft er een, en hij staat op de pagina zelf, niet erachter.
 *
 * De tekst over wat het getal is en wat het niet is volgt de pagina zoals die al stond
 * (de definitie van Eurostat, niet zijn label). De getallen in de tekst komen uit de
 * bibliotheek en uit de gegevens. De links naar de bron dragen `data-method-link`, de haak
 * waarmee de pagina de gebeurtenis `methodology_opened` meet.
 *
 * ELKE ZIN KOMT UIT ui.json, SINDS 8 NOVEMBER 2026
 *
 * De groep `methodBlock` had al tien sleutels, maar drie van de vijf blokken stonden met
 * de hand in het Engels in dit bestand — dekking, reeksbreuken en de bronlijst. Op
 * /nl/leaving-home/ stond daardoor "31 countries have a figure for 2025" onder het kopje
 * "Dekking".
 *
 * Een paar van deze teksten staan ook in `metricPage`, met net andere woorden ("Read how
 * we handle data on" tegenover "How we handle data is on"). Ze zijn hier niet
 * samengevoegd: dat zou de Engelse pagina veranderen, en die moet identiek blijven aan
 * live. Dit onderdeel staat op precies één paginapaar.
 */
import { ui, fill } from '../lib/ui.js';
import { localeOf, linkTo } from '../lib/locales.js';
import { staleCountries, headline } from '../lib/leaving-home.js';

/** De taal van deze pagina; elke interne link hieronder draagt haar voorvoegsel. */
const lang = localeOf(Astro.url.pathname);
const t = ui(lang).methodBlock;

interface Props {
  index: any;
}

const { index } = Astro.props;
const h = headline(index);
const stale = staleCountries(index);
const withBreak = index.countries.filter((country: { breaks: string[] }) => country.breaks.includes(index.lastBreak)).length;
const first = index.years[0];
const lastYear = index.years[index.years.length - 1];
---

<section class="block" id="method" aria-labelledby="method-title">
  <div class="wrap method-grid">
    <header class="sec-head" data-reveal style="margin: 0">
      <p class="eyebrow mono">{t.eyebrow}</p>
      <h2 id="method-title">{t.howThisIsMeasured}</h2>
      <p>{t.intro}</p>
    </header>

    <div data-reveal>
      <dl>
        <div>
          <dt>{t.whatTheFigureIs}</dt>
          <dd>
            {t.whatItIsBody}
          </dd>
        </div>
        <div>
          <dt>{t.whatItIsNot}</dt>
          <dd>
            {t.whatItIsNotBody}
          </dd>
        </div>
        <div>
          <dt>{t.coverage}</dt>
          <dd>
            {fill(t.coverageBody, { countries: h.countries, year: h.year })}
            {
              stale.length > 0 && (
                <>
                  {' '}
                  {fill(t.coverageStale, {
                    names: stale
                      .map((country: { name: string; year: string }) => `${country.name} (${country.year})`)
                      .join(', '),
                  })}
                </>
              )
            }{' '}
            {t.coverageNotInDataset}
          </dd>
        </div>
        <div>
          <dt>{t.seriesBreaks}</dt>
          <dd>
            {fill(t.breakBody, {
              break: index.lastBreak,
              withBreak,
              all: index.countries.length,
              since: index.comparableSince,
            })}
          </dd>
        </div>
        <div>
          <dt>{t.source}</dt>
          <dd>
            <ul class="source-list">
              <li><b>{t.dataset}</b> <span>Eurostat <code>{index.source.dataset}</code>, {index.source.label}</span></li>
              <li><b>{t.series}</b> <span>{fill(t.seriesRange, { first, last: lastYear })}</span></li>
              <li><b>{t.lastUpdated}</b> <span>{index.source.eurostatUpdated.slice(0, 10)}</span></li>
              <li><b>{t.retrieved}</b> <span>{index.source.fetchedOn.slice(0, 10)}</span></li>
              <li><b>{t.doi}</b> <a href={`https://doi.org/${index.source.doi}`} data-method-link>{index.source.doi}</a></li>
              <li><b>{t.metadata}</b> <a href={index.source.metadata} data-method-link>{t.explanatoryTexts}</a></li>
            </ul>
          </dd>
        </div>
      </dl>
      <p class="legal">
        {t.licence}{' '}<a href={linkTo('/method/', lang)}>{t.ourMethodPage}</a>.
      </p>
    </div>
  </div>
</section>
