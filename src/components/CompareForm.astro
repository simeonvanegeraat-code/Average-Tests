---
/**
 * "Waar pas jij?" als invultekst: *I live in [land] and left home at [leeftijd]*.
 *
 * De haken `data-compare`, `data-compare-country` en `data-compare-age` zijn dezelfde
 * als in de huidige pagina, zodat het script dat het profiel bewaart en de metingen
 * verstuurt niet hoeft te veranderen. De landen staan op alfabet: wie zijn land zoekt
 * leest een naam, geen rangorde.
 *
 * Dit onderdeel controleert en meldt, en bewaart niets. Het stuurt op `document`:
 *   `ha:country` { code }       het gekozen land veranderde
 *   `ha:age` { age }            er staat een geldige leeftijd in het veld (tijdens het typen)
 *   `ha:submit` { code, age }   het formulier is verstuurd met geldige invoer
 * en luistert naar `ha:country`, zodat het land gelijk loopt met de kiezer in de kop.
 * Het bewaren van de keuze en de eventnaam `value_submitted` zijn aan de pagina.
 */
import { currentCountries } from '../lib/metric.js';

interface Props {
  index: any;
  /** De beschrijving uit src/lib/metrics/: het invoerveld hangt eraan. */
  metric: any;
}

const { index, metric } = Astro.props;
const field = metric.input;
const options = [...currentCountries(index)].sort((a, b) => a.name.localeCompare(b.name));
---

<form class="madlib" data-compare data-noun={field.noun} novalidate>
  <label for="compare-country">I live in</label>
  <span class="select">
    <select id="compare-country" name="country" data-compare-country required>
      {options.map((country) => <option value={country.code}>{country.name}</option>)}
    </select>
  </span>
  <label for="compare-age">and left home at</label>
  <input
    id="compare-age"
    type="number"
    name="age"
    data-compare-age
    min={field.min}
    max={field.max}
    step={field.step}
    inputmode="decimal"
    required
    aria-describedby="compare-error"
  />
  <button class="btn" type="submit">
    Compare me
    <span class="arr"><svg class="arr-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg></span>
  </button>
</form>
<p class="field-error" id="compare-error" data-compare-error role="alert" hidden></p>
<p class="field-hint">
  Nothing is sent anywhere. Your answer is kept in this browser so the next page already knows it, and you can clear it at any time.
</p>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-compare]');
  const select = form?.querySelector<HTMLSelectElement>('[data-compare-country]');
  const input = form?.querySelector<HTMLInputElement>('[data-compare-age]');
  const problem = document.querySelector<HTMLElement>('[data-compare-error]');

  if (form && select && input && problem) {
    // De grenzen staan op het veld zelf; zo kan de controle hier niet afwijken
    // van wat de bezoeker mag invullen.
    const min = Number(input.min);
    const max = Number(input.max);
    const noun = form.dataset.noun ?? 'value';
    const valid = (value: number) => Number.isFinite(value) && value >= min && value <= max;

    const send = (name: string, detail: object) => document.dispatchEvent(new CustomEvent(name, { detail }));

    select.addEventListener('change', () => send('ha:country', { code: select.value, source: 'form' }));

    document.addEventListener('ha:country', (event) => {
      const code = (event as CustomEvent<{ code?: string }>).detail?.code;
      if (code && select.value !== code) select.value = code;
    });

    /**
     * Een teruggezet profiel komt binnen als `ha:submit` en wordt eronder meteen
     * als uitkomst getoond. Zonder deze regel staat er dan een resultaat voor
     * leeftijd 24 boven een leeg leeftijdsveld. Waarde zetten stuurt geen
     * `input`-gebeurtenis, dus dit kan niet terugkoppelen.
     */
    document.addEventListener('ha:submit', (event) => {
      const value = (event as CustomEvent<{ age?: number }>).detail?.age;
      if (valid(Number(value)) && input.valueAsNumber !== value) input.value = String(value);
    });

    input.addEventListener('input', () => {
      problem.hidden = true;
      const value = input.valueAsNumber;
      if (valid(value)) send('ha:age', { age: value });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = input.valueAsNumber;
      if (!select.value || !valid(value)) {
        problem.textContent = `Enter ${noun} between ${min} and ${max}.`;
        problem.hidden = false;
        input.focus();
        return;
      }
      problem.hidden = true;
      send('ha:submit', { code: select.value, age: value });
    });
  }
</script>
