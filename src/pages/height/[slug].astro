---
import Base from '../../layouts/Base.astro';
import heightData from '../../../data/percentiles/height.json';
import { factsFor, slugFor, formatFeet, REFERENCE_AGE } from '../../lib/height-facts.js';

/**
 * Eén pagina per lengtewaarde.
 *
 * Bereik 5'0" t/m 6'4". Daarboven zakt de mannensteekproef onder de 30 respondenten,
 * en dan is er geen bevolkingsschatting meer om een pagina op te bouwen — die vraag
 * beantwoordt de verkenner op /height/ met "dat weten we niet".
 *
 * De invalshoek per pagina komt uit de data, niet uit een sjabloon: zie angleFor()
 * in src/lib/height-facts.js.
 */

export function getStaticPaths() {
  const ages = Array.from({ length: 60 }, (_, i) => 20 + i);
  const inches = Array.from({ length: 17 }, (_, i) => 60 + i); // 5'0" t/m 6'4"

  return inches.map((inch) => ({
    params: { slug: slugFor(inch) },
    props: { facts: factsFor(heightData, inch, ages) },
  }));
}

const { facts } = Astro.props;
const f = facts;

const pct = (v) => Math.round(v);
const millions = (n) => (n >= 1e6 ? `${(n / 1e6).toFixed(1)} million` : `${Math.round(n / 1e3)},000`);
const count = (n) => n.toLocaleString('en-US');

/** "1st", "2nd", "3rd", "24th" — hardcoded "th" gaf "1th" en "81th". */
const SUFFIX = ['th', 'st', 'nd', 'rd'];
const ord = (value) => {
  const n = Math.round(value);
  const v = n % 100;
  return `${n}${SUFFIX[(v - 20) % 10] || SUFFIX[v] || SUFFIX[0]}`;
};

/** Eén string, want een meervoud over twee regels rendert als "7 inch es". */
const inches = (n) => `${Math.abs(n)} ${Math.abs(n) === 1 ? 'inch' : 'inches'}`;
const aboveBelow = (n) => (n > 0 ? 'above' : 'below');

// Elke invalshoek krijgt zijn eigen kop en openingsalinea. De cijfers erin komen
// uit de data; alleen de framing verschilt per positie in de verdeling.
const ANGLES = {
  'rare-tall': {
    title: `How Rare Is ${f.label}? — Height Percentile`,
    heading: `${f.spelled} is genuinely rare`,
  },
  'above-average': {
    title: `Is ${f.label} Tall? — Height Percentile by Age`,
    heading: `${f.spelled} is taller than most`,
  },
  typical: {
    title: `Is ${f.label} Average? — Height Percentile by Age`,
    heading: `${f.spelled} sits close to the middle`,
  },
  'female-typical': {
    title: `Is ${f.label} Short? — Height Percentile by Age`,
    heading: `${f.spelled} means two very different things`,
  },
  'below-average': {
    title: `Is ${f.label} Short? — Height Percentile by Age`,
    heading: `${f.spelled} is below average for men`,
  },
};
const angle = ANGLES[f.angle];

const description =
  `${f.spelled} puts a man at the ${ord(f.malePercentile)} percentile and a woman at ` +
  `the ${ord(f.femalePercentile)} among U.S. adults aged ${REFERENCE_AGE}. ` +
  `Calculated from measured survey microdata.`;
---

<Base title={angle.title} description={description} canonical={`/height/${f.slug}/`}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Height · {f.label}</p>
      <h1>{angle.heading}</h1>
      <p class="lead">
        At {f.cm.toFixed(1)} cm, {f.spelled} places a man at the
        <strong>{ord(f.malePercentile)} percentile</strong> and a woman at the
        <strong>{ord(f.femalePercentile)}</strong> among Americans aged {REFERENCE_AGE}.
        Those two numbers describe the same height and almost nothing else in common.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow content">
      {f.malePopulation && (
        <div class="stat-row">
          <div class="stat-block">
            <span class="percentile-eyebrow">American men {f.label} or taller</span>
            <strong>{millions(f.malePopulation.population)}</strong>
            <span>{f.malePopulation.share.toFixed(1)}% of them</span>
          </div>
          <div class="stat-block">
            <span class="percentile-eyebrow">American women {f.label} or taller</span>
            {f.femalePopulation
              ? <>
                  <strong>{millions(f.femalePopulation.population)}</strong>
                  <span>{f.femalePopulation.share.toFixed(1)}% of them</span>
                </>
              : <>
                  <strong class="thin">Too few to say</strong>
                  <span>fewer than 30 women in the survey are this tall</span>
                </>}
          </div>
        </div>
      )}

      {f.angle === 'rare-tall' && (
        <p>
          Height at this level stops being a matter of degree. Of the
          {' '}{count(heightData.sex.male.respondents)} men measured in the survey, only
          {' '}{f.malePopulation ? f.malePopulation.respondents : 'a handful'} reached
          {' '}{f.label} — which is why the percentile stays pinned near the top no matter
          which age group you compare against. There is simply not much distribution left
          above you.
        </p>
      )}

      {f.angle === 'above-average' && (
        <p>
          This is the interesting part of the distribution. {f.spelled} is clearly above the
          middle, but not so far out that the comparison group thins to nothing — which means
          your age genuinely changes the answer. Against men in their forties you are at the
          {' '}{ord(f.curve.find((c) => c.age === 40).male)} percentile; against men in
          their seventies, the {ord(f.curve.find((c) => c.age === 75).male)}.
        </p>
      )}

      {f.angle === 'typical' && (
        <p>
          This is the crowded part of the distribution, and being in it is more interesting than
          it sounds.
          {f.neighbours.male && <>
            {' '}About {millions(f.neighbours.male.population)} American men stand within an inch
            of {f.label} — {f.neighbours.male.share.toFixed(1)}% of all of them packed into a
            two-inch band.
          </>}
          {' '}For once the average actually describes somebody, and that somebody is you.
          {f.inchesFromMedianMale !== 0 && <>
            {' '}Strictly speaking you are {inches(f.inchesFromMedianMale)}
            {' '}{aboveBelow(f.inchesFromMedianMale)} the median man, which is close
            enough that nobody would notice across a room.
          </>}
        </p>
      )}

      {f.angle === 'female-typical' && (
        <p>
          The same measurement lands in two completely different places depending on who is being
          measured. For a woman, {f.label} is ordinary — the {ord(f.femalePercentile)}
          percentile, {Math.abs(f.inchesFromMedianFemale) === 0
            ? 'almost exactly the median'
            : `about ${inches(f.inchesFromMedianFemale)} ${aboveBelow(f.inchesFromMedianFemale)} the median woman`}.
          For a man it is the {ord(f.malePercentile)}. That gap is not a quirk of this
          particular height; it is the whole reason a percentile has to ask your sex before it
          can answer anything at all.
        </p>
      )}

      {f.angle === 'below-average' && (
        <p>
          For a man this is {inches(f.inchesFromMedianMale)} below the median, putting
          {' '}{f.label} at the {ord(f.malePercentile)} percentile. Worth being precise about
          what that means: it describes how many people you are taller than, and nothing else.
          The distribution has no opinion about it.
          {f.neighbours.male && <>
            {' '}You are also not alone out here — roughly
            {' '}{millions(f.neighbours.male.population)} American men are within an inch of you.
          </>}
        </p>
      )}

      {f.showCurve && (
        <>
          <h2>The same height, different ages</h2>
          <p>
            A percentile is a comparison, and the group you are compared against shifts with
            age. Between the youngest and oldest adults, {f.label} moves
            {' '}{Math.round(f.span)} percentile points — from the
            {' '}{ord(f.lowest.male)} at age {f.lowest.age} to the {ord(f.highest.male)} at
            age {f.highest.age}. You have not changed; the people around you have.
          </p>

          <div class="data-table-wrap">
            <table class="data-table">
              <caption>Percentile of {f.label} by age, U.S. adults</caption>
              <thead>
                <tr>
                  <th scope="col">Age</th>
                  <th scope="col">Men</th>
                  <th scope="col">Women</th>
                </tr>
              </thead>
              <tbody>
                {[20, 30, 40, 50, 60, 70, 79].map((age) => {
                  const row = f.curve.find((c) => c.age === age);
                  return (
                    <tr>
                      <th scope="row">{age}</th>
                      <td>{ord(row.male)} percentile</td>
                      <td>{ord(row.female)} percentile</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )}

      {!f.showCurve && (
        <p class="field-hint">
          We are not showing an age breakdown for this height. Across every adult age group the
          percentile barely moves, so a table of near-identical numbers would suggest a
          precision the data does not have.
        </p>
      )}

      <h2>Where this comes from</h2>
      <p>
        Every figure here is calculated from the National Health and Nutrition Examination
        Survey, where participants are measured by trained staff rather than asked. The
        percentiles use the survey's own population weights, and the counts of people are
        estimates from a sample, not a census. The full method, including the checks we run
        against the published CDC figures, is on the <a href="/method/">method page</a>.
      </p>

      <div class="callout">
        <p>
          <strong>This is a comparison with adults in the United States.</strong> Height differs
          substantially between countries, so elsewhere the same measurement would land in a
          different place.
        </p>
      </div>

      <p class="button-row">
        <a class="button" href="/height/">Check your own height →</a>
        <a class="button secondary" href="/weight/">Weight percentile</a>
      </p>
    </div>
  </section>

  <style>
    .stat-row {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px; margin: 0 0 28px;
    }
    .stat-block {
      padding: 18px; border: 1px solid var(--line);
      border-radius: var(--radius-sm); background: #faf7ef;
    }
    .stat-block strong {
      display: block; margin: 2px 0 4px; color: var(--data);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 2rem; font-weight: 500; line-height: 1;
    }
    .stat-block strong.thin { font-size: 1.15rem; color: var(--warning); }
    .stat-block > span:last-child { color: var(--ink-soft); font-size: 0.92rem; }
    .percentile-eyebrow {
      display: block; color: var(--ink-soft); font-size: 0.74rem;
      font-weight: 780; letter-spacing: 0.08em; text-transform: uppercase;
    }
    .field-hint { color: var(--ink-soft); font-size: 0.9rem; }

    @media (max-width: 640px) {
      .stat-row { grid-template-columns: 1fr; }
    }
  </style>
</Base>
