---
import Base from '../../layouts/Base.astro';
import heightData from '../../../data/percentiles/height.json';
import { slugFor, formatFeet } from '../../lib/height-facts.js';

// Zelfde bereik als getStaticPaths in [slug].astro: 5'0" t/m 6'4". Wijzigt dat daar,
// dan hoort het hier mee te veranderen, anders ontstaan er dode of weeslinks.
const heightIndex = Array.from({ length: 17 }, (_, i) => 60 + i)
  .map((inch) => ({ slug: slugFor(inch), label: formatFeet(inch) }));

/**
 * De lengtepagina: statische inhoud die Google indexeert, met de rekenmodule
 * eroverheen. De tabel hieronder wordt bij het bouwen uit de percentieldata
 * gegenereerd, dus er staat geen enkel met de hand ingetypt getal op deze pagina.
 */

const feetInches = (cm) => {
  const total = Math.round(cm / 2.54);
  return `${Math.floor(total / 12)}'${total % 12}"`;
};
const count = (n) => n.toLocaleString('en-US');

// Deze cijfers komen rechtstreeks uit de gewogen microdata (zie `aggregates` in
// build-percentiles.mjs). Leid ze hier niet af uit de curves per leeftijdsjaar:
// dat weegt elk leeftijdsjaar even zwaar en levert geen echte mediaan op.
const rows = heightData.aggregates.bands;
const overall = heightData.aggregates.overall;
const measuredAdults = heightData.sex.male.respondents + heightData.sex.female.respondents;
const twentiesVsSeventies = rows[0].male.p50 - rows[5].male.p50;

const title = 'Average Height by Age — Find Your Percentile | HumanAverage';
const description =
  'Enter your height and see exactly where you rank among U.S. adults of your age and sex. ' +
  'Percentiles calculated from NHANES survey microdata, not copied from published averages.';
---

<Base title={title} description={description} canonical="/height/">
  <Fragment slot="head">
    <script type="application/json" id="height-data" set:html={JSON.stringify(heightData)} is:inline />
  </Fragment>

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Height percentile</p>
      <h1>How tall are you, really?</h1>
      <p class="lead">
        The average tells you almost nothing about yourself. Enter your height and see the
        share of American adults your age and sex that you are taller than — calculated from
        {count(measuredAdults)} measured survey participants.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="tool-panel">
        <div class="tool-panel-header">
          <h2>Your height percentile</h2>
        </div>

        <form id="height-form" class="tool-form" novalidate>
          <fieldset class="field">
            <legend class="field-label">Sex at birth</legend>
            <div class="option-row" role="radiogroup" aria-label="Sex at birth">
              <label class="option">
                <input type="radio" name="sex" value="male" checked /><span>Male</span>
              </label>
              <label class="option">
                <input type="radio" name="sex" value="female" /><span>Female</span>
              </label>
            </div>
            <p class="field-hint">
              The survey records sex at birth only, so those are the only comparison groups
              we can honestly offer.
            </p>
          </fieldset>

          <div class="field">
            <label class="field-label" for="age">Age</label>
            <input class="text-input" type="number" id="age" name="age" min="20" max="79"
                   inputmode="numeric" placeholder="34" required />
            <p class="field-hint">Between 20 and 79.</p>
          </div>

          <fieldset class="field">
            <legend class="field-label">Units</legend>
            <div class="option-row" role="radiogroup" aria-label="Units">
              <label class="option">
                <input type="radio" name="unit" value="imperial" checked /><span>Feet &amp; inches</span>
              </label>
              <label class="option">
                <input type="radio" name="unit" value="metric" /><span>Centimetres</span>
              </label>
            </div>
          </fieldset>

          <div class="field" id="input-imperial">
            <span class="field-label" id="height-label">Height</span>
            <div class="unit-inputs" role="group" aria-labelledby="height-label">
              <input class="text-input" type="number" id="feet" min="3" max="8"
                     inputmode="numeric" placeholder="5" aria-label="Feet" />
              <span class="unit-suffix">ft</span>
              <input class="text-input" type="number" id="inches" min="0" max="11"
                     inputmode="numeric" placeholder="10" aria-label="Inches" />
              <span class="unit-suffix">in</span>
            </div>
          </div>

          <div class="field" id="input-metric" hidden>
            <label class="field-label" for="cm">Height in centimetres</label>
            <input class="text-input" type="number" id="cm" min="100" max="250" step="0.1"
                   inputmode="decimal" placeholder="178" aria-label="Height in centimetres" />
          </div>

          <p class="button-row">
            <button class="button" type="submit">Show my percentile</button>
          </p>
          <p class="warning-note" id="form-error" role="alert" hidden></p>
        </form>

        <div class="tool-results" id="result" aria-live="polite">
          <p class="percentile-eyebrow">Your result</p>
          <p class="percentile-headline" id="result-percentile"></p>
          <p class="percentile-sentence" id="result-sentence"></p>

          <figure class="chart-figure">
            <svg id="result-chart" viewBox="0 0 640 220"
                 role="img" aria-labelledby="chart-title">
              <title id="chart-title">Height distribution for your age and sex, with your height marked</title>
            </svg>
            <figcaption class="field-hint" id="chart-caption"></figcaption>
          </figure>

          <div class="result-grid">
            <div class="stat-chip"><strong id="stat-you"></strong> <span>your height</span></div>
            <div class="stat-chip"><strong id="stat-median"></strong> <span>group median</span></div>
            <div class="stat-chip"><strong id="stat-diff"></strong> <span>difference</span></div>
          </div>

          <div class="button-row">
            <a class="button" href="/weight/" id="cta-next" data-next="weight">Now check your weight →</a>
            <button class="button secondary" type="button" id="share-button">Copy link to this result</button>
          </div>
        </div>
      </div>

      <p class="privacy-note">
        Your height is never sent anywhere. The calculation runs entirely in your browser.
      </p>
    </div>
  </section>

  <style>
    /* Paginagebonden aanvullingen op /css/style.css. Gebruikt uitsluitend de
       bestaande designtokens, zodat dit geen tweede designsysteem wordt. */
    .tool-form { padding: 26px; display: grid; gap: 22px; }
    .field { margin: 0; padding: 0; border: 0; }
    .field-hint { margin: 6px 0 0; color: var(--ink-soft); font-size: 0.9rem; }

    .option-row { display: flex; flex-wrap: wrap; gap: 10px; }
    .option {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 16px; border: 1px solid var(--line); border-radius: 999px;
      background: var(--paper); cursor: pointer; font-weight: 640;
    }
    .option:hover { border-color: var(--data); }
    .option:has(input:checked) {
      border-color: var(--data); background: var(--data-soft); color: var(--data);
    }
    .option input { accent-color: var(--data); }

    .unit-inputs { display: flex; align-items: center; gap: 10px; }
    .unit-inputs .text-input { width: 6.5rem; }
    .unit-suffix { color: var(--ink-soft); font-weight: 640; }

    .percentile-eyebrow {
      margin: 0 0 4px; color: var(--ink-soft); font-size: 0.74rem;
      font-weight: 780; letter-spacing: 0.08em; text-transform: uppercase;
    }
    .percentile-headline {
      margin: 0; color: var(--data);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(3rem, 11vw, 5rem); font-weight: 500;
      letter-spacing: -0.04em; line-height: 1;
    }
    .percentile-sentence { margin: 10px 0 0; font-size: 1.15rem; }

    .chart-figure { margin: 26px 0 0; }
    /* Geen preserveAspectRatio="none": dat rekt de tekstlabels in de grafiek uit. */
    .chart-figure svg { width: 100%; height: auto; display: block; }

    .result-grid { margin-top: 20px; }
    .stat-chip span { color: var(--ink-soft); }

    .privacy-note { margin-top: 18px; text-align: center; }

    /* Drempelverkenner */
    .explorer { padding: 26px; }
    .threshold-readout {
      margin: 4px 0 8px; color: var(--data);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.4rem, 8vw, 3.4rem); font-weight: 500; line-height: 1;
    }
    .threshold-slider { width: 100%; accent-color: var(--data); }
    .threshold-grid {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px; margin: 22px 0 8px;
    }
    .threshold-card {
      padding: 16px; border: 1px solid var(--line);
      border-radius: var(--radius-sm); background: #faf7ef;
    }
    .threshold-card strong {
      display: block; margin: 2px 0 4px;
      font-size: 1.5rem; font-variant-numeric: tabular-nums;
    }
    .threshold-card span[data-detail] { color: var(--ink-soft); font-size: 0.92rem; }
    .threshold-card[data-thin="true"] strong { font-size: 1.1rem; color: var(--warning); }
    #threshold-bar { width: 100%; height: auto; margin-top: 10px; }

    /* Index naar de losse lengtepagina's */
    .height-index {
      display: flex; flex-wrap: wrap; gap: 8px;
      margin: 0 0 32px; padding: 0; list-style: none;
    }
    .height-index a {
      display: inline-block; padding: 8px 14px;
      border: 1px solid var(--line); border-radius: 999px;
      background: var(--paper); font-weight: 640;
      font-variant-numeric: tabular-nums; text-decoration: none;
    }
    .height-index a:hover { border-color: var(--data); background: var(--data-soft); }

    @media (max-width: 640px) {
      .threshold-grid { grid-template-columns: 1fr; }
    }
  </style>

  <section class="section">
    <div class="container narrow">
      <div class="section-heading">
        <p class="eyebrow">Rarity explorer</p>
        <h2>How many Americans are taller than that?</h2>
        <p>
          A published average cannot answer this. Counting people can, because every survey
          participant carries a weight saying how many Americans they stand for. Drag the
          handle and watch the count.
        </p>
      </div>

      <div class="tool-panel explorer">
        <label class="field-label" for="threshold-slider">Height threshold</label>
        <p class="threshold-readout" id="threshold-value">6'0"</p>
        <input type="range" id="threshold-slider" class="threshold-slider"
               aria-label="Height threshold" />

        <div class="threshold-grid">
          <div class="threshold-card" id="threshold-male">
            <span class="percentile-eyebrow">American men this tall or taller</span>
            <strong data-headline></strong>
            <span data-detail></span>
          </div>
          <div class="threshold-card" id="threshold-female">
            <span class="percentile-eyebrow">American women this tall or taller</span>
            <strong data-headline></strong>
            <span data-detail></span>
          </div>
        </div>

        <svg id="threshold-bar" viewBox="0 0 640 170" role="img"
             aria-label="Share of American men and women at or above the selected height"></svg>

        <p class="field-hint">
          Estimated from {count(measuredAdults)} measured adults aged 20 to 79, using the
          survey's own population weights. These are estimates from a sample, not a census
          count.
        </p>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="container narrow content">
      <h2>How rare is a specific height?</h2>
      <p>
        Each of these answers one height in full: how many Americans reach it, what percentile
        it is at every adult age, and how differently it lands for men and women.
      </p>
      <ul class="height-index">
        {heightIndex.map((h) => (
          <li><a href={`/height/${h.slug}/`}>{h.label}</a></li>
        ))}
      </ul>

      <h2>Average height of American adults</h2>
      <p>
        Across all adults aged 20 to 79, the median American man is
        {feetInches(overall.male.p50)} ({overall.male.p50} cm) and the median American
        woman is {feetInches(overall.female.p50)} ({overall.female.p50} cm). But height
        falls with age, so a single number hides more than it shows.
      </p>

      <div class="data-table-wrap">
        <table class="data-table">
          <caption>Median height, and the range covering the middle 80%, by age group</caption>
          <thead>
            <tr>
              <th scope="col">Age</th>
              <th scope="col">Men — median</th>
              <th scope="col">Men — 10th to 90th</th>
              <th scope="col">Women — median</th>
              <th scope="col">Women — 10th to 90th</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{feetInches(row.male.p50)} ({row.male.p50} cm)</td>
                <td>{feetInches(row.male.p10)} – {feetInches(row.male.p90)}</td>
                <td>{feetInches(row.female.p50)} ({row.female.p50} cm)</td>
                <td>{feetInches(row.female.p10)} – {feetInches(row.female.p90)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p>
        Men in their twenties are about
        {twentiesVsSeventies.toFixed(1)} cm taller than men in their
        seventies. That gap is not shrinkage alone: people born decades apart grew up under
        different nutrition and health conditions, and a survey measures both effects at
        once. It is the reason this tool asks your age instead of comparing you to every
        adult at once.
      </p>

      <h2 id="method">How this is calculated</h2>
      <p>
        Most pages about average height quote a published summary figure. This one starts a
        step earlier, from the individual measurements behind that figure.
      </p>
      <ul>
        <li>
          <strong>Source.</strong> The National Health and Nutrition Examination Survey
          (NHANES), run by the U.S. Centers for Disease Control and Prevention. Heights are
          measured by trained staff in a mobile examination centre, not self-reported.
        </li>
        <li>
          <strong>Period.</strong> Two survey cycles: 2017 to March 2020, and August 2021 to
          August 2023. Together {count(measuredAdults)} measured adults.
        </li>
        <li>
          <strong>Survey weights.</strong> NHANES deliberately over-samples some groups, so
          every participant carries a weight representing how many Americans they stand for.
          Ignoring those weights is not a rounding error: it shifts the average height of men
          by nearly two centimetres.
        </li>
        <li>
          <strong>Smoothing across age.</strong> About a hundred people per single year of
          age is enough for a median but not for a stable 90th percentile, so each age draws
          on neighbouring ages, weighted by how close they are. Every age shown here rests on
          at least 254 effective respondents.
        </li>
        <li>
          <strong>Ages 20 to 79 only.</strong> NHANES records everyone aged 80 and over as
          simply “80”, so that group is not an age and is excluded rather than presented as one.
        </li>
      </ul>

      <div class="callout">
        <p>
          <strong>This compares you to adults in the United States.</strong> NHANES samples
          the U.S. civilian population. If you live elsewhere, your percentile here tells you
          where you would stand among Americans — not among your own countrymen.
        </p>
      </div>

      <p class="source-note">
        Source: Centers for Disease Control and Prevention (CDC), National Center for Health
        Statistics (NCHS). National Health and Nutrition Examination Survey, 2017–March 2020
        and August 2021–August 2023. Data retrieved 30 August 2026. Our figures reproduce the
        published NCHS averages for height and weight exactly.
      </p>
    </div>
  </section>
</Base>

<script>
  import { createPercentileTool } from '../../lib/percentile-tool.js';
  import { createThresholdExplorer } from '../../lib/threshold-explorer.js';
  import { formatHeight, formatHeightDifference, fromInches, toInches } from '../../lib/percentile.js';

  const el = (id) => document.getElementById(id);

  createPercentileTool({
    table: JSON.parse(el('height-data').textContent),
    metric: 'height',
    comparative: { more: 'taller', less: 'shorter' },
    shareParam: 'cm',
    valueRange: {
      min: 100, max: 250,
      message: 'Enter a height between 100 cm and 250 cm (3′ 3″ and 8′ 2″).',
    },
    readValue(unit) {
      if (unit === 'metric') {
        const cm = Number(el('cm').value);
        return cm > 0 ? cm : null;
      }
      const feet = Number(el('feet').value);
      if (!(feet > 0)) return null;
      return fromInches(feet * 12 + Number(el('inches').value || 0));
    },
    writeValue(unit, cm) {
      if (unit === 'metric') {
        el('cm').value = cm.toFixed(1);
        return;
      }
      const total = Math.round(toInches(cm));
      el('feet').value = Math.floor(total / 12);
      el('inches').value = total % 12;
    },
    format: formatHeight,
    formatDifference: formatHeightDifference,
  });

  const table = JSON.parse(el('height-data').textContent);
  createThresholdExplorer({
    thresholds: table.aggregates.thresholds,
    labels: { male: 'Men', female: 'Women' },
    startAt: 72 * 2.54,   // 6 voet: de meest gezochte drempel
    format: (cm) => formatHeight(cm, 'imperial'),
    formatPopulation(people) {
      if (people >= 1e6) return `${(people / 1e6).toFixed(1)} million`;
      if (people >= 1e3) return `${Math.round(people / 1e3)},000`;
      return String(people);
    },
  });
</script>
