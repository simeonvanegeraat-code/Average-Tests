---
import { ui } from '../../lib/ui.js';
import { localeOf, linkTo } from '../../lib/locales.js';
import BaseV2 from '../../layouts/BaseV2.astro';
import { periodLabel } from '../../lib/period.js';
import { count } from '../../lib/metric.js';
import { methodPage } from '../../lib/pages/method.js';

/**
 * De Engelse /method/.
 *
 * Eigen bestand per taal sinds 3 november 2026; `src/pages/nl/method/index.astro` is de
 * Nederlandse. Het rekenwerk staat in `src/lib/pages/method.js`.
 *
 * Herschreven op 24 oktober 2026. De vorige versie ging volledig over NHANES en
 * percentielen uit microdata; die data en die pagina's zijn eraf. Wat blijft is de belofte
 * eronder, en die geldt onverminderd voor de Europese bronnen.
 */
const lang = localeOf(Astro.url.pathname);
const t = ui(lang).method;
const {
  sets: METHODOLOGY,
  leaving,
  wealth,
  exitAge,
  wealthCheck,
  maxDeviation,
  h,
  stale,
  unbroken,
  definitions,
  publishers,
  wealthPeriod,
} = methodPage(lang);

const title = 'How We Get These Numbers | HumanAverage';
const description =
  'Where each figure on this site comes from, what it does and does not say, and the gate ' +
  'every number passes before it appears. Eurostat, the ECB, and nothing estimated on top.';
---

<BaseV2 title={title} description={description} canonical="/method/">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">{t.method}</p>
      <h1 data-reveal>{t.howWeGetThese}</h1>
      <p class="lead">
        {t.shortVersionWeDo}
      </p>
    </div>
  </section>

  <section class="block" aria-labelledby="kind-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.whatYouAreLooking}</p>
        <h2 id="kind-title">{t.aFigureIsNot}</h2>
      </header>

      <div class="prose" data-reveal>
        <p>
          {t.mostStatisticalAgenciesPublish}
        </p>
        <p>
          This is why the pages here say <b>which side of a figure you fall on</b> rather than
          giving you a percentile. A percentile needs the individual records — one row per
          person — and the sources behind these pages do not publish those. Where a source ever
          does, the page will say so and give you the real position instead.
        </p>
        <p>
          Two concrete cases, both spelled out on their own pages. The wealth pages cannot give
          a percentile because the ECB publishes the <em>average of each group</em> and not
          where the groups begin: we know what the seventh decile owns on average, not where
          the seventh decile starts. The leaving-home page cannot either, because Eurostat
          publishes the age by which half have left — a midpoint, not a distribution.
        </p>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="source-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.sources}</p>
        <h2 id="source-title">{t.whereTheDataComes}</h2>
        <p>
          {count(publishers.length, 'statistical agency', 'statistical agencies')}, all publishing
          openly, each recorded per dataset in the repository with its code, coverage, licence and
          the date we fetched it.
        </p>
      </header>

      <div class="bento" data-reveal>
        <div class="tile">
          <div>
            <h3>{t.eurostat}</h3>
            <p>
              <b class="code">{leaving.source.dataset}</b> — {leaving.source.label}. Derived from
              the EU Labour Force Survey, series {leaving.years[0]} to {
                leaving.years[leaving.years.length - 1]
              }, last updated by Eurostat on {leaving.source.eurostatUpdated.slice(0, 10)}.
            </p>
          </div>
          <span class="meta mono">{h.countries} countries at {h.year}</span>
        </div>

        <div class="tile">
          <div>
            <h3>{t.europeanCentralBank}</h3>
            <p>
              {wealth.source}. Quarterly, openly available through the ECB data portal, covering
              {wealth.countries.length} countries through {wealthPeriod}.
            </p>
          </div>
          <span class="meta mono">{wealthCheck.quarters} quarters</span>
        </div>

        <div class="tile">
          <div>
            <h3>{t.oecd}</h3>
            <p>
              <b class="code">{exitAge.source.measure}</b> — {exitAge.source.label}, from the{' '}
              {exitAge.source.name} database. The widest reach of anything here: {exitAge.countries.length}{' '}
              countries, {exitAge.years[0]} to {exitAge.years[exitAge.years.length - 1]}, and the only
              series that goes beyond Europe.
            </p>
          </div>
          <span class="meta mono">{t.menAndWomenNever}</span>
        </div>

        <div class="tile">
          <div>
            <h3>{t.naturalEarth}</h3>
            <p>
              {t.theCountryOutlinesOn}
            </p>
          </div>
          <span class="meta mono">{t.reproducible}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="datasets-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.everyDatasetLineBy}</p>
        <h2 id="datasets-title">{t.whatEachSourcePublishes}</h2>
        <p>
          {t.oneBlockPerDataset}
        </p>
        <p>
          Where a publisher writes its own definition, that definition is quoted rather than
          summarised, because the gap between a dataset's title and its definition is where this
          site has been wrong before. {definitions.length} of these {METHODOLOGY.length} datasets come
          with one and the rest do not, so the row is absent where the words would have had to be
          ours.
        </p>
        <p>
          The row about comparing across time is the one that costs the most to get wrong.
          There is a longer piece on it:{' '}
          <a href={linkTo('/notes/eurostat-2021-series-break/', lang)}>why you cannot compare Eurostat figures
          across 2021</a>.
        </p>
      </header>

      <div class="datasets" data-reveal>
        {
          METHODOLOGY.map((set) => (
            <article class="dataset hued" id={`ds-${set.key}`} style={`--h:${set.hue}`}>
              <header class="dataset-head">
                <h3><a href={linkTo(set.path, lang)}>{set.label}</a></h3>
                <p class="mono who">
                  {set.publisher}
                  {set.dataset && <> · {set.dataset}</>}
                </p>
              </header>

              <dl>
                {set.sourceLabel && (
                  <div class="wide">
                    <dt>{t.whatThePublisherCalls}</dt>
                    <dd>{set.sourceLabel}</dd>
                  </div>
                )}

                {set.definition && (
                  <div class="wide">
                    <dt>{t.itsOwnDefinition}</dt>
                    <dd class="quote">{set.definition}</dd>
                  </div>
                )}

                <div>
                  <dt>{t.coverage}</dt>
                  <dd>
                    {set.countries} countries at {set.year}
                    {set.firstYear && <> · series {set.firstYear}–{set.lastYear}</>}
                    {set.quarters && <> · {set.quarters} quarters</>}
                    {set.stale.length > 0 && (
                      <> · {set.stale.length} behind ({set.stale.map((c) => `${c.name} ${c.year}`).join(', ')})</>
                    )}
                  </dd>
                </div>

                <div>
                  <dt>{t.comparingAcrossTime}</dt>
                  <dd>
                    {set.comparability.kind === 'since' && (
                      <>
                        Comparable since {set.comparability.since}.{' '}
                        {set.comparability.broken === set.countries
                          ? `All ${set.countries} countries carry`
                          : `${set.comparability.broken} of the ${set.countries} countries ${set.comparability.broken === 1 ? 'carries' : 'carry'}`}{' '}
                        a break flag in {set.comparability.year}, and <code>trend()</code> refuses to
                        measure across it.
                        {/* Werkloosheid breekt per land in plaats van voor iedereen tegelijk, en dan
                            vertelt een telling op de laatste breuk maar de helft. */}
                        {set.comparability.others > 0 && (
                          <>
                            {' '}
                            {set.comparability.others} other{set.comparability.others === 1 ? '' : 's'} carry
                            one at a different date ({set.comparability.otherYears}), which is why the
                            comparable window starts after the latest of them.
                          </>
                        )}
                      </>
                    )}
                    {set.comparability.kind === 'break-at-end' && (
                      <>
                        The last break falls in {set.comparability.year}, the most recent year itself
                        ({set.comparability.broken} of {set.countries} countries), so there is no window
                        left to measure change over. The ranking holds; a trend would not.
                      </>
                    )}
                    {set.comparability.kind === 'single-year' && (
                      <>
                        {set.publisher} publishes this table for {set.comparability.year} alone. Nothing
                        can break in a single year, and nothing can be compared across one either — so
                        the page carries a ranking and no trend.
                      </>
                    )}
                    {set.comparability.kind === 'unbroken' && (
                      <>
                        {set.publisher} flags no break in this series, so the whole run
                        {set.comparability.from && <> from {set.comparability.from}</>} is comparable.
                        {unbroken.length === 1
                          ? ' It is the only one of our sources you can read end to end.'
                          : ` ${unbroken.length} of our ${METHODOLOGY.length} sources can be read end to end; most cannot.`}
                      </>
                    )}
                    {set.comparability.kind === 'none' && (
                      <>These accounts carry no series breaks; the ECB revises the whole run instead.</>
                    )}
                    {/* Een enquêtegolf is geen reeks: er valt niets te breken, en er valt ook
                        niets mee te vergelijken. Het veldwerk per land loopt bovendien uiteen. */}
                    {set.comparability.kind === 'survey-wave' && (
                      <>
                        One survey wave, not a series. Fieldwork across the
                        {' '}{set.comparability.countries} countries ran between
                        {' '}{periodLabel(set.comparability.from, { locale: lang })} and {periodLabel(set.comparability.to, { locale: lang })},
                        and each country carries its own window, so no single year describes them
                        all. Comparing waves is possible in principle but is not done here.
                      </>
                    )}
                  </dd>
                </div>

                <div>
                  <dt>{t.whatWeReadPer}</dt>
                  <dd>{set.lenses.length ? set.lenses.join(' · ') : 'One figure per country'}</dd>
                </div>

                <div>
                  <dt>{t.lastRefreshed}</dt>
                  <dd>
                    {set.published && <>Published {set.published} · </>}
                    Fetched {set.fetched}
                    {set.checked && <> · checked {set.checked}</>}
                  </dd>
                </div>

                <div class="wide">
                  <dt>{t.lookItUpYourself}</dt>
                  <dd>
                    {set.doi && <>DOI <code>{set.doi}</code> · </>}
                    {set.metadata && (
                      <>
                        <a href={set.metadata} rel="noopener" data-method-link>Publisher's metadata</a>
                        {set.api && <> · </>}
                      </>
                    )}
                    {set.api && <a href={set.api} rel="noopener" data-method-link>the exact query we run</a>}
                  </dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="pipeline-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.pipeline}</p>
        <h2 id="pipeline-title">{t.whatWeDoTo}</h2>
      </header>

      <div class="prose" data-reveal>
        <ol>
          <li>
            <b>Fetch.</b> A script pulls the source into an untracked folder and writes down what
            it got: the exact request, the agency's own update stamp, the periods and the areas.
            No checksum on the response itself, because these agencies publish on a schedule and
            a changing answer is correct behaviour. Instead the script checks the dataset's
            <em>label</em>, so that a silently reassigned code fails the build rather than quietly
            changing a number on the site.
          </li>
          <li>
            <b>Build.</b> A second script turns that into a compact JSON file that is committed to
            the repository. Aggregates like the EU total are kept apart from countries, because
            they sit in the same dimension at the source and are not countries. Each country
            carries its own reference year rather than being forced into a shared one.
          </li>
          <li>
            <b>Validate.</b> A gate recomputes every published figure from the raw response. If it
            fails, nothing is published.
          </li>
        </ol>
        <p>
          {t.thePagesThemselvesCalculate}
        </p>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="check-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.checks}</p>
        <h2 id="check-title">{t.howWeCheckOurselves}</h2>
        <p>
          {t.theGateDoesNot}
        </p>
      </header>

      <div class="prose" data-reveal>
        <p>
          <b>For the wealth data</b>, the sharpest check available is that the balance has to
          close: every published component, with debts counted negative, must add up to the
          published net wealth. If a component is missing, a subtotal is double-counted, or a
          scale is wrong, the sum breaks. All three are invisible on the page itself. Last run
          on {wealthCheck.checkedOn}, across {wealthCheck.countries} countries and {
            wealthCheck.quarters
          } quarters, the largest deviation was <b>{maxDeviation}%</b>.
        </p>
        <p>
          <b>For the Eurostat data</b>, every figure and every series-break flag is recomputed
          from the raw response. That second part matters more than it sounds. Eurostat
          reorganised the Labour Force Survey in {leaving.lastBreak} and flags the break; the
          break year itself is a transition, so even measuring from it is wrong. Compared with
          2005 the gap between countries appears to grow. Compared across years that are
          actually comparable, it shrinks. The code refuses to calculate the first version
          rather than printing it with a footnote, and the comparable window starts at {
            leaving.comparableSince
          }.
        </p>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="limits-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.limits}</p>
        <h2 id="limits-title">{t.whatWeWillNot}</h2>
      </header>

      <div class="prose" data-reveal>
        <p>
          <b>We will not invent a statistic.</b> Not from memory, not from a search result, not
          as a placeholder to get a page finished. If a figure cannot be traced to a dataset,
          it does not go on the site, and the gap is left visible instead of filled.
        </p>
        <p>
          <b>We will not call something a percentile when it is not one.</b> See the top of this
          page. It would read better and it would be false.
        </p>

        <div class="limits">
          <b>{t.whatTheseFiguresCannot}</b>
          <p>
            They are country-level. They describe a population, not anyone in it, and the spread
            inside a country is almost always wider than the gap between countries. Coverage is
            European: the United States, Canada and Australia are not in these datasets.
            {
              stale.length > 0 && (
                <>
                  {' '}
                  And some countries stop reporting — {
                    stale.map((country: { name: string; year: string }) => `${country.name} (${country.year})`).join(', ')
                  } are shown at their most recent year, marked on the map and labelled in the
                  table rather than quietly mixed in with the rest.
                </>
              )
            }
          </p>
        </div>

        <p class="note">
          Every dataset is recorded in <code>data/sources.md</code> in the repository, with its
          code, coverage, licence and fetch date. The repository is public.
        </p>
      </div>
    </div>
  </section>
</BaseV2>

<style>
  .tile h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
  }

  .tile .code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--data);
  }

  .tile .meta {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .prose ol {
    margin: 0 0 1.1em;
    padding-left: 1.3em;
  }

  .prose ol li {
    margin-bottom: 0.9em;
    line-height: 1.7;
  }

  .prose b {
    color: var(--text);
  }

  .prose .note {
    margin-top: 1.6em;
    font-size: 0.92rem;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
