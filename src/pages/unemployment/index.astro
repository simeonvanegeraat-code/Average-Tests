---
import { ui } from '../../lib/ui.js';
import { localeOf, linkTo } from '../../lib/locales.js';
import BaseV2 from '../../layouts/BaseV2.astro';
import Related from '../../components/Related.astro';
import StageMap from '../../components/StageMap.astro';
import RankTable from '../../components/RankTable.astro';
import CountryWiring from '../../components/CountryWiring.astro';
import geo from '../../../data/geo/europe.json';
import { withArticle } from '../../lib/metric.js';
import { periodLabel } from '../../lib/period.js';
import { unemploymentPage } from '../../lib/pages/unemployment.js';

/**
 * De Engelse /unemployment/.
 *
 * Eigen bestand per taal sinds 3 november 2026; `src/pages/nl/unemployment/index.astro`
 * is de Nederlandse. Het rekenwerk staat in `src/lib/pages/unemployment.js`, inclusief
 * de twee vensters die deze pagina streng apart houdt.
 *
 * Geen getal staat hier met de hand ingetypt, ook geen bijvoeglijk naamwoord dat uit een
 * getal volgt: de kop hieronder hangt aan wat het Europese cijfer werkelijk deed.
 */
const lang = localeOf(Astro.url.pathname);
/** De sjabloontekst die elke metriekpagina deelt. Zie src/lib/ui.js. */
const shared = ui(lang).metricPage;
const {
  index,
  metric,
  h,
  gender,
  movement,
  longer,
  stale,
  current,
  unbroken,
  flagged,
  agePair,
  ageRank,
  ageWider,
  ageRatio,
  fmt,
  amt,
  sign,
  months,
  euMove,
  outran,
  newestPeriod,
  newestCount,
  euValue,
} = unemploymentPage(lang);

const heading =
  movement === null || euMove === null
    ? `Unemployment runs from ${fmt(h.earliest.total)}% to ${fmt(h.latest.total)}% across Europe.`
    : Math.abs(euMove) < 0.05
      ? `Europe's unemployment rate did not move in ${months} months — but ${outran} of its ${movement.countries} countries did.`
      : `Europe's unemployment rate moved ${fmt(Math.abs(euMove))} points in ${months} months — but ${outran} of its ${movement.countries} countries moved further.`;

/**
 * De drie met het grootste verschil in beide richtingen, als "Greece −1.7, Spain −0.8".
 * De eenheid staat één keer in de zin eromheen en niet drie keer in de opsomming; met
 * `amt()` werd het "Greece (−1.7 percentage points), Spain (−0.8 percentage points)".
 */
const movers = (rows: any[]) =>
  rows.map((country: any) => `${country.name} ${sign(country.change)}`).join(', ');

const topFalls = movement ? movers(movement.earlier.slice(0, 3)) : '';
const topRises = movement ? movers(movement.later.slice(0, 3)) : '';

/** "Greece 13.2 to 7.4, Spain 13.9 to 10.0" — waar een land begon en waar het nu staat. */
const movedFrom = (rows: any[]) =>
  rows
    .slice(0, 4)
    .map((country: any) => `${country.name} ${fmt(country.began)} to ${fmt(country.total)}`)
    .join(', ');

const flaggedNames = flagged.map((country: any) => country.name).join(' and ');

/**
 * De zin over die breuken als één string, niet als opmaak met expressies ertussen.
 *
 * Een zin die uit meerdere waarden bestaat hoort in de frontmatter opgebouwd te worden
 * en niet in de HTML, want daar is hij te lezen als zin in plaats van als een rij
 * fragmenten. Dat is ook waarom hij niet in ui.json staat: hij verschilt per taal in
 * meer dan zijn woorden.
 */
const breakClause =
  flagged.length === 0
    ? ''
    : `${flaggedNames} ${flagged.length === 1 ? 'carries' : 'carry'} a series break before that, and a ` +
      `longer window would compare ${flagged.length === 1 ? 'it' : 'them'} with figures Eurostat says ` +
      'are not comparable.';

/** Dezelfde reden, voor de methodesectie: welk land brak wanneer, en wat dat betekent. */
const breakDetail =
  flagged.length === 0
    ? ''
    : `The ${flagged.length === 1 ? 'exception is' : 'exceptions are'} ` +
      `${flagged.map((country: any) => `${country.name} (${country.breaks.map((p: string) => periodLabel(p, { locale: lang })).join(', ')})`).join(' and ')}. ` +
      'Because a comparison between countries has to hold for every country in it, the window used for ' +
      `that above starts after the later of those breaks, in ${periodLabel(index.comparableSince, { locale: lang })}. ` +
      "Each country's own line in the table runs the full series and simply breaks where its flag is.";

const title = `Unemployment Rate by Country in Europe (${periodLabel(h.year, { locale: lang })})`;
const description =
  `Unemployment is ${euValue}% across the European Union — ${fmt(h.earliest.total)}% in ` +
  `${h.earliest.name}, ${fmt(h.latest.total)}% in ${h.latest.name}. All ${h.countries} countries ` +
  "on a map, from Eurostat's monthly series.";
---

<BaseV2 title={title} description={description} canonical="/unemployment/" hue={metric.hue}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">Eurostat · {h.countries} countries · {periodLabel(h.year, { locale: lang })}</p>

      <h1 data-reveal>{heading}</h1>

      <span class="giant num">{euValue}</span>
      <p class="unit mono">
        % of the labour force · <b>{shared.europeanUnion}</b> · {periodLabel(h.year, { locale: lang })}
      </p>

      <p class="lead">
        In {withArticle(h.earliest.name)}, {fmt(h.earliest.total)}% of the labour force is out of
        work and looking for it. In {withArticle(h.latest.name)} it is {fmt(h.latest.total)}%. Same
        measure, same month, {amt(h.gap)} apart.
      </p>

      <div class="hero-cta">
        <a class="btn" href="#map-section">
          Find your country <span class="arr" aria-hidden="true">→</span>
        </a>
        <span class="hint">Updated when Eurostat publishes, about a month behind.</span>
      </div>

      <p class="hero-note">
        This counts people who are <em>looking</em>, not people who are claiming. Eurostat uses the
        ILO definition: aged 15 to 74, no job in the reference week, actively sought work in the
        past four weeks, and able to start within two weeks. Someone who claims no benefit at all
        but is searching counts here; someone receiving support who is not searching does not.
      </p>
    </div>
  </section>

  <StageMap
    geo={geo}
    index={index}
    metric={metric}
    eyebrow={shared.theMap}
    title="Where work is hardest to find"
    lede={shared.tapOrSwitch}
  />

  <section class="block" aria-labelledby="table-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.everyCountry}</p>
        <h2 id="table-title">All {index.countries.length} countries, lowest to highest</h2>
        <p>
          Sort by any column. The gap column is men minus women, so a negative number means
          unemployment is higher among women{
            gender && gender.womenAbove.length > gender.womenLower
              ? ', which on this measure is the more common case'
              : ''
          }.
        </p>
      </header>

      <div data-reveal>
        <RankTable index={index} metric={metric} />
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.whatTheNumbersSay}</p>
        <h2 id="facts-title">A still average over moving countries</h2>
        <p>
          Everything in this section is measured inside the window where all {movement?.countries ?? h.countries}
          countries are comparable with each other: {periodLabel(movement?.since ?? h.year, { locale: lang })} to {periodLabel(h.year, { locale: lang })}.
          {' '}
          {breakClause}
        </p>
      </header>

      <div data-reveal>
        {
          movement && (
            <div class="bento">
              <div class="tile s4">
                <div>
                  <b>{movement.earlier.length}</b>
                  <p>
                    of {movement.countries} countries came down by at least {amt(movement.minimumMove)}{' '}
                    since {periodLabel(movement.since, { locale: lang })}. The steepest falls, in percentage points:{' '}
                    {topFalls}.
                  </p>
                </div>
                <span class="meta mono">{periodLabel(movement.since, { locale: lang })} – {periodLabel(movement.until, { locale: lang })}</span>
              </div>

              <div class="tile">
                <div>
                  <b>{movement.later.length}</b>
                  <p>went up by as much or more, led by {topRises}.</p>
                </div>
                <span class="meta mono">the other direction</span>
              </div>

              <div class="tile">
                <div>
                  <b>{movement.stable}</b>
                  <p>stayed within {amt(movement.minimumMove)} of where they were.</p>
                </div>
                <span class="meta mono">no real change</span>
              </div>

              <div class="tile s4">
                <div>
                  <h3>The spread narrowed from {amt(movement.spreadThen)} to {amt(movement.spreadNow)}</h3>
                  <p>
                    That is the distance between the highest country and the lowest. It closed while
                    the European figure went from {fmt(movement.euThen)}% to {fmt(movement.euNow)}%:
                    {' '}{movement.earlier.length} down, {movement.later.length} up, and an average
                    that sat between them without being pulled either way.
                  </p>
                </div>
                <span class="meta mono">highest minus lowest</span>
              </div>
            </div>
          )
        }

        {
          gender && gender.womenAbove.length > 0 && (
            <div class="bento" style="margin-top:14px">
              <div class="tile">
                <div>
                  <b>{gender.womenAbove.length}</b>
                  <p>
                    of {gender.of} countries have higher unemployment among women than among men. It
                    runs the other way in {gender.womenLower}{gender.tied > 0 ? `, and ${gender.tied} are level to the first decimal` : ''}.
                  </p>
                </div>
                <span class="meta mono">{periodLabel(h.year, { locale: lang })}</span>
              </div>

              <div class="tile s4 dark">
                <div>
                  <h3>
                    {withArticle(gender.widestOther.name, { capitalise: true })} has the widest gap on
                    the map
                  </h3>
                  <p>
                    {fmt(gender.widestOther.men)}% of men there are unemployed and{' '}
                    {fmt(gender.widestOther.women)}% of women — {amt(Math.abs(gender.widestOther.men - gender.widestOther.women))}{' '}
                    apart, in a country whose overall rate ({fmt(gender.widestOther.total)}%) sits in
                    the middle of this table. The widest gap the other way is{' '}
                    {withArticle(gender.widest.name)} at {amt(gender.widestGap)}.
                  </p>
                </div>
                <span class="meta mono">men against women</span>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    longer && (
      <section class="block" aria-labelledby="longer-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">The longer view</p>
            <h2 id="longer-title">Five years, one country at a time</h2>
            <p>
              Comparing countries with each other needs the short window above. Asking what happened
              inside one country needs only that country's own series to be whole — and{' '}
              {longer.countries} of the {longer.countries + longer.excluded.length} are, all the way
              back to {periodLabel(longer.from, { locale: lang })}.{' '}
              {longer.excluded.map((country: any) => country.name).join(' and ')} are left out of
              everything in this section.
            </p>
          </header>

          <div class="prose" data-reveal>
            <p>
              Of those {longer.countries}, {longer.down} are lower now than in {periodLabel(longer.from, { locale: lang })}
              and {longer.up} are higher. The largest falls:{' '}
              {movedFrom(longer.fell)}. The largest rises: {movedFrom(longer.rose)}.
            </p>
            <p>
              It is tempting to read that as the worst-off catching up, and the arithmetic only half
              supports it. Of the {longer.down} countries that came down, {longer.fellFromAbove}{' '}
              started above the European figure of {fmt(longer.euThen)}%; the other{' '}
              {longer.down - longer.fellFromAbove} were already below it. Of the {longer.up} that
              rose, {longer.roseFromBelow} started below it. Movement in both directions, on both
              sides of the average — and an average that went from {fmt(longer.euThen)}% to{' '}
              {fmt(longer.euNow)}% while all of it happened.
            </p>
          </div>
        </div>
      </section>
    )
  }

  {
    agePair && (
      <section class="block" aria-labelledby="age-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">Age</p>
            <h2 id="age-title">
              Everything above counts a 22-year-old and a 52-year-old as one country
            </h2>
            <p>
              {/* Geen superlatief. "De grootste splitsing op de site" stond hier en was onwaar:
                  de kloof tussen eigenaren en huurders op /wealth/ haalt 15,5x. Wat hier staat is
                  wat de twee cijfers doen met het cijfer erboven, en dat is te controleren. */}
              The same dataset splits by age, and the figure above sits between two very different
              ones: {fmt(agePair.youth)}% of under-25s in the European labour force are unemployed,
              against {fmt(agePair.older)}% of everyone from 25 to 74.
            </p>
          </header>

          <div data-reveal>
            <div class="bento">
              <div class="tile s4">
                <div>
                  <b>{ageRatio}×</b>
                  <p>
                    as high under 25 as from 25 to 74, across the European Union.
                    {ageWider && ageWider.countries.length > 0 && (
                      <>
                        {' '}In {ageWider.countries.length} of these {ageWider.of} countries the step
                        between the two ages is wider than the whole distance from the lowest
                        country on this page to the highest.
                      </>
                    )}
                  </p>
                </div>
                <span class="meta mono">{periodLabel(agePair.period, { locale: lang })}</span>
              </div>

              <div class="tile">
                <div>
                  <b>{ageRank.unchanged === 0 ? `All ${ageRank.of}` : `${ageRank.of - ageRank.unchanged} of ${ageRank.of}`}</b>
                  <p>
                    countries change place in the ranking when you count only the under-25s. The
                    table above is one answer to "where is it worst"; for someone leaving school it
                    is a different one.
                  </p>
                </div>
                <span class="meta mono">a different order</span>
              </div>
            </div>

            <p class="more" style="margin-top:22px">
              <a class="btn btn--ghost" href={linkTo('/unemployment/by-age/', lang)}>
                Both age groups, every country
                <span class="arr" aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <Related metric="unemployment" />

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap method-grid">
      <header class="sec-head" data-reveal style="margin: 0">
        <p class="eyebrow mono">{shared.method}</p>
        <h2 id="method-title">{shared.howMeasured}</h2>
        <p>{shared.publishedByEurostat}</p>
      </header>

      <div data-reveal>
        <dl>
          <div>
            <dt>{shared.whatTheFigureIs}</dt>
            <dd>
              The share of the labour force that is unemployed, seasonally adjusted, for one
              calendar month. Unemployed follows the ILO definition: 15 to 74 years old, not
              employed in the reference week, actively looking for work in the past four weeks, and
              able to start within two weeks. The labour force — the denominator — is everyone
              employed plus everyone unemployed, which is why this is not a share of the population
              and cannot be read as one.
            </dd>
          </div>
          <div>
            <dt>{shared.whatItIsNot}</dt>
            <dd>
              It is not a count of people registered with a benefit agency. Eurostat says plainly
              that the two are not comparable: registration rules differ from country to country and
              do not follow the ILO standard, so a national claimant figure will not match this one
              and the difference is not an error in either. It is also not a distribution, so no
              percentile can be built from it — one number per country per month is all there is.
            </dd>
          </div>
          <div>
            <dt>{shared.coverage}</dt>
            <dd>
              {h.countries} countries have a figure for {periodLabel(h.year, { locale: lang })}.
              {
                stale.length > 0 && (
                  <>
                    {' '}
                    {stale.map((country: any) => `${country.name} (${periodLabel(country.year, { locale: lang })})`).join(', ')}{' '}
                    publish later than the rest and are shown at their most recent month, hatched on
                    the map and labelled in the table.
                  </>
                )
              }{' '}
              The survey covers people usually resident in each country and leaves out those living
              in collective or institutional households. The United States and Japan are in this
              dataset at Eurostat but not on this page: their copyright notice only allows
              commercial reuse of data for the EU, EFTA and the candidate countries.
            </dd>
          </div>
          <div>
            <dt>How often it changes</dt>
            <dd>
              Eurostat publishes a month about 31 days after it ends, by their own account, so the
              newest month here is roughly a month old and earlier months can still be revised.
              {/* Alleen als de nieuwste gedownloade maand nog te dun is voor een kaart. Zodra
                  hij vol genoeg is wordt hij zelf het anker, en dan is deze zin onwaar — hij
                  stond er één verversing lang wél, over de maand die op dat moment al getoond
                  werd. */}
              {newestPeriod !== h.year ? (
                <>
                  {' '}That is why {periodLabel(newestPeriod, { locale: lang })} is in the downloaded series but not on
                  this page: only {newestCount}{' '}{newestCount === 1 ? 'country' : 'countries'} had a
                  figure for it when this page was built, and a map of
                  {' '}{newestCount === 1 ? 'one' : 'those'} alone would not be a map of Europe.
                </>
              ) : (
                <>
                  {' '}{periodLabel(newestPeriod, { locale: lang })} is the newest month Eurostat has published and the
                  one shown here, with {newestCount} of the {index.countries.length} countries in it;
                  the rest carry their own most recent month.
                </>
              )}
            </dd>
          </div>
          <div>
            <dt>{shared.seriesBreaks}</dt>
            <dd>
              Eurostat says it adjusts the monthly series for breaks wherever it can, and on this
              dataset it mostly has: {unbroken.length} of the {current.length} countries carry no
              flag at all across {periodLabel(index.years[0], { locale: lang })} to {periodLabel(h.year, { locale: lang })}.
              {' '}
              {breakDetail}
            </dd>
          </div>
        </dl>

        <ul class="source-list">
          <li><strong>{shared.dataset}</strong>{' '}{shared.eurostat}{' '}<code>{index.source.dataset}</code>, {index.source.label}</li>
          <li><strong>{shared.series}</strong> {periodLabel(index.years[0], { locale: lang })} to {periodLabel(index.years[index.years.length - 1], { locale: lang })}</li>
          <li><strong>Breakdown</strong> seasonally adjusted, all ages, percentage of the labour force</li>
          <li><strong>{shared.lastUpdated}</strong> {index.source.eurostatUpdated.slice(0, 10)}</li>
          <li><strong>{shared.retrieved}</strong> {index.source.fetchedOn.slice(0, 10)}</li>
          <li>
            <strong>{shared.doi}</strong>
            <a href={`https://doi.org/${index.source.doi}`} data-method-link>{index.source.doi}</a>
          </li>
          {
            index.source.metadata && (
              <li>
                <strong>{shared.eurostatMetadata}</strong>
                <a href={index.source.metadata} data-method-link>{shared.explanatoryTexts}</a>
              </li>
            )
          }
        </ul>

        <p class="source-note">{' '}{shared.licence}{' '}<a href={linkTo('/method/', lang)}>{shared.theMethodPage}</a>.
        </p>
      </div>
    </div>
  </section>

  <CountryWiring metric="unemployment" />

  <style>
    .tile h3 {
      margin: 0 0 10px;
      font-size: 1.15rem;
    }

    .tile .meta {
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-2);
    }

    .prose {
      max-width: 70ch;
      color: var(--text-2);
    }

    .prose p {
      margin: 0 0 1em;
      line-height: 1.7;
    }

    .prose p:last-child {
      margin-bottom: 0;
    }

    .source-list {
      list-style: none;
      padding: 0;
    }

    .source-list li {
      padding: 0.35rem 0;
      border-bottom: 1px solid var(--line);
      font-size: 0.92rem;
    }

    .source-list li:last-child {
      border-bottom: 0;
    }

    .source-list strong {
      display: inline-block;
      min-width: 12rem;
      color: var(--text-2);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    @media (max-width: 540px) {
      .source-list strong {
        display: block;
        min-width: 0;
      }
    }
  </style>
</BaseV2>
