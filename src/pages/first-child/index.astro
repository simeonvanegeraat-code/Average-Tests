---
import { ui } from '../../lib/ui.js';
import { localeOf, linkTo } from '../../lib/locales.js';
import BaseV2 from '../../layouts/BaseV2.astro';
import Related from '../../components/Related.astro';
import StageMap from '../../components/StageMap.astro';
import CompareForm from '../../components/CompareForm.astro';
import RankTable from '../../components/RankTable.astro';
import MetricPersonal from '../../components/MetricPersonal.astro';
import geo from '../../../data/geo/europe.json';
import { withArticle } from '../../lib/metric.js';
import { firstChildPage } from '../../lib/pages/first-child.js';

/**
 * De Engelse /first-child/.
 *
 * Sinds 3 november 2026 bestaat deze pagina per taal als eigen bestand;
 * `src/pages/nl/first-child/index.astro` is de Nederlandse. Het rekenwerk staat in
 * `src/lib/pages/first-child.js` en is dus niet dubbel — wat hier staat is hoe deze taal
 * het verwoordt.
 *
 * Kaart, tabel en formulier zijn gedeelde componenten, het antwoordvak met zijn bedrading
 * zit in MetricPersonal, en de sjabloontekst komt uit `shared`. Geen cijfer staat hier
 * met de hand ingetypt.
 */
const lang = localeOf(Astro.url.pathname);
/** De sjabloontekst die elke metriekpagina deelt. Zie src/lib/ui.js. */
const shared = ui(lang).metricPage;
const { index, metric, h, movement, stale, euValue, bigOnes, fmt, amt, clientJson } = firstChildPage(lang);

const title = `Average Age at First Child by Country in Europe (${h.year})`;
const description = `Mothers in ${withArticle(h.latest.name)} are ${fmt(h.latest.total)} at their first child; in ${withArticle(h.earliest.name)} they are ${fmt(h.earliest.total)}. Compare all ${h.countries} countries on a map and see where your own age sits.`;
---

<BaseV2 title={title} description={description} canonical="/first-child/" hue={metric.hue}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">Eurostat · {h.countries} countries · {h.year}</p>
      <h1 data-reveal>Europe agrees about this more than about anything else measured here.</h1>
      <span class="giant num">{euValue}</span>
      <p class="unit mono">mother's age at first child · <b>{shared.europeanUnion}</b> · {h.year}</p>
      <p class="lead">From {fmt(h.earliest.total)} in {withArticle(h.earliest.name)} to {fmt(h.latest.total)} in {withArticle(h.latest.name)}: the whole continent fits inside {amt(h.gap)}. Every other figure on this site spreads wider.</p>
      <div class="hero-cta">
        <a class="btn" href="#compare">{shared.compareYourself}{' '}<span class="arr" aria-hidden="true">→</span></a>
        <span class="hint">{shared.nothingLeavesBrowser}</span>
      </div>
      <p class="hero-note">This is the mother's age. Eurostat publishes no figure for fathers here, so the page says mothers where it means mothers rather than writing "parents" over a gap in the data.</p>
    </div>
  </section>

  <StageMap geo={geo} index={index} metric={metric} eyebrow={shared.theMap} title="Where first children come earliest" lede={shared.tapACountry} />

  <section class="block" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.yourTurn}</p>
        <h2 id="compare-title">How old were you?</h2>
        <p>Enter your age when your first child was born.</p>
      </header>
      <div data-reveal>
        <CompareForm index={index} metric={metric} />
        <MetricPersonal metric="first-child" />
        <div class="limits">
          <b>An average age is not a deadline</b>
          <p>The figure is where the middle of a cohort sits, not a schedule. It also moves with who has children at all: a country where fewer people become parents can show an older average without anyone changing their plans.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="table-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.everyCountry}</p>
        <h2 id="table-title">All {index.countries.length} countries, youngest to oldest</h2>
        <p>Sort by any column. This dataset covers mothers only, so the sex columns are empty.</p>
      </header>
      <div data-reveal><RankTable index={index} metric={metric} /></div>
    </div>
  </section>

  <section class="block" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.whatTheNumbersSay}</p>
        <h2 id="facts-title">The tightest spread on the site</h2>
      </header>
      <div data-reveal>
          <div class="bento">
            <div class="tile s4">
              <div>
                <b>{amt(h.gap)}</b>
                <p>
                  separates the youngest country from the oldest — {withArticle(h.earliest.name)} at {fmt(h.earliest.total)} and {withArticle(h.latest.name)}
                  at {fmt(h.latest.total)}. For comparison, the age at which half of young people have left home
                  spreads more than twice as wide.
                </p>
              </div>
              <span class="meta mono">{h.year}</span>
            </div>
            <div class="tile dark">
              <div>
                <h3>Mothers only</h3>
                <p>
                  Eurostat publishes no equivalent figure for fathers in this dataset, so there is no
                  comparison to make and none is shown.
                </p>
              </div>
              <span class="meta mono">what is missing</span>
            </div>
          </div>
        <div class="prose"><p>The large economies land close together at {bigOnes}, and the youngest countries sit in the east and south-east. A continent that disagrees by ten years about leaving home disagrees by about five about this.</p></div>
      </div>
    </div>
  </section>

  <Related metric="first-child" />

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap method-grid">
      <header class="sec-head" data-reveal style="margin: 0">
        <p class="eyebrow mono">{shared.method}</p>
        <h2 id="method-title">{shared.howMeasured}</h2>
        <p>{shared.publishedByEurostat}</p>
      </header>
      <div data-reveal>
        <dl>
          <div><dt>{shared.whatTheFigureIs}</dt><dd>The mean age of the mother at the birth of her first child, from Eurostat's fertility indicators, derived from national birth registers.</dd></div>
          <div><dt>{shared.whatItIsNot}</dt><dd>It is not the age of fathers, not the age at any birth, and not a distribution. One number per country means no percentile.</dd></div>
          <div>
            <dt>{shared.coverage}</dt>
            <dd>
              {h.countries} countries have a figure for {h.year}.
              {stale.length > 0 && (<> {stale.slice(0, 6).map((country: any) => `${country.name} (${country.year})`).join(', ')} stopped reporting earlier and are shown at their most recent year, hatched on the map and labelled in the table.</>)}
              {' '}The United States, Canada and Australia are not in this dataset.
            </dd>
          </div>
          <div>
            <dt>{shared.seriesBreaks}</dt>
            <dd>
              {movement
                ? `None inside the window used here, ${movement.since} to ${movement.until}.`
                : `Eurostat flags a break in ${index.lastBreak}, in or just before the latest year, so no comparison with the past is shown on this page. A figure that looks like a trend across a break is worse than no trend at all.`}
            </dd>
          </div>
        </dl>

        <ul class="source-list">
          <li><strong>{shared.dataset}</strong>{' '}{shared.eurostat}{' '}<code>{index.source.dataset}</code>, {index.source.label}</li>
          <li><strong>{shared.series}</strong> {index.years[0]} to {index.years[index.years.length - 1]}</li>
          <li><strong>{shared.lastUpdated}</strong> {index.source.eurostatUpdated.slice(0, 10)}</li>
          <li><strong>{shared.retrieved}</strong> {index.source.fetchedOn.slice(0, 10)}</li>
          <li><strong>{shared.doi}</strong><a href={`https://doi.org/${index.source.doi}`} data-method-link>{index.source.doi}</a></li>
          {index.source.metadata && (<li><strong>{shared.eurostatMetadata}</strong><a href={index.source.metadata} data-method-link>{shared.explanatoryTexts}</a></li>)}
        </ul>

        <p class="source-note">{' '}{shared.licence}{' '}<a href={linkTo('/method/', lang)}>{shared.theMethodPage}</a>.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="metric-data" set:html={clientJson} />

  <style>
    .tile h3 { margin: 0 0 10px; font-size: 1.15rem; }
    .tile .meta { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
    .prose { margin-top: 28px; max-width: 70ch; color: var(--text-2); }
    .prose p { margin: 0; line-height: 1.7; }
    .source-list { list-style: none; padding: 0; }
    .source-list li { padding: 0.35rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
    .source-list li:last-child { border-bottom: 0; }
    .source-list strong { display: inline-block; min-width: 12rem; color: var(--text-2); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    @media (max-width: 540px) { .source-list strong { display: block; min-width: 0; } }
  </style>
</BaseV2>
