---
import { ui } from '../../../lib/ui.js';
import { localeOf, linkTo } from '../../../lib/locales.js';
import BaseV2 from '../../../layouts/BaseV2.astro';
import Related from '../../../components/Related.astro';
import StageMap from '../../../components/StageMap.astro';
import CompareForm from '../../../components/CompareForm.astro';
import RankTable from '../../../components/RankTable.astro';
import MetricPersonal from '../../../components/MetricPersonal.astro';
import geo from '../../../../data/geo/europe.json';
import { grammarOf } from '../../../lib/grammar.js';
import { firstChildPage } from '../../../lib/pages/first-child.js';

/**
 * De Nederlandse /first-child/.
 *
 * Geen vertaling van `src/pages/first-child/index.astro` maar een eigen pagina: het
 * rekenwerk komt uit `src/lib/pages/first-child.js`, de woorden staan hier.
 *
 * De kop loopt anders dan de Engelse. "Europe agrees about this more than about anything
 * else measured here" is een vondst die in het Nederlands stijf wordt; "Hier zijn de
 * Europese landen het meest met elkaar eens" zegt hetzelfde en leest wel. Dat kan alleen
 * als de zin hier geschreven wordt in plaats van ingevuld.
 *
 * Geen enkel cijfer staat hier met de hand.
 */
const lang = localeOf(Astro.url.pathname);
/** De sjabloontekst die elke metriekpagina deelt. Zie src/lib/ui.js. */
const shared = ui(lang).metricPage;
const { index, metric, h, movement, stale, euValue, bigOnes, fmt, amt, clientJson } = firstChildPage(lang);

const g = grammarOf(lang);

const title = `Op welke leeftijd krijgen vrouwen hun eerste kind? Europa vergeleken (${h.year})`;
const description = `Moeders in ${g.withArticle(h.latest.name)} zijn ${fmt(h.latest.total)} bij hun eerste kind; in ${g.withArticle(h.earliest.name)} ${fmt(h.earliest.total)}. Vergelijk alle ${h.countries} landen op de kaart en zie waar jouw eigen leeftijd valt.`;
---

<BaseV2 title={title} description={description} canonical="/first-child/" hue={metric.hue}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">Eurostat · {h.countries} landen · {h.year}</p>
      <h1 data-reveal>Hier zijn de Europese landen het meest met elkaar eens.</h1>
      <span class="giant num">{euValue}</span>
      <p class="unit mono">leeftijd van de moeder bij haar eerste kind · <b>{shared.europeanUnion}</b> · {h.year}</p>
      <p class="lead">Van {fmt(h.earliest.total)} in {g.withArticle(h.earliest.name)} tot {fmt(h.latest.total)} in {g.withArticle(h.latest.name)}: het hele werelddeel past binnen {amt(h.gap)}. Elk ander cijfer op deze site spreidt breder.</p>
      <div class="hero-cta">
        <a class="btn" href="#compare">{shared.compareYourself}{' '}<span class="arr" aria-hidden="true">→</span></a>
        <span class="hint">{shared.nothingLeavesBrowser}</span>
      </div>
      <p class="hero-note">Dit is de leeftijd van de moeder. Eurostat publiceert hier geen cijfer voor vaders, dus de pagina zegt moeders waar ze moeders bedoelt, in plaats van "ouders" over een gat in de data te schrijven.</p>
    </div>
  </section>

  <StageMap geo={geo} index={index} metric={metric} eyebrow={shared.theMap} title="Waar het eerste kind het vroegst komt" lede={shared.tapACountry} />

  <section class="block" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.yourTurn}</p>
        <h2 id="compare-title">Hoe oud was jij?</h2>
        <p>Vul in hoe oud je was toen je eerste kind geboren werd.</p>
      </header>
      <div data-reveal>
        <CompareForm index={index} metric={metric} />
        <MetricPersonal metric="first-child" />
        <div class="limits">
          <b>Een gemiddelde leeftijd is geen deadline</b>
          <p>Het cijfer zegt waar het midden van een cohort ligt, niet wat het schema is. Het beweegt ook mee met wie er überhaupt kinderen krijgt: in een land waar minder mensen ouder worden kan het gemiddelde stijgen zonder dat iemand zijn plannen verandert.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="table-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.everyCountry}</p>
        <h2 id="table-title">Alle {index.countries.length} landen, van jongst naar oudst</h2>
        <p>Sorteer op elke kolom. Deze dataset gaat alleen over moeders, dus de geslachtskolommen zijn leeg.</p>
      </header>
      <div data-reveal><RankTable index={index} metric={metric} /></div>
    </div>
  </section>

  <section class="block" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.whatTheNumbersSay}</p>
        <h2 id="facts-title">De kleinste spreiding van de site</h2>
      </header>
      <div data-reveal>
          <div class="bento">
            <div class="tile s4">
              <div>
                <b>{amt(h.gap)}</b>
                <p>
                  zit er tussen het jongste en het oudste land — {g.withArticle(h.earliest.name)} op {fmt(h.earliest.total)} en {g.withArticle(h.latest.name)}
                  op {fmt(h.latest.total)}. Ter vergelijking: de leeftijd waarop de helft van de jongeren het huis uit is,
                  spreidt meer dan twee keer zo breed.
                </p>
              </div>
              <span class="meta mono">{h.year}</span>
            </div>
            <div class="tile dark">
              <div>
                <h3>Alleen moeders</h3>
                <p>
                  Eurostat publiceert in deze dataset geen vergelijkbaar cijfer voor vaders, dus er is
                  niets te vergelijken en er staat niets.
                </p>
              </div>
              <span class="meta mono">wat ontbreekt</span>
            </div>
          </div>
        <div class="prose"><p>De grote economieën liggen dicht bij elkaar op {bigOnes}, en de jongste landen zitten in het oosten en zuidoosten. Een werelddeel dat tien jaar van mening verschilt over het huis uit gaan, verschilt hierover ongeveer vijf.</p></div>
      </div>
    </div>
  </section>

  <Related metric="first-child" />

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap method-grid">
      <header class="sec-head" data-reveal style="margin: 0">
        <p class="eyebrow mono">{shared.method}</p>
        <h2 id="method-title">{shared.howMeasured}</h2>
        <p>{shared.publishedByEurostat}</p>
      </header>
      <div data-reveal>
        <dl>
          <div><dt>{shared.whatTheFigureIs}</dt><dd>De gemiddelde leeftijd van de moeder bij de geboorte van haar eerste kind, uit de vruchtbaarheidsindicatoren van Eurostat, afgeleid uit de nationale geboorteregisters.</dd></div>
          <div><dt>{shared.whatItIsNot}</dt><dd>Het is niet de leeftijd van vaders, niet de leeftijd bij elke geboorte, en geen verdeling. Één getal per land betekent geen percentiel.</dd></div>
          <div>
            <dt>{shared.coverage}</dt>
            <dd>
              {h.countries} landen hebben een cijfer voor {h.year}.
              {stale.length > 0 && (<> {stale.slice(0, 6).map((country: any) => `${country.name} (${country.year})`).join(', ')} stopten eerder met rapporteren en staan op hun meest recente jaar, gearceerd op de kaart en benoemd in de tabel.</>)}
              {' '}De Verenigde Staten, Canada en Australië zitten niet in deze dataset.
            </dd>
          </div>
          <div>
            <dt>{shared.seriesBreaks}</dt>
            <dd>
              {movement
                ? `Geen binnen het venster dat hier gebruikt wordt, ${movement.since} tot ${movement.until}.`
                : `Eurostat markeert een breuk in ${index.lastBreak}, in of net vóór het laatste jaar, dus er staat op deze pagina geen vergelijking met het verleden. Een cijfer dat op een trend lijkt maar over een breuk heen loopt is erger dan geen trend.`}
            </dd>
          </div>
        </dl>

        <ul class="source-list">
          <li><strong>{shared.dataset}</strong>{' '}{shared.eurostat}{' '}<code>{index.source.dataset}</code>, {index.source.label}</li>
          <li><strong>{shared.series}</strong> {index.years[0]} tot {index.years[index.years.length - 1]}</li>
          <li><strong>{shared.lastUpdated}</strong> {index.source.eurostatUpdated.slice(0, 10)}</li>
          <li><strong>{shared.retrieved}</strong> {index.source.fetchedOn.slice(0, 10)}</li>
          <li><strong>{shared.doi}</strong><a href={`https://doi.org/${index.source.doi}`} data-method-link>{index.source.doi}</a></li>
          {index.source.metadata && (<li><strong>{shared.eurostatMetadata}</strong><a href={index.source.metadata} data-method-link>{shared.explanatoryTexts}</a></li>)}
        </ul>

        <p class="source-note">{' '}{shared.licence}{' '}<a href={linkTo('/method/', lang)}>{shared.theMethodPage}</a>.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="metric-data" set:html={clientJson} />

  <style>
    .tile h3 { margin: 0 0 10px; font-size: 1.15rem; }
    .tile .meta { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
    .prose { margin-top: 28px; max-width: 70ch; color: var(--text-2); }
    .prose p { margin: 0; line-height: 1.7; }
    .source-list { list-style: none; padding: 0; }
    .source-list li { padding: 0.35rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
    .source-list li:last-child { border-bottom: 0; }
    .source-list strong { display: inline-block; min-width: 12rem; color: var(--text-2); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    @media (max-width: 540px) { .source-list strong { display: block; min-width: 0; } }
  </style>
</BaseV2>
