---
import { ui } from '../../../lib/ui.js';
import { localeOf, linkTo } from '../../../lib/locales.js';
import BaseV2 from '../../../layouts/BaseV2.astro';
import Related from '../../../components/Related.astro';
import StageMap from '../../../components/StageMap.astro';
import CompareForm from '../../../components/CompareForm.astro';
import RankTable from '../../../components/RankTable.astro';
import MetricPersonal from '../../../components/MetricPersonal.astro';
import geo from '../../../../data/geo/europe.json';
import { grammarOf } from '../../../lib/grammar.js';
import { dwellingSizePage } from '../../../lib/pages/dwelling-size.js';

/**
 * De Nederlandse /dwelling-size/.
 *
 * Eigen pagina, geen vertaling: het rekenwerk komt uit
 * `src/lib/pages/dwelling-size.js`, de deling door de huishoudgrootte inbegrepen.
 *
 * De kop van deze pagina is een omkering ("niet waar je zou denken") en die werkt in het
 * Nederlands net zo goed. Wat anders loopt zijn de rangnummers: het Engels zegt "3rd of
 * 29", het Nederlands "de 3e van 29" — met een lidwoord dat het Engels niet nodig heeft.
 * Vandaar `g.ordinal` en niet de Engelse `ordinal` uit metric.js.
 *
 * Geen enkel cijfer staat hier met de hand.
 */
const lang = localeOf(Astro.url.pathname);
/** De sjabloontekst die elke metriekpagina deelt. Zie src/lib/ui.js. */
const shared = ui(lang).metricPage;
const {
  index,
  householdData,
  metric,
  h,
  stale,
  space,
  euValue,
  ratio,
  ratioArea,
  ratioPerson,
  small5,
  large5,
  bigOnes,
  movers,
  fmt,
  amt,
  people,
  peopleValue,
  clientJson,
} = dwellingSizePage(lang);

const g = grammarOf(lang);

const title = `Gemiddelde woninggrootte per land in Europa (${h.year})`;
const description = `De gemiddelde woning in de Europese Unie is ${euValue} m² — ${fmt(h.earliest.total)} in ${g.withArticle(h.earliest.name)} en ${fmt(h.latest.total)} in ${g.withArticle(h.latest.name)}. Vergelijk alle ${h.countries} landen op de kaart, en zie waar mensen de meeste ruimte per persoon hebben.`;
---

<BaseV2 title={title} description={description} canonical="/dwelling-size/" hue={metric.hue}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">Eurostat · {h.countries} landen · {h.year}</p>
      <h1 data-reveal>De grootste woningen van Europa staan niet waar mensen de meeste ruimte hebben.</h1>
      <span class="giant num">{euValue}</span>
      <p class="unit mono">m² per woning · <b>{shared.europeanUnion}</b> · {h.year}</p>
      <p class="lead">Een woning in {g.withArticle(h.latest.name)} is gemiddeld {fmt(h.latest.total)} m² en een in {g.withArticle(h.earliest.name)} {fmt(h.earliest.total)} — {ratio} keer het verschil. Deel door het aantal mensen dat erin woont en de rangorde verandert.</p>
      <div class="hero-cta">
        <a class="btn" href="#compare">{shared.compareYourself}{' '}<span class="arr" aria-hidden="true">→</span></a>
        <span class="hint">{shared.nothingLeavesBrowser}</span>
      </div>
      <p class="hero-note">Dit is vloeroppervlak, gemiddeld over elke soort woning: koop en huur, appartementen en huizen, elke inkomensgroep. Het is de grootte van de woning, niet van het perceel, en niet van nieuwbouw — die is jonger en groter, bijna overal.</p>
    </div>
  </section>

  <StageMap geo={geo} index={index} metric={metric} eyebrow={shared.theMap} title="Waar de woningen het grootst zijn" lede={shared.tapACountry} />

  <section class="block" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.yourTurn}</p>
        <h2 id="compare-title">Hoe groot is jouw woning?</h2>
        <p>Vul het vloeroppervlak van je woning in vierkante meters in — de hele woning, niet één kamer.</p>
      </header>
      <div data-reveal>
        <CompareForm index={index} metric={metric} />
        <MetricPersonal metric="dwelling-size" />
        <div class="limits">
          <b>Wat een vloeroppervlak niet zegt</b>
          <p>Twee woningen van dezelfde grootte zijn niet dezelfde woning. Dit cijfer negeert hoeveel mensen er wonen, hoe de ruimte verdeeld is, of er buitenruimte is, en wat het kost. Een appartement van 90 m² in een hoofdstad en een huis van 90 m² in een dorp zijn hier hetzelfde getal en verder niets hetzelfde.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="table-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.everyCountry}</p>
        <h2 id="table-title">Alle {index.countries.length} landen, van klein naar groot</h2>
        <p>Sorteer op elke kolom. Deze dataset heeft geen uitsplitsing naar geslacht, dus die kolommen zijn leeg.</p>
      </header>
      <div data-reveal><RankTable index={index} metric={metric} /></div>
    </div>
  </section>

  {
    space && (
      <section class="block" id="per-person" aria-labelledby="per-person-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">Onze eigen berekening</p>
            <h2 id="per-person-title">Vloeroppervlak per persoon</h2>
            <p>
              Deel de gemiddelde woning door het gemiddelde huishouden en {space.moved} van de {space.of}{' '}
              landen wisselen van plaats.
            </p>
          </header>

          <div data-reveal>
            <div class="split">
              <div class="split-side">
                <span class="k">Grootste woningen</span>
                <b>{fmt(space.biggest.m2)} m²</b>
                <span class="d">
                  {space.biggest.name} — {people(space.biggest.people)} per huishouden, dus{' '}
                  {fmt(space.biggest.per)} m² elk, en dat is de {g.ordinal(space.biggest.personRank)} van{' '}
                  {space.of}.
                </span>
              </div>
              <span class="split-vs" aria-hidden="true">vs</span>
              <div class="split-side own">
                <span class="k">Meeste ruimte per persoon</span>
                <b>{fmt(space.mostSpace.per)} m²</b>
                <span class="d">
                  {space.mostSpace.name} — kleinere woningen van {fmt(space.mostSpace.m2)} m², maar met{' '}
                  {people(space.mostSpace.people)} erin.
                </span>
              </div>
            </div>

            <div class="prose">
              <p>
                De spreiding wordt hier groter. Gemeten naar vloeroppervlak is het grootste land{' '}
                {ratioArea} keer het kleinste; per persoon is het {ratioPerson} keer.
                Landen met grote woningen hebben vaak grote huishoudens, en die twee heffen elkaar
                deels op:
                {movers.map((row, i) => (
                  <>
                    {i === 0 ? ' ' : i === movers.length - 1 ? ' en ' : ', '}
                    {row.name} gaat van de {g.ordinal(row.areaRank)} naar de {g.ordinal(row.personRank)}
                  </>
                ))}.
              </p>
              <p>
                <b>Dit is een verhouding van twee gemiddelden, niet een gemiddelde van verhoudingen.</b>{' '}
                Het is één gepubliceerd cijfer gedeeld door een ander, dus het beschrijft een land en
                niet een huishouden daarin — geen enkele woning bevat{' '}
                {space.eu ? people(space.eu.people) : 'het gemiddelde aantal mensen'}. Beide cijfers komen
                uit dezelfde enquête, EU-SILC, en hetzelfde jaar, {space.year}; huishoudgrootte is
                gepubliceerd tot en met {householdData.latestYear}, en deze berekening gebruikt{' '}
                {space.year} aan beide kanten in plaats van het nieuwste van elk.
              </p>
            </div>

            <div class="tablewrap" tabindex="0" role="region" aria-label="Vloeroppervlak per persoon per land">
              <table>
                <caption class="vh">
                  Gemiddelde woninggrootte, gemiddelde huishoudgrootte en vloeroppervlak per persoon, {space.year}
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Land</th>
                    <th scope="col" class="n">m² per woning</th>
                    <th scope="col" class="n">Personen</th>
                    <th scope="col" class="n">m² per persoon</th>
                  </tr>
                </thead>
                <tbody>
                  {space.byPerson.map((row) => (
                    <tr>
                      <th scope="row">{row.name}</th>
                      <td class="n">{fmt(row.m2)}</td>
                      <td class="n">{peopleValue(row.people)}</td>
                      <td class="n strong">{fmt(row.per)}</td>
                    </tr>
                  ))}
                  {space.eu && (
                    <tr class="emphasis">
                      <th scope="row">{shared.europeanUnion}</th>
                      <td class="n">{fmt(space.eu.m2)}</td>
                      <td class="n">{peopleValue(space.eu.people)}</td>
                      <td class="n strong">{fmt(space.eu.per)}</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="block" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.whatTheNumbersSay}</p>
        <h2 id="facts-title">Rijkdom verklaart hier minder dan je zou denken</h2>
      </header>
      <div data-reveal>
        <div class="bento">
          <div class="tile s4">
            <div>
              <b>{ratio}×</b>
              <p>
                scheidt de grootste woningen van de kleinste — {g.withArticle(h.latest.name)} op{' '}
                {fmt(h.latest.total)} m² en {g.withArticle(h.earliest.name)} op {fmt(h.earliest.total)} m², een
                verschil van {amt(h.gap)}. De vijf grootste zijn {large5}; de vijf kleinste {small5}.
              </p>
            </div>
            <span class="meta mono">{h.year}</span>
          </div>
          <div class="tile dark">
            <div>
              <h3>Eén jaar, geen trend</h3>
              <p>
                Eurostat publiceert deze tabel alleen voor {h.year}. Er is geen eerder jaar om mee te
                vergelijken, dus deze pagina laat er geen zien — geen lijn door één punt.
              </p>
            </div>
            <span class="meta mono">waarom deze pagina geen historie heeft</span>
          </div>
        </div>
        <div class="prose">
          <p>
            De grote economieën zitten in het midden en dicht bij elkaar: {bigOnes}. Erboven staan
            kleine rijke landen en de Middellandse Zee; eronder Midden- en Oost-Europa. Maar de
            rijkste landen staan niet bovenaan, en {space ? `${space.biggest.name}, met de grootste woningen van allemaal, staat per persoon op de ${g.ordinal(space.biggest.personRank)} plaats` : 'de rangorde verschuift zodra je de huishoudgrootte meeneemt'}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Related metric="dwelling-size" />

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap method-grid">
      <header class="sec-head" data-reveal style="margin: 0">
        <p class="eyebrow mono">{shared.method}</p>
        <h2 id="method-title">{shared.howMeasured}</h2>
        <p>Gepubliceerd door Eurostat. Het enige cijfer dat wij zelf berekenen is vloeroppervlak per persoon, en dat staat als zodanig gemarkeerd.</p>
      </header>
      <div data-reveal>
        <dl>
          <div><dt>{shared.whatTheFigureIs}</dt><dd>Het gemiddelde nuttige vloeroppervlak van een woning in vierkante meters, uit EU-SILC, de Europese enquête naar inkomen en levensomstandigheden. Eurostat publiceert het per inkomenskwintiel en naar eigendomsvorm; deze pagina neemt het totaal van beide, en dat is het cijfer voor alle huishoudens in het land.</dd></div>
          <div><dt>{shared.whatItIsNot}</dt><dd>Het is niet ruimte per persoon — die berekening staat hierboven en is van ons, niet van Eurostat. Het is niet de grootte van nieuwbouw, geen telling van kamers, en geen verdeling: Eurostat publiceert één getal per land, dus er valt geen percentiel te halen, alleen aan welke kant van het gemiddelde je zit.</dd></div>
          <div>
            <dt>{shared.coverage}</dt>
            <dd>
              {h.countries} landen hebben een cijfer voor {h.year}.
              {stale.length > 0 && (<> {stale.slice(0, 6).map((country: any) => `${country.name} (${country.year})`).join(', ')} stopten eerder met rapporteren en staan op hun meest recente jaar, gearceerd op de kaart en benoemd in de tabel.</>)}
              {' '}{shared.notInDataset}
            </dd>
          </div>
          <div>
            <dt>{shared.seriesBreaks}</dt>
            <dd>
              Geen, want er is niets om te breken: {index.years.length === 1
                ? `Eurostat heeft deze tabel alleen voor ${index.years[0]} gepubliceerd.`
                : `de gepubliceerde reeks loopt ${index.years[0]} tot ${index.years[index.years.length - 1]}.`} Eén
              jaar kan niet met zijn eigen verleden vergeleken worden, en deze pagina doet niet alsof.
            </dd>
          </div>
        </dl>

        <ul class="source-list">
          <li><strong>{shared.dataset}</strong>{' '}{shared.eurostat}{' '}<code>{index.source.dataset}</code>, {index.source.label}</li>
          <li><strong>{shared.series}</strong> {index.years[0]}{index.years.length > 1 && ` tot ${index.years[index.years.length - 1]}`}</li>
          <li><strong>{shared.lastUpdated}</strong> {index.source.eurostatUpdated.slice(0, 10)}</li>
          <li><strong>{shared.retrieved}</strong> {index.source.fetchedOn.slice(0, 10)}</li>
          <li><strong>{shared.doi}</strong><a href={`https://doi.org/${index.source.doi}`} data-method-link>{index.source.doi}</a></li>
          {index.source.metadata && (<li><strong>{shared.eurostatMetadata}</strong><a href={index.source.metadata} data-method-link>{shared.explanatoryTexts}</a></li>)}
          {space && (<li><strong>Huishoudgrootte</strong>{' '}{shared.eurostat}{' '}<code>{householdData.source.dataset}</code> bij {space.year}, alleen gebruikt voor de berekening per persoon — <a href={linkTo('/household-size/', lang)}>de eigen pagina staat hier</a></li>)}
        </ul>

        <p class="source-note">{' '}{shared.licence}{' '}<a href={linkTo('/method/', lang)}>{shared.theMethodPage}</a>.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="metric-data" set:html={clientJson} />

  <style>
    .tile h3 { margin: 0 0 10px; font-size: 1.15rem; }
    .tile .meta { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
    .prose { margin-top: 28px; max-width: 70ch; color: var(--text-2); }
    .prose p { margin: 0 0 14px; line-height: 1.7; }
    .prose p:last-child { margin-bottom: 0; }
    #per-person .tablewrap { margin-top: 28px; }
    /* .split komt van de vermogenspagina's; daar heeft de toelichting geen eigen regel. */
    .split-side .d { display: block; margin-top: 10px; color: var(--text-2); font-size: 0.86rem; line-height: 1.5; }
    .source-list { list-style: none; padding: 0; }
    .source-list li { padding: 0.35rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
    .source-list li:last-child { border-bottom: 0; }
    .source-list strong { display: inline-block; min-width: 12rem; color: var(--text-2); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    @media (max-width: 540px) { .source-list strong { display: block; min-width: 0; } }
  </style>
</BaseV2>
