---
import { ui } from '../../../lib/ui.js';
import { localeOf, linkTo } from '../../../lib/locales.js';
import BaseV2 from '../../../layouts/BaseV2.astro';
import Related from '../../../components/Related.astro';
import StageMap from '../../../components/StageMap.astro';
import CompareForm from '../../../components/CompareForm.astro';
import RankTable from '../../../components/RankTable.astro';
import MetricPersonal from '../../../components/MetricPersonal.astro';
import geo from '../../../../data/geo/europe.json';
import { grammarOf } from '../../../lib/grammar.js';
import { householdSizePage } from '../../../lib/pages/household-size.js';

/**
 * De Nederlandse /household-size/.
 *
 * Geen vertaling van `src/pages/household-size/index.astro` maar een eigen pagina: het
 * rekenwerk komt uit `src/lib/pages/household-size.js`, de woorden staan hier.
 *
 * De kop loopt in het Nederlands anders dan in het Engels. "nearly twice as many people"
 * is in het Nederlands een stijve constructie; "bijna twee keer zo veel mensen" kan wel,
 * maar de kop wordt sterker als hij het getal zelf noemt. Dat kan alleen als de zin hier
 * geschreven wordt in plaats van ingevuld.
 *
 * Geen enkel cijfer staat hier met de hand, net als in de Engelse versie.
 */
const lang = localeOf(Astro.url.pathname);
/** De sjabloontekst die elke metriekpagina deelt. Zie src/lib/ui.js. */
const shared = ui(lang).metricPage;
const { index, metric, h, movement, stale, euValue, ratio, small5, large5, bigOnes, fmt, clientJson } =
  householdSizePage(lang);

const g = grammarOf(lang);

const title = `Hoeveel mensen wonen er in één huishouden? Europa vergeleken (${h.year})`;
const description = `Het gemiddelde Europese huishouden telt ${euValue} personen — ${fmt(h.earliest.total)} in ${g.withArticle(h.earliest.name)} en ${fmt(h.latest.total)} in ${g.withArticle(h.latest.name)}. Vergelijk alle ${h.countries} landen op de kaart en zie waar jouw eigen huishouden valt.`;
---

<BaseV2 title={title} description={description} canonical="/household-size/" hue={metric.hue}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">Eurostat · {h.countries} landen · {h.year}</p>
      <h1 data-reveal>In het ene Europese land wonen er {ratio} keer zo veel mensen onder één dak als in het andere.</h1>
      <span class="giant num">{euValue}</span>
      <p class="unit mono">personen per huishouden · <b>Europese Unie</b> · {h.year}</p>
      <p class="lead">In {g.withArticle(h.earliest.name)} telt het gemiddelde huishouden {fmt(h.earliest.total)} personen. In {g.withArticle(h.latest.name)} is dat {fmt(h.latest.total)}. Geen verschil van een paar procent — het een is {ratio} keer het ander.</p>
      <div class="hero-cta">
        <a class="btn" href="#compare">Vergelijk jezelf <span class="arr" aria-hidden="true">→</span></a>
        <span class="hint">Niets van wat je typt verlaat je browser.</span>
      </div>
      <p class="hero-note">Een gemiddeld huishouden is geen gezin. Het telt iedereen die op één adres woont, dus een land vol alleenwonenden scoort laag — of dat studenten, gescheiden of weduwen zijn maakt niet uit. Het cijfer zegt hoeveel mensen een dak delen, en niets over wat ze voor elkaar zijn.</p>
    </div>
  </section>

  <StageMap geo={geo} index={index} metric={metric} eyebrow={shared.theMap} title="Waar de huishoudens het grootst zijn" lede={shared.tapACountry} />

  <section class="block" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">Jouw beurt</p>
        <h2 id="compare-title">Hoe groot is jouw huishouden?</h2>
        <p>Tel iedereen die op jouw adres woont, jezelf inbegrepen.</p>
      </header>
      <div data-reveal>
        <CompareForm index={index} metric={metric} />
        <MetricPersonal metric="household-size" />
        <div class="limits">
          <b>Wat één huishouden je niet kan vertellen</b>
          <p>Jouw huishouden is één adres; het landcijfer is een gemiddelde over miljoenen. Erboven of eronder zitten zegt niets over of jouw huishouden ongewoon is — er zijn genoeg landen met een gemiddelde van twee terwijl de meeste huishoudens er één of drie hebben, en bijna geen enkele precies twee.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="table-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">Elk land</p>
        <h2 id="table-title">Alle {index.countries.length} landen, van klein naar groot</h2>
        <p>Sorteer op elke kolom. Deze dataset heeft geen uitsplitsing naar geslacht, dus die kolommen zijn leeg.</p>
      </header>
      <div data-reveal><RankTable index={index} metric={metric} /></div>
    </div>
  </section>

  <section class="block" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">Wat de cijfers zeggen</p>
        <h2 id="facts-title">Er loopt een lijn van noordwest naar zuidoost</h2>
      </header>
      <div data-reveal>
          <div class="bento">
            <div class="tile s4">
              <div>
                <b>{ratio}×</b>
                <p>
                  het verschil tussen het grootste en het kleinste gemiddelde huishouden. De vijf
                  kleinste zijn {small5}; de vijf grootste {large5}.
                </p>
              </div>
              <span class="meta mono">{h.year}</span>
            </div>
            <div class="tile dark">
              <div>
                <h3>Geen trend te tonen</h3>
                <p>
                  Eurostat markeert een reeksbreuk in {index.lastBreak}, het laatste jaar zelf, dus er is geen
                  venster waarin dit cijfer met zijn eigen verleden te vergelijken valt.
                </p>
              </div>
              <span class="meta mono">waarom deze pagina geen historie heeft</span>
            </div>
          </div>
        <div class="prose"><p>Het patroon is eerst geografisch en daarna al het andere. Huishoudens krimpen naar het noorden en het westen en groeien naar het zuiden en het oosten, en de grote economieën liggen dicht bij elkaar in het midden: {bigOnes}. Wat het verschil ook drijft, rijkdom alleen is het niet.</p></div>
      </div>
    </div>
  </section>

  <Related metric="household-size" />

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap method-grid">
      <header class="sec-head" data-reveal style="margin: 0">
        <p class="eyebrow mono">Methode</p>
        <h2 id="method-title">Hoe dit gemeten is</h2>
        <p>Gepubliceerd door Eurostat. Er wordt hier niets bij geschat boven wat zij publiceren.</p>
      </header>
      <div data-reveal>
        <dl>
          <div><dt>Wat het cijfer is</dt><dd>Het gemiddelde aantal mensen dat in een huishouden woont, uit EU-SILC, de Europese enquête naar inkomen en levensomstandigheden. Een huishouden is iedereen die een adres en de kosten van het wonen deelt.</dd></div>
          <div><dt>Wat het niet is</dt><dd>Het is geen gezinsgrootte en geen telling van kinderen. Het is ook geen verdeling: Eurostat publiceert één getal per land, dus er valt geen percentiel uit te halen — alleen aan welke kant van het gemiddelde je zit.</dd></div>
          <div>
            <dt>Dekking</dt>
            <dd>
              {h.countries} landen hebben een cijfer voor {h.year}.
              {stale.length > 0 && (<> {stale.slice(0, 6).map((country: any) => `${country.name} (${country.year})`).join(', ')} stopten eerder met rapporteren en staan op hun meest recente jaar, gearceerd op de kaart en benoemd in de tabel.</>)}
              {' '}{shared.notInDataset}
            </dd>
          </div>
          <div>
            <dt>Reeksbreuken</dt>
            <dd>
              {movement
                ? `Geen binnen het venster dat hier gebruikt wordt, ${movement.since} tot ${movement.until}.`
                : `Eurostat markeert een breuk in ${index.lastBreak}, in of net vóór het laatste jaar, dus er staat op deze pagina geen vergelijking met het verleden. Een cijfer dat op een trend lijkt maar over een breuk heen loopt is erger dan geen trend.`}
            </dd>
          </div>
        </dl>

        <ul class="source-list">
          <li><strong>{shared.dataset}</strong>{' '}{shared.eurostat}{' '}<code>{index.source.dataset}</code>, {index.source.label}</li>
          <li><strong>Reeks</strong> {index.years[0]} tot {index.years[index.years.length - 1]}</li>
          <li><strong>Laatst bijgewerkt door Eurostat</strong> {index.source.eurostatUpdated.slice(0, 10)}</li>
          <li><strong>Opgehaald</strong> {index.source.fetchedOn.slice(0, 10)}</li>
          <li><strong>{shared.doi}</strong><a href={`https://doi.org/${index.source.doi}`} data-method-link>{index.source.doi}</a></li>
          {index.source.metadata && (<li><strong>Metadata van Eurostat</strong><a href={index.source.metadata} data-method-link>toelichtende teksten</a></li>)}
        </ul>

        <p class="source-note">
          Licentie: data van Eurostat mag hergebruikt worden, ook commercieel, met bronvermelding. Hoe wij
          met data omgaan staat op <a href={linkTo('/method/', lang)}>de methodepagina</a>.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="metric-data" set:html={clientJson} />

  <style>
    .tile h3 { margin: 0 0 10px; font-size: 1.15rem; }
    .tile .meta { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
    .prose { margin-top: 28px; max-width: 70ch; color: var(--text-2); }
    .prose p { margin: 0; line-height: 1.7; }
    .source-list { list-style: none; padding: 0; }
    .source-list li { padding: 0.35rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
    .source-list li:last-child { border-bottom: 0; }
    .source-list strong { display: inline-block; min-width: 12rem; color: var(--text-2); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    @media (max-width: 540px) { .source-list strong { display: block; min-width: 0; } }
  </style>
</BaseV2>
