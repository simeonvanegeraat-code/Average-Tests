---
import BaseV2 from '../layouts/BaseV2.astro';
import leaving from '../../data/leaving-home/index.json';
import wealth from '../../data/wealth/index.json';
import { headline, age } from '../lib/leaving-home.js';
import { euro, formatPeriod } from '../lib/wealth.js';

/**
 * De Engelse homepage. De voordeur.
 *
 * Herschreven op 24 oktober 2026. De vorige versie verkocht het percentielproduct op
 * Amerikaanse microdata: de kop was "You never wanted the average", de twee knoppen
 * wezen naar /height/ en /weight/, en zelfs het logo linkte daarheen. Die pagina's
 * zijn eraf, dus die voordeur wees naar niets.
 *
 * Elk getal hieronder komt uit de gebouwde databestanden. Type hier nooit een getal
 * met de hand in: dan wijkt de voordeur ooit stilletjes af van de pagina erachter.
 */

const h = headline(leaving);
const euroArea = wealth.euroArea;

const medians = wealth.countries.map((country: { median: number }) => country.median).sort((a, b) => a - b);
const poorest = medians[0];
const richest = medians[medians.length - 1];

const title = 'HumanAverage — European Figures, and Where You Fall';
const description =
  `One question per page, answered for every European country. Half of young Europeans have ` +
  `left home by age ${age(h.eu.total)}; the median euro-area household is worth ` +
  `${euro(euroArea.median)}. Published figures from Eurostat and the ECB, with a map, every ` +
  `country, and your own place in it.`;
---

<BaseV2 title={title} description={description} canonical="/">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'HumanAverage',
        url: 'https://www.humanaverage.com/',
        inLanguage: 'en-US',
        description:
          'Country-by-country comparisons of how Europeans live, built from figures published by Eurostat and the European Central Bank.',
        publisher: {
          '@type': 'Organization',
          name: 'HumanAverage',
          url: 'https://www.humanaverage.com/',
        },
      })}
    />
  </Fragment>

  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">Eurostat · ECB · {h.countries} countries</p>

      <h1 data-reveal>A European average describes almost nobody.</h1>

      <span class="giant num">{h.gap.toFixed(1)}</span>
      <p class="unit mono">
        years between the earliest and the latest country — <b>same question</b>, {h.year}
      </p>

      <p class="lead">
        In {h.earliest.name} half of young people have left home by {age(h.earliest.total)}. In {
          h.latest.name
        } that point does not arrive until {age(h.latest.total)}. One European figure hides both.
      </p>

      <div class="hero-cta">
        <a class="btn" href="/leaving-home/">
          Start with leaving home <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="/wealth/">Or household wealth</a>
        <span class="hint">No sign-up. Nothing you type leaves your browser.</span>
      </div>

      <p class="hero-note">
        Every page takes one figure that <em>Eurostat</em>, the <em>OECD</em> or the <em>ECB</em>
        publishes, puts all of Europe on a map, lists every country, and then lets you put
        yourself next to it. Nothing here is estimated on top of what those sources publish.
      </p>
    </div>
  </section>

  <section class="block" aria-labelledby="what-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">What is here</p>
        <h2 id="what-title">Two questions so far, answered for every country</h2>
        <p>
          Each one is a map, a sortable table of every country, and a comparison with whatever
          you enter about yourself. More are coming; these two are finished.
        </p>
      </header>

      <div class="bento" data-reveal>
        <a class="tile" href="/leaving-home/">
          <div>
            <b>{age(h.eu.total)}</b>
            <p>
              The age by which half of young Europeans no longer live with their parents.
              {h.countries} countries, {h.year}, from the EU Labour Force Survey.
            </p>
          </div>
          <span class="arr">Leaving home <span aria-hidden="true">→</span></span>
        </a>

        <a class="tile" href="/wealth/">
          <div>
            <b>{euro(euroArea.median, { compact: true })}</b>
            <p>
              What the middle household in the euro area is worth, {formatPeriod(euroArea.period)}.
              Across {wealth.countries.length} countries the median runs from {
                euro(poorest, { compact: true })
              } to {euro(richest, { compact: true })}.
            </p>
          </div>
          <span class="arr">Household wealth <span aria-hidden="true">→</span></span>
        </a>

        <a class="tile dark" href="/method/">
          <div>
            <h3>How these numbers are checked</h3>
            <p>
              Which dataset each figure comes from, what it does and does not say, and the gate
              every number passes before it appears here.
            </p>
          </div>
          <span class="arr">The method <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="honest-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">What this is not</p>
        <h2 id="honest-title">An average is a bad answer to a personal question</h2>
      </header>

      <div class="prose" data-reveal>
        <p>
          That is the point of the site, and also its limit. Where a source publishes the whole
          distribution, a page will tell you your exact position in it. Where a source publishes
          one figure per country — which is most of the time — a page tells you which side of
          that figure you are on, and says so plainly instead of dressing it up as a percentile.
        </p>
        <p>
          The difference matters enough that each page carries it in its own words. The wealth
          pages cannot give you a percentile because the ECB publishes the average of each
          group and not where the groups begin. The leaving-home page cannot either, because
          Eurostat publishes a midpoint and not a distribution. Saying so is cheaper than being
          wrong.
        </p>
        <p class="note">
          Looking for the older Dutch reaction-time, typing and memory tests? They are still here,
          at <a href="/nl/">humanaverage.com/nl</a>. Those deliberately show no percentile either:
          no representative dataset exists for them, and inventing one is the one thing this site
          will not do.
        </p>
      </div>
    </div>
  </section>
</BaseV2>

<style>
  .tile h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
  }

  .tile .arr {
    font-weight: 600;
  }

  .prose .note {
    margin-top: 1.6em;
    font-size: 0.92rem;
  }
</style>
