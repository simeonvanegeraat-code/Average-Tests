---
import BaseV2 from '../../layouts/BaseV2.astro';
import Related from '../../components/Related.astro';
import StageMap from '../../components/StageMap.astro';
import CompareForm from '../../components/CompareForm.astro';
import RankTable from '../../components/RankTable.astro';
import geo from '../../../data/geo/europe.json';
import index from '../../../data/pension-age/index.json';
import exitIndex from '../../../data/exit-age/index.json';
import metric from '../../lib/metrics/pension-age.js';
import { citation, exitAge, exitAgeRows } from '../../lib/exit-age.js';
import {
  count,
  currentCountries,
  formatAmount,
  formatValue,
  genderGap,
  headline,
  ranked,
  staleCountries,
  withArticle,
} from '../../lib/metric.js';

/**
 * Metriekpagina: pension-age. De enige pagina met twee uitgevers.
 *
 * Boven: Eurostat `lfso_23pens03`, de leeftijd waarop mensen een ouderdomspensioen
 * zijn gaan ontvangen. Onder: de OECD, de leeftijd waarop mensen de arbeidsmarkt
 * verlaten. Twee vragen, geen twee metingen van hetzelfde — de pagina zegt dat
 * uitdrukkelijk en trekt ze niet van elkaar af. Zie src/lib/exit-age.js.
 *
 * Wat hier het meest misleidend kan zijn, staat daarom in de kop: dit is niet de
 * wettelijke pensioenleeftijd. Wie op "retirement age" zoekt bedoelt vaak dat, en
 * vindt overal dat. Deze pagina gaat over wat er feitelijk gebeurd is.
 */

const h = headline(index);
const gender = genderGap(index);
const stale = staleCountries(index);
const order = ranked(index);
const current = currentCountries(index);
const exit = exitAge(exitIndex);
const exitRows = exitAgeRows(exitIndex);
const cite = citation(exitIndex);

const fmt = (value: number | null) => formatValue(value, metric);
const amt = (value: number, options = {}) => formatAmount(value, metric, options);

const euValue = h.eu ? fmt(h.eu.total) : fmt(order[Math.floor(order.length / 2)].total);
const names = (list: any[]) => list.map((country) => country.name).join(', ');
const early5 = names(order.slice(0, 5));
const late5 = names(order.slice(-5).reverse());
const bigOnes = current
  .filter((country) => ['DE', 'FR', 'IT', 'ES', 'PL', 'NL'].includes(country.code))
  .sort((a, b) => a.total - b.total)
  .map((country) => `${country.name} ${fmt(country.total)}`)
  .join(', ');

/** De landen waar vrouwen later begonnen dan mannen: de helft van het verhaal dat niemand verwacht. */
const womenLater = gender ? [...gender.exceptions].sort((a, b) => a.men - a.women - (b.men - b.women)) : [];

const clientJson = JSON.stringify({
  decimals: metric.decimals,
  unit: metric.unit,
  unitOne: metric.unitOne,
  countries: current.map(({ code, name, total }) => ({ code, name, total })),
}).replace(/</g, '\\u003c');

const title = `Average Retirement Age by Country in Europe (${h.year})`;
const description = `Across the European Union people started drawing an old-age pension at ${euValue} — ${fmt(h.earliest.total)} in ${withArticle(h.earliest.name)} and ${fmt(h.latest.total)} in ${withArticle(h.latest.name)}. Not the statutory age, but the age it actually happened, for all ${h.countries} countries.`;
---

<BaseV2 title={title} description={description} canonical="/pension-age/" hue={metric.hue}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">Eurostat · {h.countries} countries · {h.year}</p>
      <h1 data-reveal>On average a pension starts {amt(h.gap)} earlier in {withArticle(h.earliest.name)} than in {withArticle(h.latest.name)}.</h1>
      <span class="giant num">{euValue}</span>
      <p class="unit mono">age an old-age pension began · <b>European Union</b> · {h.year}</p>
      <p class="lead">In {withArticle(h.earliest.name)} people started drawing one at {fmt(h.earliest.total)}, in {withArticle(h.latest.name)} at {fmt(h.latest.total)} — {amt(h.gap)} apart. The European figure sits at {euValue}.</p>
      <div class="hero-cta">
        <a class="btn" href="#compare">Compare yourself <span class="arr" aria-hidden="true">→</span></a>
        <span class="hint">Nothing you type leaves your browser.</span>
      </div>
      <p class="hero-note"><b>This is not the statutory pension age.</b> Eurostat asked people who receive an old-age pension how old they were when it started, so the figure looks back over decades of different rules rather than describing today's. A country that has raised its legal age will show that only as those cohorts retire.</p>
    </div>
  </section>

  <StageMap geo={geo} index={index} metric={metric} eyebrow="The map" title="Where pensions start earliest" lede="Tap a country to see its figures." />

  <section class="block" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">Your turn</p>
        <h2 id="compare-title">When did yours start?</h2>
        <p>Enter the age your old-age pension began, or the age you expect it to.</p>
      </header>
      <div data-reveal>
        <CompareForm index={index} metric={metric} />
        <output class="result" data-metric-result role="status" hidden></output>
        <div class="limits">
          <b>Why your own answer is hard to place</b>
          <p>The country figures describe people who are already drawing a pension — mostly people who retired years ago, under rules that have since changed. If you have not retired yet, you are comparing your expectation against their history, and in most countries the legal age has gone up since.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="table-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">Every country</p>
        <h2 id="table-title">All {index.countries.length} countries, earliest to latest</h2>
        <p>Sort by any column. Men and women are published separately and both are here.</p>
      </header>
      <div data-reveal><RankTable index={index} metric={metric} /></div>
    </div>
  </section>

  <section class="block" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">What the numbers say</p>
        <h2 id="facts-title">The gap between men and women runs both ways</h2>
      </header>
      <div data-reveal>
        <div class="bento">
          <div class="tile s4">
            <div>
              <b>{amt(h.gap)}</b>
              <p>
                separates the earliest country from the latest — {withArticle(h.earliest.name)} at{' '}
                {fmt(h.earliest.total)} and {withArticle(h.latest.name)} at {fmt(h.latest.total)}. The five
                earliest are {early5}; the five latest are {late5}.
              </p>
            </div>
            <span class="meta mono">{h.year}</span>
          </div>
          <div class="tile dark">
            <div>
              <h3>One year, no trend</h3>
              <p>
                This comes from a one-off module of the Labour Force Survey, run in {h.year}. There is no
                earlier year to compare with, so this page shows none.
              </p>
            </div>
            <span class="meta mono">why this page has no history</span>
          </div>
        </div>

        {
          gender && (
            <div class="bento" style="margin-top:14px">
              <div class="tile">
                <div>
                  <b>{gender.womenLower}</b>
                  <p>
                    of {gender.of} countries show women starting a pension earlier than men, widest in{' '}
                    {withArticle(gender.widest.name)} at {amt(gender.widestGap)}. Averaged over all{' '}
                    {gender.of} the difference comes to {amt(gender.mean)}, because the rest run the other
                    way.
                  </p>
                </div>
                <span class="meta mono">{h.year}</span>
              </div>

              <div class="tile s4 dark">
                <div>
                  <h3>
                    {womenLater.length === 0
                      ? 'No country reverses the pattern'
                      : `In ${count(womenLater.length, 'country', 'countries')} it is the other way round`}
                  </h3>
                  <p>
                    {womenLater.length === 0
                      ? 'Women started earlier than men everywhere in the dataset.'
                      : `Women started later than men in ${names(womenLater.slice(0, 4))}${womenLater.length > 4 ? ` and ${count(womenLater.length - 4, 'other')}` : ''}. ` +
                        'A lower statutory age for women, where it exists or existed, is only part of what this figure measures: it also depends on who worked long enough to draw a pension at all, and on who retired before they had to.'}
                  </p>
                </div>
                <span class="meta mono">the half nobody expects</span>
              </div>
            </div>
          )
        }

        <div class="prose">
          <p>
            The large economies sit close together in the middle: {bigOnes}. The spread is at the edges —
            early in the south-east and in Austria, late in the Nordics and {withArticle(h.latest.name)}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="exit-age" aria-labelledby="exit-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">OECD · {exit.of} countries · {exit.from}–{exit.until}</p>
        <h2 id="exit-title">A second number: when work actually stops</h2>
        <p>
          The OECD measures something else — the age at which people leave the labour market — for{' '}
          {exit.of} countries, {exit.beyond.length} of them outside Europe, every year since {exit.from}.
        </p>
      </header>

      <div data-reveal>
        <div class="bento">
          {exit.eu && (
            <div class="tile s4">
              <div>
                <b>{fmt(exit.eu.men)} / {fmt(exit.eu.women)}</b>
                <p>
                  men and women in the European Union, in {exit.eu.year}. It fell for a generation and has
                  been climbing since: {fmt(exit.eu.low.start)} in {exit.eu.low.from}, down to{' '}
                  {fmt(exit.eu.low.lowValue)} in {exit.eu.low.low}, back to {fmt(exit.eu.low.now)} now.
                </p>
              </div>
              <span class="meta mono">effective exit age</span>
            </div>
          )}
          <div class="tile dark">
            <div>
              <h3>No total, by the publisher's choice</h3>
              <p>
                The OECD publishes this figure for men and for women and never for both together. The
                difference averages {amt(exit.meanGap)} and reaches {amt(exit.widest.gap)} in{' '}
                {withArticle(exit.widest.name)}, so averaging the two would invent a number nobody
                published. This page keeps them apart.
              </p>
            </div>
            <span class="meta mono">why there is no single figure</span>
          </div>
        </div>

        <div class="bento" style="margin-top:14px">
          <div class="tile">
            <div>
              <b>{exit.full.risen} of {exit.full.of}</b>
              <p>
                countries with a full {exit.from}–{exit.until} series are above their own lowest point, by{' '}
                {amt(exit.full.meanRise)} on average. The low came in the {exit.full.peak[0]} for{' '}
                {exit.full.peak[1]} of them.
              </p>
            </div>
            <span class="meta mono">{exit.from}–{exit.until}</span>
          </div>
          <div class="tile s4">
            <div>
              <b>{amt(exit.full.climbs[0].low.risen)}</b>
              <p>
                added in {withArticle(exit.full.climbs[0].name)} since {exit.full.climbs[0].low.low}, the
                steepest climb in the set — followed by {exit.full.climbs
                  .slice(1)
                  .map((country: any) => `${country.name} (${formatAmount(country.low.risen, metric, { sign: true })} since ${country.low.low})`)
                  .join(', ')}.
              </p>
            </div>
            <span class="meta mono">men, since their own low</span>
          </div>
        </div>

        <div class="limits" style="margin-top:22px">
          <b>These two numbers cannot be subtracted</b>
          <p>
            The figure at the top of this page and the figure here answer different questions and are built
            differently. Eurostat asked today's pensioners when their pension started, so it reflects
            decisions taken over decades. The OECD derives its figure from how many people of each age are
            in work this year, which is why it can reach back to {exit.from} — and why it is a model of the
            current labour market, not a record of what anyone did. Both are on this page because people
            mean both when they say "retirement age"; neither is the other minus a few years.
          </p>
        </div>

        <div class="tablewrap" tabindex="0" role="region" aria-label="Effective labour market exit age by country">
          <table>
            <caption class="vh">Effective labour market exit age, men and women, latest year per country</caption>
            <thead>
              <tr>
                <th scope="col">Country</th>
                <th scope="col" class="n">Men</th>
                <th scope="col" class="n">Women</th>
                <th scope="col" class="n">Gap</th>
                <th scope="col" class="n">Year</th>
              </tr>
            </thead>
            <tbody>
              {exitRows.map((row: any) => (
                <tr>
                  <th scope="row">{row.name}</th>
                  <td class="n strong">{fmt(row.men)}</td>
                  <td class="n">{fmt(row.women)}</td>
                  <td class="n">{formatAmount(row.gap, metric, { sign: true })}</td>
                  <td class="n">{row.year}</td>
                </tr>
              ))}
              {exitIndex.aggregates.map((row: any) => (
                <tr class="emphasis">
                  <th scope="row">{row.name}</th>
                  <td class="n strong">{fmt(row.men)}</td>
                  <td class="n">{fmt(row.women)}</td>
                  <td class="n">{formatAmount(row.gap, metric, { sign: true })}</td>
                  <td class="n">{row.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="table-note">
          Each country carries its own latest year in which both men and women are published.
          {exit.stale.length > 0 && ` ${exit.stale.map((country: any) => `${country.name} (${country.year})`).join(', ')} stopped earlier.`}
        </p>
      </div>
    </div>
  </section>

  <Related metric="pension-age" />

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap method-grid">
      <header class="sec-head" data-reveal style="margin: 0">
        <p class="eyebrow mono">Method</p>
        <h2 id="method-title">How this is measured</h2>
        <p>Two publishers, two questions. Nothing here is estimated on top of what they publish.</p>
      </header>
      <div data-reveal>
        <dl>
          <div><dt>What the figure at the top is</dt><dd>The average age at which a person started receiving an old-age pension, from a one-off module of the EU Labour Force Survey run in {h.year}. It is reported by the people drawing the pension, which is why it describes the past rather than current law. Eurostat also publishes a median; this page uses the mean.</dd></div>
          <div><dt>What it is not</dt><dd>Not the statutory or legal pension age, not the earliest age at which a pension can be claimed, and not the age at which people stop working — that last one is the OECD figure further up this page. It is also not a distribution: one number per country, so there is no percentile to be had, only which side of the average you fall on.</dd></div>
          <div><dt>What the OECD figure is</dt><dd>The effective labour market exit age, from the OECD's {exitIndex.source.name} database. The OECD derives it from the share of each age group that is in work, so it describes this year's labour market rather than individual histories, and it exists for men and for women only — never for both together.</dd></div>
          <div>
            <dt>Coverage</dt>
            <dd>
              {h.countries} countries have a pension-start figure for {h.year}.
              {stale.length > 0 && (<> {stale.slice(0, 6).map((country: any) => `${country.name} (${country.year})`).join(', ')} are shown at their most recent year.</>)}
              {' '}The OECD series covers {exit.of} countries, {exit.beyond.length} of them outside Europe —
              {' '}{names(exit.beyond.slice(0, 4))} among them — and is the only figure on this site that
              reaches past Europe.
            </dd>
          </div>
          <div>
            <dt>Series breaks</dt>
            <dd>
              Eurostat flags none here, because a single year cannot break. The OECD flags none either:
              every observation it publishes for this measure carries the status "normal value", which is
              what lets this page talk about {exit.from} and {exit.until} in one sentence. The gate in{' '}
              <code>scripts/validate-oecd.mjs</code> fails if that ever changes.
            </dd>
          </div>
        </dl>

        <ul class="source-list">
          <li><strong>Dataset</strong> Eurostat <code>{index.source.dataset}</code>, {index.source.label}</li>
          <li><strong>Last updated by Eurostat</strong> {index.source.eurostatUpdated.slice(0, 10)}</li>
          <li><strong>Retrieved</strong> {index.source.fetchedOn.slice(0, 10)}</li>
          <li><strong>DOI</strong><a href={`https://doi.org/${index.source.doi}`} data-method-link>{index.source.doi}</a></li>
          {index.source.metadata && (<li><strong>Eurostat metadata</strong><a href={index.source.metadata} data-method-link>explanatory texts</a></li>)}
          <li><strong>Second dataset</strong> OECD <code>{exitIndex.source.dataset}</code>, measure <code>{exitIndex.source.measure}</code> — {exitIndex.source.label}</li>
          <li><strong>OECD series</strong> {exit.from} to {exit.until}, retrieved {exitIndex.source.fetchedOn.slice(0, 10)}</li>
          <li>
            <strong>OECD citation</strong>
            <span>{cite.before}<a href={cite.url} data-method-link>OECD Data Explorer</a>{cite.after}</span>
          </li>
        </ul>

        <p class="source-note">
          Licences: Eurostat data may be reused, including commercially, with attribution. The OECD terms
          allow the same — "even for commercial use" — on condition that the citation above is given; that
          is why it is printed here and not only in our notes.
          {cite.terms && (<> <a href={cite.terms} data-method-link>The OECD terms are here</a>.</>)}
          {' '}How we handle data is on <a href="/method/">the method page</a>.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="metric-data" set:html={clientJson} />

  <script>
    import { readProfile, mergeProfile } from '../../lib/profile.js';
    import { formatAmount, formatValue, withArticle } from '../../lib/metric.js';
    import { track, EVENTS } from '../../lib/analytics.js';

    /** De persoonlijke laag. De zinnen horen bij deze metriek en staan daarom hier. */
    const holder = document.getElementById('metric-data');
    const result = document.querySelector<HTMLElement>('[data-metric-result]');
    const KEY = 'pension-age';

    if (holder && result) {
      const data = JSON.parse(holder.textContent ?? '{}');
      const cfg = { decimals: data.decimals, unit: data.unit, unitOne: data.unitOne };
      const send = (name: string, detail: object) => document.dispatchEvent(new CustomEvent(name, { detail }));

      function render(code: string, own: number) {
        const home = data.countries.find((country: any) => country.code === code);
        const later = data.countries.filter((country: any) => own > country.total).length;
        const of = data.countries.length;
        const lines = [];
        if (home) {
          const diff = own - home.total;
          lines.push(
            Math.abs(diff) < 0.05
              ? `${own} is exactly the average age in ${withArticle(home.name)}.`
              : `${own} is ${formatAmount(Math.abs(diff), cfg)} ${diff > 0 ? 'later' : 'earlier'} than the average in ${withArticle(home.name)} (${formatValue(home.total, cfg)}).`,
          );
        }
        lines.push(
          later === of
            ? `That is later than the average in every one of the ${of} countries here.`
            : later === 0
              ? `That is earlier than the average in all ${of} countries here.`
              : `It is later than the average in ${later} of ${of} countries, and earlier in ${of - later}.`,
        );
        result.textContent = lines.join(' ');
        result.hidden = false;
      }

      document.addEventListener('ha:country', (event) => {
        const { code, source } = (event as CustomEvent<any>).detail ?? {};
        if (!code || source === 'restore') return;
        mergeProfile({ country: code });
      });

      document.addEventListener('ha:submit', (event) => {
        const { code, age, source } = (event as CustomEvent<any>).detail ?? {};
        if (!code || !Number.isFinite(age)) return;
        render(code, age);
        if (source === 'restore') return;
        mergeProfile({ country: code, [KEY]: age });
        track(EVENTS.valueSubmitted, { metric: KEY, country: code });
      });

      function restore() {
        const saved = readProfile();
        const code = typeof saved.country === 'string' ? saved.country : null;
        if (!code) return;
        send('ha:country', { code, source: 'restore' });
        const own = Number(saved[KEY]);
        if (Number.isFinite(own)) send('ha:submit', { code, age: own, source: 'restore' });
      }

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', restore, { once: true });
      else restore();
    }

    for (const link of document.querySelectorAll('[data-method-link]')) {
      link.addEventListener('click', () => track(EVENTS.methodologyOpened, { from: KEY }));
    }
  </script>

  <style>
    .tile h3 { margin: 0 0 10px; font-size: 1.15rem; }
    .tile .meta { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
    .prose { margin-top: 28px; max-width: 70ch; color: var(--text-2); }
    .prose p { margin: 0; line-height: 1.7; }
    .result { display: block; margin-top: 18px; padding: 18px 22px; border-radius: var(--radius-md); border: 1px solid var(--line-strong); font-size: 1.04rem; line-height: 1.6; }
    #exit-age .tablewrap { margin-top: 22px; }
    .table-note { margin-top: 12px; max-width: 70ch; color: var(--text-2); font-size: 0.88rem; line-height: 1.6; }
    .source-list { list-style: none; padding: 0; }
    .source-list li { padding: 0.35rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
    .source-list li:last-child { border-bottom: 0; }
    .source-list strong { display: inline-block; min-width: 12rem; color: var(--text-2); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .source-list li span { word-break: break-word; }
    @media (max-width: 540px) { .source-list strong { display: block; min-width: 0; } }
  </style>
</BaseV2>
