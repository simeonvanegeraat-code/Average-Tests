---
import { localeOf, linkTo } from '../../lib/locales.js';
import BaseV2 from '../../layouts/BaseV2.astro';
import rawIndex from '../../../data/wealth/index.json';
import { withArticle } from '../../lib/wealth.js';
import { STAGES } from '../../lib/hue.js';
import { wealthCountryPage } from '../../lib/pages/wealth-country.js';

/**
 * De Engelse landpagina's onder /wealth/ — 21 stuks uit één bestand.
 *
 * Eigen bestand per taal sinds 3 november 2026; `src/pages/nl/wealth/[country].astro` is
 * de Nederlandse. Het rekenwerk staat in `src/lib/pages/wealth-country.js` en
 * `src/lib/wealth-standout.js`, en de woorden van de data (groepen, eigendomsvorm,
 * balansposten, leeftijdsbanden) in `src/locales/<taal>/wealth.json`.
 *
 * VERBOUWD OP 18 NOVEMBER 2026
 *
 * De 21 pagina's deelden per paar 64% van hun tekst, en de zin die ze uit elkaar moest
 * houden gaf in alle 21 landen hetzelfde antwoord. Nu begint elke pagina met de drie maten
 * waarop dát land het dichtst bij een uiterste van de 21 staat, met de landen ernaast bij
 * naam. Wat op alle 21 hetzelfde was — waarom gemiddelde en mediaan verschillen, de
 * algemene methodetekst — staat één keer op /wealth/ en /method/. Het plan en de lat:
 * research/wealth-country-pages-plan.md; de poort: scripts/check-country-pages.mjs.
 *
 * De Nederlandse versie is nog de oude vorm. Die volgt pas als Simeon drie Engelse
 * landen heeft gelezen (stap 3 van het plan).
 */
export async function getStaticPaths() {
  const files = import.meta.glob('../../../data/wealth/*.json', { eager: true });

  /**
   * De rúwe index, niet de gelokaliseerde. getStaticPaths draait voordat de pagina
   * bestaat en kent Astro.url dus niet, en heeft hier ook geen taal nodig: de paden komen
   * uit `area`, een landcode, en die is in elke taal hetzelfde.
   */
  return rawIndex.countries.map((summary) => {
    const key = Object.keys(files).find((p) => p.endsWith(`/${summary.area.toLowerCase()}.json`));
    const country = files[key].default ?? files[key];
    return { params: { country: summary.area.toLowerCase() }, props: { country } };
  });
}

const lang = localeOf(Astro.url.pathname);
const {
  picks,
  measures,
  measureCount,
  shareOf,
  euroAreaGap,
  near,
  line,
  countryCount,
  ageIndex,
  c,
  byCode,
  owners,
  renters,
  housingGap,
  yearChange,
  ranked,
  position,
  euroArea,
  middle,
  bottomQuintile,
  negativeBottom,
  negativeBottomCount,
  survey,
  curve,
  sharePeak,
  steeperThan,
  money,
  times,
  pct,
  period,
  fieldwork,
} = wealthCountryPage(Astro.props.country, lang);

const where = withArticle(c.name);
const Where = withArticle(c.name, { capitalise: true });

/** "second", niet "2nd": het staat midden in een zin. Verder dan tiende komt een keuze niet. */
const WORD = ['', 'first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh', 'eighth', 'ninth', 'tenth'];
const nth = (n: number) => WORD[n] ?? `${n}th`;

const rank =
  position === 1
    ? 'highest'
    : position === ranked.length
      ? 'lowest'
      : `${nth(position)} highest`;

/** Een procent met een echt minteken, zoals money() dat bij bedragen doet. */
const percent = (v: number) => `${v < 0 ? '−' : ''}${pct(Math.abs(v) * 100)}%`;

/** Een waarde in de eenheid van haar maat. */
const show = (unit: string, value: number) => (unit === 'times' ? times(value) : percent(value));

/** "2023-Q1" wordt "Q1 2023", zoals `period` elders op de pagina. */
const quarter = (p: string) => (p ? p.split('-').reverse().join(' ') : '');
const fromLabel = quarter(line.window.from);
const toLabel = quarter(line.window.to);

/**
 * De woorden per maat. Het getal zelf komt uit de lib; hier staat alleen hoe je het zegt.
 * `name` is de korte vorm voor de description, `say` de zin die het getal draagt, en
 * `high`/`low` het bijvoeglijk naamwoord aan de kant van het uiterste waar het land staat.
 */
const WORDS: Record<string, { name: string; tag?: string; noun: string; high: string; low: string; say: (v: number) => string }> = {
  meanToMedian: {
    name: 'the gap between average and median',
    tag: 'average against median',
    noun: 'gap',
    high: 'widest',
    low: 'narrowest',
    say: (v) => `The average household in ${where} is worth ${times(v)} the median household`,
  },
  ownersToRenters: {
    name: 'the gap between owners and renters',
    tag: 'owners against renters',
    noun: 'gap',
    high: 'widest',
    low: 'narrowest',
    say: (v) => `A household in ${where} that owns its home holds ${times(v)} what a renting household holds`,
  },
  topTenShare: {
    name: 'the share of the richest tenth',
    tag: 'the richest tenth',
    noun: 'share',
    high: 'largest',
    low: 'smallest',
    say: (v) => `The richest 10% of households in ${where} hold ${show('percent', v)} of all household wealth`,
  },
  bottomHalfShare: {
    name: 'the share of the poorer half',
    tag: 'the poorer half',
    noun: 'share',
    high: 'largest',
    low: 'smallest',
    say: (v) => `The poorer half of households in ${where} hold ${show('percent', v)} of all household wealth`,
  },
  housingShare: {
    name: 'how much sits in housing',
    tag: 'housing',
    noun: 'share',
    high: 'largest',
    low: 'smallest',
    say: (v) => `For a household in the middle fifth of ${where}, housing is ${show('percent', v)} of everything it owns`,
  },
  depositShare: {
    name: 'how much sits in savings',
    tag: 'savings',
    noun: 'share',
    high: 'largest',
    low: 'smallest',
    say: (v) => `For a household in the middle fifth of ${where}, cash and deposits are ${show('percent', v)} of everything it owns`,
  },
  debtToAssets: {
    name: 'debt',
    noun: 'debt load',
    high: 'heaviest',
    low: 'lightest',
    say: (v) => `A household in the middle fifth of ${where} owes ${show('percent', v)} of the value of what it owns`,
  },
  growth: {
    name: `how wealth moved since ${fromLabel}`,
    tag: 'growth',
    noun: 'growth',
    high: 'strongest',
    low: 'weakest',
    say: (v) =>
      `From ${fromLabel} to ${toLabel} the wealth of the median household in ${where} ${v >= 0 ? 'rose' : 'fell'} by ${pct(Math.abs(v) * 100)}% in nominal euros`,
  },
};

const rankPhrase = (p: any, of = 'countries') => {
  const w = WORDS[p.key];
  return `the ${p.place === 1 ? '' : `${nth(p.place)} `}${w[p.end as 'high' | 'low']} ${w.noun} of the ${p.of} ${of}`;
};

/** Alleen als die maat niet al bovenaan staat, anders zegt de pagina hetzelfde twee keer. */
const owning = picks.some((p: any) => p.key === 'ownersToRenters')
  ? null
  : measures.find((m: any) => m.key === 'ownersToRenters');

const title = `Household Wealth in ${Where} vs ${countryCount - 1} Countries`;
const tags = picks.map((p: any) => WORDS[p.key].tag ?? WORDS[p.key].name);
const description =
  `The median household in ${where} is worth ${money(c.median)}, ${rank} of ${ranked.length}. ` +
  `Where it stands apart: ${tags.slice(0, -1).join(', ')} and ${tags.at(-1)}.`;

/** De lijn: twee reeksen op 100 in het eerste kwartaal, in één vak. */
const W = 640;
const H = 200;
const PAD = { l: 8, r: 64, t: 14, b: 26 };
const allValues = [...line.country, ...line.euroArea].map((p: any) => p.value);
const lo = Math.min(...allValues, 100) - 2;
const hi = Math.max(...allValues, 100) + 2;
const xs = (i: number, n: number) => PAD.l + (i / Math.max(n - 1, 1)) * (W - PAD.l - PAD.r);
const ys = (v: number) => PAD.t + ((hi - v) / (hi - lo || 1)) * (H - PAD.t - PAD.b);
const pathOf = (series: any[]) =>
  series.map((p, i) => `${i ? 'L' : 'M'}${xs(i, series.length).toFixed(1)} ${ys(p.value).toFixed(1)}`).join('');
const countryEnd = line.country.at(-1);
const euroEnd = line.euroArea.at(-1);
const signed = (v: number) => `${v >= 0 ? '+' : '−'}${pct(Math.abs(v) * 100)}%`;
---

<BaseV2
  title={title}
  description={description}
  canonical={`/wealth/${c.area.toLowerCase()}/`}
  hue={STAGES.money}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <p class="eyebrow mono" data-reveal>
        {c.name} · European Central Bank · {period}
      </p>
      <h1 id="hero-title" data-reveal>
        The median household in {where} is worth
        <span class="giant num">{money(c.median, { compact: true })}</span>
      </h1>
      <p class="unit mono" data-reveal>
        Exactly <b>{money(c.median)}</b> · {period}{yearChange != null && <>{' '}· {yearChange >= 0 ? '▲' : '▼'} {pct(Math.abs(yearChange))}% over the year</>}
      </p>
      <p class="lead" data-reveal>
        The {rank} of the {ranked.length} countries the ECB measures{near.above && near.below && <>, between{' '}<a href={linkTo(near.above.path, lang)}>{withArticle(near.above.name)}</a>{' '}and{' '}<a href={linkTo(near.below.path, lang)}>{withArticle(near.below.name)}</a></>}{!near.above && near.below && <>, ahead of{' '}<a href={linkTo(near.below.path, lang)}>{withArticle(near.below.name)}</a></>}{near.above && !near.below && <>, behind{' '}<a href={linkTo(near.above.path, lang)}>{withArticle(near.above.name)}</a></>}.
      </p>
      <div class="hero-cta" data-reveal>
        <a class="btn" href={linkTo('/wealth/#compare', lang)} data-compare-country={c.area}>
          Compare your own household
          <span class="arr"><svg class="arr-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg></span>
        </a>
        <span class="hint">Opens on {where}. Nothing is sent anywhere.</span>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="apart-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">Against the other {countryCount - 1}</p>
        <h2 id="apart-title">What sets {where} apart</h2>
        <p>The three of {measureCount} ratios on which {where} sits furthest from the middle of the {countryCount}.</p>
      </header>

      <ol class="apart" data-reveal>
        {picks.map((p: any) => (
          <li>
            <p class="k mono">{WORDS[p.key].name}</p>
            <p>{WORDS[p.key].say(p.value)}: {rankPhrase(p)}{p.beyond.length > 0 && p.beyond.length <= 2 && <>, after {p.beyond.map((x: any, i: number) => <>{i > 0 && (i === p.beyond.length - 1 ? ' and ' : ', ')}<a href={linkTo(x.path, lang)}>{withArticle(x.name)}</a> ({show(p.unit, x.value)})</>)}</>}{p.beyond.length > 2 && <>; <a href={linkTo(p.beyond[0].path, lang)}>{withArticle(p.beyond[0].name)}</a> ({show(p.unit, p.beyond[0].value)}) is at the far end</>}.{p.next.length > 0 && <>{' '}{p.place === 1 ? 'Next come' : 'Then comes'}{' '}{p.next.map((x: any, i: number) => <>{i > 0 && (i === p.next.length - 1 ? ' and ' : ', ')}<a href={linkTo(x.path, lang)}>{withArticle(x.name)}</a> ({show(p.unit, x.value)})</>)}.</>}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {
    line.country.length > 1 && countryEnd && euroEnd && (
      <section class="block" aria-labelledby="line-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">{fromLabel} to {toLabel}</p>
            <h2 id="line-title">
              {line.growth !== null && line.growth >= 0 ? 'How far the middle has risen' : 'How far the middle has fallen'}
            </h2>
            <p>{Where} against the euro area, both at 100 in {fromLabel}. Nominal euros.</p>
          </header>

          <figure class="wline" data-reveal>
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="wline-cap">
              <line x1={PAD.l} x2={W - PAD.r} y1={ys(100)} y2={ys(100)} class="base" />
              <path d={pathOf(line.euroArea)} class="ea" />
              <path d={pathOf(line.country)} class="own" />
              <text x={W - PAD.r + 6} y={ys(countryEnd.value) + 4} class="own-t">{c.area} {Math.round(countryEnd.value)}</text>
              <text x={W - PAD.r + 6} y={ys(euroEnd.value) + 4} class="ea-t">EA {Math.round(euroEnd.value)}</text>
              <text x={PAD.l} y={H - 6} class="ax">{fromLabel}</text>
              <text x={W - PAD.r} y={H - 6} class="ax" text-anchor="end">{toLabel}</text>
            </svg>
            <figcaption id="wline-cap">
              {line.growth !== null && <>{Where}: {signed(line.growth)}.{' '}</>}{line.euroAreaGrowth !== null && <>Euro area: {signed(line.euroAreaGrowth)}.</>}
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }

  {
    housingGap && (
      <section class="block" aria-labelledby="housing-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">Owning versus renting</p>
            <h2 id="housing-title">Whether a household owns its home</h2>
          </header>

          <div data-reveal>
            <div class="split">
              <div class="split-side own">
                <span class="k">{owners.label}</span>
                <b>{money(owners.netWealth)}</b>
              </div>
              <div class="split-vs">{times(housingGap)}</div>
              <div class="split-side rent">
                <span class="k">{renters.label}</span>
                <b>{money(renters.netWealth)}</b>
              </div>
            </div>

            <div class="prose">
              <p>
                A homeowning household in {where} holds {times(housingGap)} what a renting household holds{owning && <> — {rankPhrase(owning, 'countries that publish this split')}</>}.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="block" aria-labelledby="dist-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">The whole distribution</p>
        <h2 id="dist-title">What each fifth owns</h2>
        <p>Group averages, not boundaries, and each group's share of the total.</p>
      </header>

      <div class="tablewrap" tabindex="0" role="region" aria-label="Net wealth by group" data-reveal>
        <table>
          <caption class="vh">
            Average net wealth per household by group, and its share of all wealth, {Where}, {period}
          </caption>
          <thead>
            <tr>
              <th scope="col">Group</th>
              <th scope="col" class="n">Average net wealth</th>
              <th scope="col" class="n">Share of all wealth</th>
            </tr>
          </thead>
          <tbody>
            {c.groups.filter((g: any) => g.kind === 'quintile').map((g: any) => (
              <tr>
                <th scope="row">{g.label}</th>
                <td class:list={['n', g.netWealth < 0 && 'negative']}>{money(g.netWealth)}</td>
                <td class:list={['n', g.netWealth < 0 && 'negative']}>{shareOf(g) === null ? '—' : percent(shareOf(g))}</td>
              </tr>
            ))}
            {byCode.D10 && (
              <tr class="emphasis">
                <th scope="row">{byCode.D10.label}</th>
                <td class="n">{money(byCode.D10.netWealth)}</td>
                <td class="n">{shareOf(byCode.D10) === null ? '—' : percent(shareOf(byCode.D10))}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      {
        negativeBottom && (
          <div class="limits" data-reveal>
            <b>The bottom fifth of households in {where} has negative net wealth</b>
            <p>
              On average {money(bottomQuintile.netWealth)}: they owe more than they own. The same is
              true in {negativeBottomCount} of the {ranked.length} countries here.
            </p>
          </div>
        )
      }
    </div>
  </section>

  {
    middle.length > 0 && (
      <section class="block" aria-labelledby="comp-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">Where the middle keeps its money</p>
            <h2 id="comp-title">The balance sheet of a middle household</h2>
            <p>The middle fifth of {where}, per household.</p>
          </header>

          <div class="tablewrap" tabindex="0" role="region" aria-label="Balance sheet of the middle fifth" data-reveal>
            <table>
              <caption class="vh">Middle 20% of households, average per household</caption>
              <tbody>
                {middle.map((p: any) => (
                  <tr class={p.side === 'liability' ? 'liability' : undefined}>
                    <th scope="row">{p.label}</th>
                    <td class:list={['n', p.value < 0 && 'negative']}>{money(p.value)}</td>
                  </tr>
                ))}
                <tr class="emphasis">
                  <th scope="row">Net wealth</th>
                  <td class="n">{money(byCode.Q3?.netWealth)}</td>
                </tr>
              </tbody>
            </table>
          </div>

          {euroAreaGap && (
            <div class="prose" data-reveal>
              <p>
                Set against the middle household of the euro area as a whole, the largest difference is
                {' '}<strong>{euroAreaGap.label.toLowerCase()}</strong>: {pct(euroAreaGap.here * 100)}% of
                everything a middle household owns in {where}, against {pct(euroAreaGap.there * 100)}%
                across the euro area.
              </p>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    survey && curve && (
      <section class="block" aria-labelledby="age-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">Age</p>
            <h2 id="age-title">
              {curve.flat
                ? `In ${where}, age barely moves this`
                : `In ${where}, wealth peaks at ${curve.peak.label}`}
            </h2>
            <p>From the ECB's household survey: a separate measurement, not comparable with the figures above.</p>
          </header>

          <div data-reveal>
            <ul class="agebars">
              {curve.bands.map((band: any) => (
                <li class:list={[{ 'is-peak': band.code === survey.peak }]}>
                  <span class="k mono">{band.code}</span>
                  <span class="bar">
                    <i style={`width:${((band.median / curve.peak.median) * 100).toFixed(1)}%`} />
                  </span>
                  <span class="v num">{money(band.median, { compact: true })}</span>
                  <span class="avg mono">avg {money(band.mean, { compact: true })}</span>
                </li>
              ))}
            </ul>

            <div class="prose">
              <p>
                {curve.flat ? (
                  <>
                    The middle household in {where} is worth {money(curve.youngest.median)} in the
                    {' '}{curve.youngest.label} group and {money(curve.peak.median)} at its highest,
                    {' '}{curve.peak.label} — only {times(curve.climb)} as much. That is one of the
                    flattest curves in this survey, and it means a national figure here describes a
                    30-year-old almost as well as a 60-year-old. In most countries it does not.
                  </>
                ) : (
                  <>
                    The middle household climbs from {money(curve.youngest.median)} in the
                    {' '}{curve.youngest.label} group to {money(curve.peak.median)} at
                    {' '}{curve.peak.label}, {times(curve.climb)} as much — steeper than
                    {steeperThan === ageIndex.countries.length - 1
                      ? ' in every other country here'
                      : ` in ${steeperThan} of the other ${ageIndex.countries.length - 1}`}.
                    {curve.fall === null ? (
                      <> It never turns back down: the oldest group is the highest one.</>
                    ) : (
                      <> After the peak it falls back to {money(curve.oldest.median)} by
                      {' '}{curve.oldest.label}.</>
                    )}
                  </>
                )}
              </p>
              <p>
                {sharePeak === 1
                  ? `${Where} is the only country in this survey whose highest group is ${curve.peak.label}.`
                  : `${sharePeak} of the ${ageIndex.countries.length} countries here peak at ${curve.peak.label}.`}
                {' '}<a href={linkTo('/wealth/by-age/', lang)}>All {ageIndex.countries.length} countries side by side</a>.
              </p>
            </div>

            <p class="panel-source panel-source--light" style="margin-top:22px">
              Fieldwork in {where}: {fieldwork}.
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section class="block" aria-labelledby="near-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">Next to {where}</p>
        <h2 id="near-title">The countries either side of it</h2>
      </header>

      <div class="nearlist" data-reveal>
        {near.above && (
          <a class="nearitem" href={linkTo(near.above.path, lang)}>
            <span class="k mono">One place higher</span>
            <p>The median household in {withArticle(near.above.name)} is worth {money(near.above.median)}.</p>
            <span class="arr">{withArticle(near.above.name, { capitalise: true })} in full{' '}<span aria-hidden="true">→</span></span>
          </a>
        )}
        {near.below && (
          <a class="nearitem" href={linkTo(near.below.path, lang)}>
            <span class="k mono">One place lower</span>
            <p>The median household in {withArticle(near.below.name)} is worth {money(near.below.median)}.</p>
            <span class="arr">{withArticle(near.below.name, { capitalise: true })} in full{' '}<span aria-hidden="true">→</span></span>
          </a>
        )}
        <a class="nearitem" href={linkTo('/wealth/', lang)}>
          <span class="k mono">All {ranked.length}</span>
          <p>The euro area: {money(euroArea?.median)}.</p>
          <span class="arr">European wealth{' '}<span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap">
      <h2 id="method-title" class="vh">Source</h2>
      <p class="panel-source panel-source--light" data-reveal>
        <a href="https://data.ecb.europa.eu/" data-method-link>ECB</a> Distributional Wealth Accounts,
        {' '}{period} for {where}; over time {fromLabel} to {toLabel}, the quarters all
        {' '}{countryCount} countries have. Estimates.{survey && <> Age: <a href={ageIndex.source.url} data-method-link>{ageIndex.source.survey}</a>, wave {ageIndex.source.wave}.</>}
        {' '}<a href={linkTo('/method/', lang)} data-method-link>Method</a>.
      </p>
    </div>
  </section>

  <script>
    import { track, EVENTS } from '../../lib/analytics.js';
    import { mergeProfile } from '../../lib/profile.js';

    for (const link of document.querySelectorAll('[data-method-link]')) {
      link.addEventListener('click', () => track(EVENTS.methodologyOpened, { from: 'wealth-country' }));
    }

    /**
     * De knop neemt het land mee: het formulier op /wealth/ leest `country` uit het profiel
     * en staat dan al op dit land. Zonder script werkt de link gewoon, alleen zonder land.
     */
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-compare-country]')) {
      link.addEventListener('click', () => {
        const code = link.dataset.compareCountry;
        if (code) mergeProfile({ country: code });
      });
    }
  </script>

