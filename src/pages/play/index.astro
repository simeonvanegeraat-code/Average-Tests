---
import Base from '../../layouts/Base.astro';
import questionData from '../../../data/questions.json';

/**
 * Modus 1 van vier: het dagelijkse raadspel.
 *
 * De hele vragenset gaat mee in de pagina en de dag van vandaag wordt in de browser
 * bepaald. Geen server, geen backend, en iedereen krijgt dezelfde vijf vragen — wat
 * nodig is om een gedeelde score iets te laten betekenen.
 */

const title = 'HumanAverage — The Daily Guessing Game';
const description =
  'Five questions a day about how people actually are. Guess the number, see how close ' +
  'you got, and share your score. Every answer comes from measured survey data.';
---

<Base title={title} description={description} canonical="/play/">
  <Fragment slot="head">
    <script type="application/json" id="question-data" set:html={JSON.stringify(questionData)} is:inline />
  </Fragment>

  <section class="game-shell">
    <div class="container narrow">
      <header class="game-head">
        <p class="eyebrow">Daily puzzle <span id="puzzle-number"></span></p>
        <h1>How well do you know people?</h1>
        <p class="game-sub">
          Five questions. Guess the number, and get points for how close you land.
        </p>
        <ol class="pips" id="pips" aria-label="Progress"></ol>
      </header>

      <div class="card-panel" id="stage">
        <p class="question-prompt" id="prompt">Loading…</p>
        <p class="question-hint" id="hint"></p>

        <div class="guess-area" id="guess-area">
          <output class="guess-value" id="guess-value">50</output>
          <input type="range" id="guess-slider" class="guess-slider"
                 aria-label="Your guess" />
          <div class="range-ends"><span id="range-min"></span><span id="range-max"></span></div>
          <button class="button" type="button" id="lock-in">Lock in my guess</button>
        </div>

        <div class="reveal" id="reveal" hidden>
          <div class="reveal-grid">
            <div><span class="percentile-eyebrow">You said</span><strong id="reveal-guess"></strong></div>
            <div><span class="percentile-eyebrow">The answer</span><strong id="reveal-answer"></strong></div>
            <div><span class="percentile-eyebrow">Points</span><strong id="reveal-score"></strong></div>
          </div>
          <p class="reveal-note" id="reveal-note"></p>
          <button class="button" type="button" id="next-question">Next question</button>
        </div>
      </div>

      <div class="card-panel summary" id="summary" hidden>
        <p class="percentile-eyebrow">Final score</p>
        <p class="final-score" id="final-score"></p>
        <p class="final-blocks" id="final-blocks"></p>
        <p id="final-line"></p>

        <div class="result-grid" id="streak-row"></div>

        <div class="button-row">
          <button class="button" type="button" id="share">Share my score</button>
          <a class="button secondary" href="/height/">Find your own percentile →</a>
        </div>
        <p class="question-hint" id="tomorrow"></p>
      </div>

      <p class="source-line">
        Every answer is calculated from measured survey data, not estimated.
        <a href="/method/">How we know these numbers</a>.
      </p>
    </div>
  </section>

  <style>
    .game-shell { padding: 40px 0 64px; background: var(--canvas); min-height: 70vh; }
    .game-head { text-align: center; margin-bottom: 24px; }
    .game-head h1 {
      margin: 6px 0 8px; font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.9rem, 5vw, 2.8rem); font-weight: 500; letter-spacing: -0.03em;
    }
    .game-sub { margin: 0 0 18px; color: var(--ink-soft); }

    .pips { display: flex; justify-content: center; gap: 8px; margin: 0; padding: 0; list-style: none; }
    .pips li {
      width: 34px; height: 6px; border-radius: 999px; background: var(--line);
    }
    .pips li[data-state="done"] { background: var(--data); }
    .pips li[data-state="current"] { background: var(--accent); }

    .card-panel {
      padding: 28px; border: 1px solid var(--line); border-radius: var(--radius);
      background: var(--paper); box-shadow: var(--shadow);
    }
    .question-prompt {
      margin: 0 0 6px; font-size: clamp(1.15rem, 3.2vw, 1.45rem);
      font-weight: 640; line-height: 1.35;
    }
    .question-hint { margin: 0; color: var(--ink-soft); font-size: 0.9rem; }

    .guess-area { margin-top: 26px; }
    .guess-value {
      display: block; text-align: center; color: var(--data);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.6rem, 9vw, 3.6rem); font-weight: 500; line-height: 1;
    }
    .guess-slider { width: 100%; margin: 14px 0 4px; accent-color: var(--data); }
    .range-ends {
      display: flex; justify-content: space-between;
      color: var(--ink-soft); font-size: 0.85rem; margin-bottom: 20px;
    }
    .guess-area .button, .reveal .button { width: 100%; }

    .reveal { margin-top: 24px; }
    .reveal-grid {
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px; margin-bottom: 16px;
    }
    .reveal-grid strong {
      display: block; margin-top: 2px; font-size: 1.35rem;
      font-variant-numeric: tabular-nums;
    }
    .reveal-note {
      margin: 0 0 18px; padding: 14px 16px; border-radius: var(--radius-sm);
      background: var(--data-soft); font-size: 0.95rem;
    }
    .percentile-eyebrow {
      display: block; color: var(--ink-soft); font-size: 0.7rem;
      font-weight: 780; letter-spacing: 0.08em; text-transform: uppercase;
    }

    .summary { margin-top: 18px; text-align: center; }
    .final-score {
      margin: 4px 0 10px; color: var(--data);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.8rem, 10vw, 4rem); font-weight: 500; line-height: 1;
    }
    .final-blocks { margin: 0 0 14px; font-size: 1.9rem; letter-spacing: 0.12em; }
    .summary .result-grid { margin: 18px 0; }

    .source-line {
      margin-top: 22px; text-align: center;
      color: var(--ink-soft); font-size: 0.88rem;
    }

    @media (max-width: 520px) {
      .reveal-grid { grid-template-columns: 1fr; gap: 8px; }
      .reveal-grid > div { display: flex; justify-content: space-between; align-items: baseline; }
      .reveal-grid strong { margin-top: 0; }
    }
  </style>

  <script>
    import {
      puzzleNumber, questionsForPuzzle, scoreFor, closeness, tierFor,
      shareText, saveProgress, readProgress, QUESTIONS_PER_DAY,
    } from '../../lib/daily-game.js';
    import { track, EVENTS } from '../../lib/analytics.js';

    const el = (id) => document.getElementById(id);
    const data = JSON.parse(el('question-data').textContent);

    const number = puzzleNumber();
    const questions = questionsForPuzzle(data.questions, number);
    const results = [];
    let index = 0;

    el('puzzle-number').textContent = `#${number}`;

    const UNIT_SUFFIX = { percent: '%', inches: '"', pounds: ' lb' };
    const format = (value, unit) =>
      unit === 'inches'
        ? `${Math.floor(value / 12)}'${Math.round(value % 12)}"`
        : `${Number.isInteger(value) ? value : value.toFixed(1)}${UNIT_SUFFIX[unit] ?? ''}`;

    function drawPips() {
      el('pips').innerHTML = questions
        .map((_, i) => {
          const state = i < index ? 'done' : i === index ? 'current' : 'todo';
          return `<li data-state="${state}"></li>`;
        })
        .join('');
    }

    function showQuestion() {
      const q = questions[index];
      el('prompt').textContent = q.prompt;
      el('hint').textContent = q.hint ?? '';

      const slider = el('guess-slider');
      slider.min = String(q.range.min);
      slider.max = String(q.range.max);
      slider.step = String(q.range.step);
      slider.value = String((q.range.min + q.range.max) / 2);

      el('range-min').textContent = format(q.range.min, q.unit);
      el('range-max').textContent = format(q.range.max, q.unit);
      el('guess-value').textContent = format(Number(slider.value), q.unit);

      el('guess-area').hidden = false;
      el('reveal').hidden = true;
      drawPips();
    }

    el('guess-slider').addEventListener('input', (event) => {
      el('guess-value').textContent = format(Number(event.target.value), questions[index].unit);
    });

    el('lock-in').addEventListener('click', () => {
      const q = questions[index];
      const guess = Number(el('guess-slider').value);
      const score = scoreFor(q, guess);
      const near = closeness(q, guess);
      results.push({ guess, score, closeness: near });

      el('reveal-guess').textContent = format(guess, q.unit);
      el('reveal-answer').textContent = format(q.answer, q.unit);
      el('reveal-score').textContent = `${score} / 1000`;
      el('reveal-note').textContent =
        `${tierFor(near).label.replace(/^./, (c) => c.toUpperCase())}. ${q.note ?? ''}`;

      el('guess-area').hidden = true;
      el('reveal').hidden = false;
      el('next-question').textContent =
        index === questions.length - 1 ? 'See my score' : 'Next question';

      track(EVENTS.valueSubmitted, { metric: 'daily-game', question: q.id });
    });

    el('next-question').addEventListener('click', () => {
      index++;
      if (index < questions.length) {
        showQuestion();
        return;
      }
      finish();
    });

    function finish() {
      const total = results.reduce((sum, r) => sum + r.score, 0);
      const max = results.length * 1000;

      el('stage').hidden = true;
      el('summary').hidden = false;
      el('final-score').textContent = `${total.toLocaleString('en-US')}`;
      el('final-blocks').textContent = results.map((r) => tierFor(r.closeness).block).join('');
      el('final-line').textContent =
        `out of ${max.toLocaleString('en-US')} — ${Math.round((total / max) * 100)}% of a perfect round.`;

      const progress = saveProgress(number, total);
      el('streak-row').innerHTML = progress
        ? `<div class="stat-chip"><strong>${progress.streak}</strong> <span>day streak</span></div>
           <div class="stat-chip"><strong>${progress.best.toLocaleString('en-US')}</strong> <span>your best</span></div>
           <div class="stat-chip"><strong>${progress.played}</strong> <span>rounds played</span></div>`
        : '';

      el('tomorrow').textContent = 'A new set of five arrives tomorrow.';
      drawPips();
    }

    el('share').addEventListener('click', async () => {
      const total = results.reduce((sum, r) => sum + r.score, 0);
      const text = shareText(number, results, total);
      try {
        if (navigator.share) await navigator.share({ text });
        else await navigator.clipboard.writeText(text);
        el('share').textContent = navigator.share ? 'Shared' : 'Copied to clipboard';
        track(EVENTS.resultShared, { metric: 'daily-game' });
      } catch {
        window.prompt('Copy your score:', text);
      }
    });

    // Wie vandaag al speelde krijgt dat te zien, maar mag gewoon opnieuw.
    const previous = readProgress();
    if (previous.lastPuzzle === number) {
      el('hint').textContent = `You already played today — best so far: ${previous.best.toLocaleString('en-US')}.`;
    }

    showQuestion();
  </script>
</Base>
