---
import { ui } from '../../lib/ui.js';
import { localeOf, linkTo } from '../../lib/locales.js';
import BaseV2 from '../../layouts/BaseV2.astro';
import Related from '../../components/Related.astro';
import StageMap from '../../components/StageMap.astro';
import CompareForm from '../../components/CompareForm.astro';
import RankTable from '../../components/RankTable.astro';
import MetricPersonal from '../../components/MetricPersonal.astro';
import geo from '../../../data/geo/europe.json';
import { withArticle } from '../../lib/metric.js';
import { healthyYearsPage } from '../../lib/pages/healthy-years.js';

/**
 * De Engelse /healthy-years/.
 *
 * Eigen bestand per taal sinds 3 november 2026; `src/pages/nl/healthy-years/index.astro`
 * is de Nederlandse. Het rekenwerk staat in `src/lib/pages/healthy-years.js`.
 */
const lang = localeOf(Astro.url.pathname);
/** De sjabloontekst die elke metriekpagina deelt. Zie src/lib/ui.js. */
const shared = ui(lang).metricPage;
const { index, metric, h, gender, movement, stale, euValue, bigOnes, fmt, amt, clientJson } =
  healthyYearsPage(lang);

const title = `Healthy Life Years by Country in Europe (${h.year})`;
const description = `A newborn in ${withArticle(h.latest.name)} can expect ${fmt(h.latest.total)} years without a limiting health problem; in ${withArticle(h.earliest.name)} it is ${fmt(h.earliest.total)}. Compare all ${h.countries} countries on a map and see how many you have left.`;
---

<BaseV2 title={title} description={description} canonical="/healthy-years/" hue={metric.hue}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">Eurostat · {h.countries} countries · {h.year}</p>
      <h1 data-reveal>Living longer and living well are not the same map.</h1>
      <span class="giant num">{euValue}</span>
      <p class="unit mono">healthy years at birth · <b>{shared.europeanUnion}</b> · {h.year}</p>
      <p class="lead">A newborn in {withArticle(h.latest.name)} can expect {fmt(h.latest.total)} years free of any limiting health problem. In {withArticle(h.earliest.name)} it is {fmt(h.earliest.total)}. That is {amt(h.gap)} of difference inside one continent.</p>
      <div class="hero-cta">
        <a class="btn" href="#compare">{shared.compareYourself}{' '}<span class="arr" aria-hidden="true">→</span></a>
        <span class="hint">{shared.nothingLeavesBrowser}</span>
      </div>
      <p class="hero-note">This is not life expectancy. It counts only the years expected without a long-standing limitation in daily activity, so a country can add years of life without adding healthy ones. Several of the richest countries here sit below several of the poorest.</p>
    </div>
  </section>

  <StageMap geo={geo} index={index} metric={metric} eyebrow={shared.theMap} title="Where healthy years are most and fewest" lede={shared.tapACountry} />

  <section class="block" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.yourTurn}</p>
        <h2 id="compare-title">How many healthy years are left?</h2>
        <p>Enter your age and we will place it against what each country expects at birth.</p>
      </header>
      <div data-reveal>
        <CompareForm index={index} metric={metric} />
        <MetricPersonal metric="healthy-years" />
        <div class="limits">
          <b>This is an expectation at birth, not a forecast for you</b>
          <p>The figure describes a newborn today under current conditions. Subtracting your age from it is arithmetic, not a prediction: your own health, your country at the time you were born, and everything since all sit outside what this number knows.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="table-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.everyCountry}</p>
        <h2 id="table-title">All {index.countries.length} countries, fewest to most</h2>
        <p>Sort by any column. The gap column is men minus women, so a positive number means men expect more healthy years.</p>
      </header>
      <div data-reveal><RankTable index={index} metric={metric} /></div>
    </div>
  </section>

  <section class="block" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.whatTheNumbersSay}</p>
        <h2 id="facts-title">The gap between the sexes almost closes here</h2>
      </header>
      <div data-reveal>
          <div class="bento">
            <div class="tile s4 dark">
              <div>
                <h3>Women live longer. They do not clearly live healthier.</h3>
                <p>
                  Across life expectancy women lead everywhere in Europe, often by years. Here the
                  picture breaks down: men expect more healthy years in {gender?.womenLower} of {gender?.of} countries,
                  and the average difference across all of them is under a year.
                </p>
              </div>
              <span class="meta mono">{h.year}</span>
            </div>
            <div class="tile">
              <div>
                <b>{gender ? amt(Math.abs(gender.widestGap)) : ""}</b>
                <p>the widest gap between men and women, in {gender ? withArticle(gender.widest.name) : ""}.</p>
              </div>
              <span class="meta mono">largest difference</span>
            </div>
          </div>
        <div class="prose"><p>Wealth does not order this list the way it orders life expectancy. The big economies land at {bigOnes} — several of them below countries with a fraction of their income per head. Whatever buys healthy years, it is not only money, and a figure that tracked only national income would not look like this.</p></div>
      </div>
    </div>
  </section>

  <Related metric="healthy-years" />

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap method-grid">
      <header class="sec-head" data-reveal style="margin: 0">
        <p class="eyebrow mono">{shared.method}</p>
        <h2 id="method-title">{shared.howMeasured}</h2>
        <p>{shared.publishedByEurostat}</p>
      </header>
      <div data-reveal>
        <dl>
          <div><dt>{shared.whatTheFigureIs}</dt><dd>The number of years a newborn can expect to live without a long-standing limitation in daily activity, combining life tables with the self-reported limitation question in EU-SILC.</dd></div>
          <div><dt>{shared.whatItIsNot}</dt><dd>It is not life expectancy, not a measure of illness, and not a distribution. One number per country means no percentile is possible — only which side of it you fall on.</dd></div>
          <div>
            <dt>{shared.coverage}</dt>
            <dd>
              {h.countries} countries have a figure for {h.year}.
              {stale.length > 0 && (<> {stale.slice(0, 6).map((country: any) => `${country.name} (${country.year})`).join(', ')} stopped reporting earlier and are shown at their most recent year, hatched on the map and labelled in the table.</>)}
              {' '}{shared.notInDataset}
            </dd>
          </div>
          <div>
            <dt>{shared.seriesBreaks}</dt>
            <dd>
              {movement
                ? `None inside the window used here, ${movement.since} to ${movement.until}.`
                : `Eurostat flags a break in ${index.lastBreak}, in or just before the latest year, so no comparison with the past is shown on this page. A figure that looks like a trend across a break is worse than no trend at all.`}
            </dd>
          </div>
        </dl>

        <ul class="source-list">
          <li><strong>{shared.dataset}</strong>{' '}{shared.eurostat}{' '}<code>{index.source.dataset}</code>, {index.source.label}</li>
          <li><strong>{shared.series}</strong> {index.years[0]} to {index.years[index.years.length - 1]}</li>
          <li><strong>{shared.lastUpdated}</strong> {index.source.eurostatUpdated.slice(0, 10)}</li>
          <li><strong>{shared.retrieved}</strong> {index.source.fetchedOn.slice(0, 10)}</li>
          <li><strong>{shared.doi}</strong><a href={`https://doi.org/${index.source.doi}`} data-method-link>{index.source.doi}</a></li>
          {index.source.metadata && (<li><strong>{shared.eurostatMetadata}</strong><a href={index.source.metadata} data-method-link>{shared.explanatoryTexts}</a></li>)}
        </ul>

        <p class="source-note">{' '}{shared.licence}{' '}<a href={linkTo('/method/', lang)}>{shared.theMethodPage}</a>.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="metric-data" set:html={clientJson} />

  <style>
    .tile h3 { margin: 0 0 10px; font-size: 1.15rem; }
    .tile .meta { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
    .prose { margin-top: 28px; max-width: 70ch; color: var(--text-2); }
    .prose p { margin: 0; line-height: 1.7; }
    .source-list { list-style: none; padding: 0; }
    .source-list li { padding: 0.35rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
    .source-list li:last-child { border-bottom: 0; }
    .source-list strong { display: inline-block; min-width: 12rem; color: var(--text-2); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    @media (max-width: 540px) { .source-list strong { display: block; min-width: 0; } }
  </style>
</BaseV2>
