---
import { ui } from '../../lib/ui.js';
import { localeOf, linkTo } from '../../lib/locales.js';
import BaseV2 from '../../layouts/BaseV2.astro';
import Related from '../../components/Related.astro';
import StageMap from '../../components/StageMap.astro';
import CompareForm from '../../components/CompareForm.astro';
import RankTable from '../../components/RankTable.astro';
import MetricPersonal from '../../components/MetricPersonal.astro';
import geo from '../../../data/geo/europe.json';
import { withArticle } from '../../lib/metric.js';
import { householdSizePage } from '../../lib/pages/household-size.js';

/**
 * De Engelse /household-size/.
 *
 * Sinds 3 november 2026 bestaat deze pagina per taal als eigen bestand;
 * `src/pages/nl/household-size/index.astro` is de Nederlandse. Het rekenwerk staat in
 * `src/lib/pages/household-size.js` en is dus niet dubbel — wat hier staat is hoe deze
 * taal het verwoordt.
 *
 * Kaart, tabel en formulier zijn gedeelde componenten, en het antwoordvak met zijn
 * bedrading zit in MetricPersonal. Geen cijfer staat hier met de hand ingetypt.
 */
const lang = localeOf(Astro.url.pathname);
/** De sjabloontekst die elke metriekpagina deelt. Zie src/lib/ui.js. */
const shared = ui(lang).metricPage;
const { index, metric, h, movement, stale, euValue, ratio, small5, large5, bigOnes, fmt, clientJson } =
  householdSizePage(lang);

const title = `Average Household Size by Country in Europe (${h.year})`;
const description = `The average European household holds ${euValue} people — ${fmt(h.earliest.total)} in ${withArticle(h.earliest.name)} and ${fmt(h.latest.total)} in ${withArticle(h.latest.name)}. Compare all ${h.countries} countries on a map and see where your own household sits.`;
---

<BaseV2 title={title} description={description} canonical="/household-size/" hue={metric.hue}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">Eurostat · {h.countries} countries · {h.year}</p>
      <h1 data-reveal>The largest households in Europe hold nearly twice as many people as the smallest.</h1>
      <span class="giant num">{euValue}</span>
      <p class="unit mono">people per household · <b>{shared.europeanUnion}</b> · {h.year}</p>
      <p class="lead">In {withArticle(h.earliest.name)} the average household is {fmt(h.earliest.total)} people. In {withArticle(h.latest.name)} it is {fmt(h.latest.total)}. Not a gap of a few percent — one is {ratio} times the other.</p>
      <div class="hero-cta">
        <a class="btn" href="#compare">{shared.compareYourself}{' '}<span class="arr" aria-hidden="true">→</span></a>
        <span class="hint">{shared.nothingLeavesBrowser}</span>
      </div>
      <p class="hero-note">An average household is not a family. It counts everyone living at one address, so a country full of people living alone scores low whether they are students, divorced or widowed. The figure says how many people share a roof, and nothing about who they are to each other.</p>
    </div>
  </section>

  <StageMap geo={geo} index={index} metric={metric} eyebrow={shared.theMap} title="Where households are largest" lede={shared.tapACountry} />

  <section class="block" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.yourTurn}</p>
        <h2 id="compare-title">How big is your household?</h2>
        <p>Count everyone who lives at your address, including yourself.</p>
      </header>
      <div data-reveal>
        <CompareForm index={index} metric={metric} />
        <MetricPersonal metric="household-size" />
        <div class="limits">
          <b>What a single household cannot tell you</b>
          <p>Your household is one address; the country figure is an average over millions. Being above or below it says nothing about whether your household is unusual — plenty of countries average two people while most households hold one or three, and almost none hold exactly two.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="table-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.everyCountry}</p>
        <h2 id="table-title">All {index.countries.length} countries, smallest to largest</h2>
        <p>Sort by any column. This dataset has no breakdown by sex, so those columns are empty.</p>
      </header>
      <div data-reveal><RankTable index={index} metric={metric} /></div>
    </div>
  </section>

  <section class="block" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{shared.whatTheNumbersSay}</p>
        <h2 id="facts-title">A line runs from the north-west to the south-east</h2>
      </header>
      <div data-reveal>
          <div class="bento">
            <div class="tile s4">
              <div>
                <b>{ratio}×</b>
                <p>
                  the difference between the largest and the smallest average household. The five
                  smallest are {small5}; the five largest are {large5}.
                </p>
              </div>
              <span class="meta mono">{h.year}</span>
            </div>
            <div class="tile dark">
              <div>
                <h3>No trend to show</h3>
                <p>
                  Eurostat flags a break in the series in {index.lastBreak}, the latest year itself, so there is
                  no window in which this figure can be compared with its own past.
                </p>
              </div>
              <span class="meta mono">why this page has no history</span>
            </div>
          </div>
        <div class="prose"><p>The pattern is geographic before it is anything else. Households shrink as you move north and west and grow as you move south and east, and the big economies sit close together in the middle: {bigOnes}. Whatever drives the difference, it is not simply wealth.</p></div>
      </div>
    </div>
  </section>

  <Related metric="household-size" />

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap method-grid">
      <header class="sec-head" data-reveal style="margin: 0">
        <p class="eyebrow mono">{shared.method}</p>
        <h2 id="method-title">{shared.howMeasured}</h2>
        <p>{shared.publishedByEurostat}</p>
      </header>
      <div data-reveal>
        <dl>
          <div><dt>{shared.whatTheFigureIs}</dt><dd>The average number of people living in a household, from EU-SILC, the European survey on income and living conditions. A household is everyone sharing an address and their living costs.</dd></div>
          <div><dt>{shared.whatItIsNot}</dt><dd>It is not a family size and not a count of children. It is also not a distribution: Eurostat publishes one number per country, so there is no percentile to be had, only which side of the average you fall on.</dd></div>
          <div>
            <dt>{shared.coverage}</dt>
            <dd>
              {h.countries} countries have a figure for {h.year}.
              {stale.length > 0 && (<> {stale.slice(0, 6).map((country: any) => `${country.name} (${country.year})`).join(', ')} stopped reporting earlier and are shown at their most recent year, hatched on the map and labelled in the table.</>)}
              {' '}{shared.notInDataset}
            </dd>
          </div>
          <div>
            <dt>{shared.seriesBreaks}</dt>
            <dd>
              {movement
                ? `None inside the window used here, ${movement.since} to ${movement.until}.`
                : `Eurostat flags a break in ${index.lastBreak}, in or just before the latest year, so no comparison with the past is shown on this page. A figure that looks like a trend across a break is worse than no trend at all.`}
            </dd>
          </div>
        </dl>

        <ul class="source-list">
          <li><strong>{shared.dataset}</strong>{' '}{shared.eurostat}{' '}<code>{index.source.dataset}</code>, {index.source.label}</li>
          <li><strong>{shared.series}</strong> {index.years[0]} to {index.years[index.years.length - 1]}</li>
          <li><strong>{shared.lastUpdated}</strong> {index.source.eurostatUpdated.slice(0, 10)}</li>
          <li><strong>{shared.retrieved}</strong> {index.source.fetchedOn.slice(0, 10)}</li>
          <li><strong>{shared.doi}</strong><a href={`https://doi.org/${index.source.doi}`} data-method-link>{index.source.doi}</a></li>
          {index.source.metadata && (<li><strong>{shared.eurostatMetadata}</strong><a href={index.source.metadata} data-method-link>{shared.explanatoryTexts}</a></li>)}
        </ul>

        <p class="source-note">{' '}{shared.licence}{' '}<a href={linkTo('/method/', lang)}>{shared.theMethodPage}</a>.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="metric-data" set:html={clientJson} />

  <style>
    .tile h3 { margin: 0 0 10px; font-size: 1.15rem; }
    .tile .meta { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
    .prose { margin-top: 28px; max-width: 70ch; color: var(--text-2); }
    .prose p { margin: 0; line-height: 1.7; }
    .source-list { list-style: none; padding: 0; }
    .source-list li { padding: 0.35rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
    .source-list li:last-child { border-bottom: 0; }
    .source-list strong { display: inline-block; min-width: 12rem; color: var(--text-2); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    @media (max-width: 540px) { .source-list strong { display: block; min-width: 0; } }
  </style>
</BaseV2>
