---
import { localePaths } from '../../../lib/locales.js';
import BaseV2 from '../../../layouts/BaseV2.astro';
import index from '../../../../data/wealth/index.json';
import ageIndex from '../../../../data/wealth-age/index.json';
import { euro, multiple, formatPeriod, percentChange, withArticle } from '../../../lib/wealth.js';
import { curveOf, fieldworkLabel } from '../../../lib/wealth-age.js';
import { STAGES } from '../../../lib/hue.js';

/**
 * Eén pagina per land.
 *
 * Deze pagina's zijn geen varianten van hetzelfde sjabloon met een ander cijfer:
 * landen verschillen werkelijk. Duitsland heeft een lagere mediaan dan Italië
 * ondanks een hoger inkomen, in Zuid-Europa zit het vermogen in stenen en in
 * Nederland in pensioen. De tekst hieronder leest die verschillen uit de data en
 * benoemt per land wat er opvalt.
 *
 * Omgezet naar de vormtaal van 2026. Dat was een restyle: elk cijfer en elke zin
 * komt nog uit dezelfde bron en dezelfde berekening als ervoor.
 */

export async function getStaticPaths() {
  const files = import.meta.glob('../../../../data/wealth/*.json', { eager: true });

  /**
   * Het kruisproduct van taal en land. De landenlus hieronder is ongewijzigd; er komt
   * alleen een taal om heen. Zolang Engels de enige taal is, is `lang` undefined en
   * blijven dit precies de 21 paden die er altijd stonden.
   */
  return localePaths().flatMap(({ params: { lang } }) =>
    index.countries.map((summary) => {
      const key = Object.keys(files).find((p) => p.endsWith(`/${summary.area.toLowerCase()}.json`));
      const country = files[key].default ?? files[key];
      return { params: { lang, country: summary.area.toLowerCase() }, props: { country } };
    }),
  );
}

const { country } = Astro.props;
const c = country;

const byCode = Object.fromEntries(c.groups.map((g) => [g.code, g]));
const status = Object.fromEntries(c.status.map((s) => [s.code, s]));
const owners = status.HSO;
const renters = status.HST;
const housingGap = owners && renters ? owners.netWealth / renters.netWealth : null;

const yearChange = c.medianYearAgo ? percentChange(c.medianYearAgo.value, c.median) : null;
const meanToMedian = c.mean ? c.mean / c.median : null;

// Rangorde binnen Europa, uit de index in plaats van met de hand.
const ranked = [...index.countries].sort((a, b) => b.median - a.median);
const position = ranked.findIndex((x) => x.area === c.area) + 1;
const euroArea = index.euroArea;

// Waar zit het vermogen van de middenmoot in? Dit verschilt sterk per land en is
// het punt waarop deze pagina's echt uiteenlopen.
const middle = c.composition?.Q3 ?? [];
const assets = middle.filter((p) => p.side === 'asset').sort((a, b) => b.value - a.value);
const biggest = assets[0];
const secondBiggest = assets[1];
const debts = middle.filter((p) => p.side === 'liability');
const totalDebt = debts.reduce((sum, d) => sum + Math.abs(d.value), 0);

const bottomQuintile = byCode.Q1;
const negativeBottom = bottomQuintile && bottomQuintile.netWealth < 0;

const where = withArticle(c.name);
const Where = withArticle(c.name, { capitalise: true });

/**
 * De leeftijdscurve van dit land, uit de ECB-enquête.
 *
 * Een tweede bron op dezelfde pagina, en dat vraagt om strengheid: de enquête telt
 * publieke en bedrijfspensioenen niet mee, dus haar middelpunt ligt op een ander
 * niveau dan het cijfer bovenaan deze pagina. Geen zin hieronder zet de twee naast
 * elkaar, en de sectie zegt zelf waar ze vandaan komt.
 *
 * Dit is ook wat deze landpagina's van elkaar onderscheidt: de piek ligt niet overal
 * bij dezelfde groep en de klim ernaartoe verschilt van 1,6x tot 31,6x.
 */
const survey = ageIndex.countries.find((a) => a.area === c.area) ?? null;
const curve = survey ? curveOf(survey) : null;
/** Hoeveel andere landen hun hoogtepunt bij dezelfde groep hebben. */
const sharePeak = survey ? ageIndex.countries.filter((a) => a.peak === survey.peak).length : 0;
const steeperThan = survey
  ? ageIndex.countries.filter((a) => Number.isFinite(a.climb) && a.climb < survey.climb).length
  : 0;

const rank =
  position === 1
    ? 'highest'
    : position === ranked.length
      ? 'lowest'
      : `${position}${position === 2 ? 'nd' : position === 3 ? 'rd' : 'th'}`;

const title = `Household Wealth in ${Where} — Where You Stand`;
const description =
  `The median household in ${where} is worth ${euro(c.median)}. See the full distribution, ` +
  `the gap between owning and renting, and where your own household would sit.`;
---

<BaseV2
  title={title}
  description={description}
  canonical={`/wealth/${c.area.toLowerCase()}/`}
  hue={STAGES.money}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <p class="eyebrow mono" data-reveal>
        {c.name} · European Central Bank · {formatPeriod(c.period)}
      </p>
      <h1 id="hero-title" data-reveal>
        The median household in {where} is worth
        <span class="giant num">{euro(c.median, { compact: true })}</span>
      </h1>
      <p class="unit mono" data-reveal>
        Exactly <b>{euro(c.median)}</b> · {formatPeriod(c.period)}
      </p>
      <p class="lead" data-reveal>
        That is the middle household — half of the country owns more, half owns less. It ranks
        {' '}{rank} of the {ranked.length} countries the European Central Bank measures.
      </p>
      <div class="hero-cta" data-reveal>
        <a class="btn" href="/wealth/#compare">
          Compare your own household
          <span class="arr"><svg class="arr-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg></span>
        </a>
        <span class="hint">Nothing is sent anywhere.</span>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="middle-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">The middle and the average</p>
        <h2 id="middle-title">Why the two figures differ</h2>
      </header>

      <div data-reveal>
        <div class="statrow">
          <div class="statblock">
            <span class="k">Median household</span>
            <b>{euro(c.median)}</b>
            {yearChange != null && (
              <span class="d">
                {yearChange >= 0 ? '▲' : '▼'} {Math.abs(yearChange).toFixed(1)}% over the year
              </span>
            )}
          </div>
          <div class="statblock">
            <span class="k">Average household</span>
            <b>{euro(c.mean)}</b>
            {meanToMedian && <span class="d">{multiple(meanToMedian)} the median</span>}
          </div>
        </div>

        <div class="prose">
          <p>
            The average is {meanToMedian ? multiple(meanToMedian) : ''} the median, and that gap is
            the whole story of wealth statistics. Averages are dragged upward by a small number of
            very large fortunes; the median describes the household in the middle. Whenever a
            headline quotes the average wealth of a country, it is describing almost nobody.
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    housingGap && (
      <section class="block" aria-labelledby="housing-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">Owning versus renting</p>
            <h2 id="housing-title">The sharpest divide in the data</h2>
            <p>
              In {where} this is wider than any difference between age groups or professions.
            </p>
          </header>

          <div data-reveal>
            <div class="split">
              <div class="split-side own">
                <span class="k">Homeowners</span>
                <b>{euro(owners.netWealth)}</b>
              </div>
              <div class="split-vs">{multiple(housingGap)}</div>
              <div class="split-side rent">
                <span class="k">Renters</span>
                <b>{euro(renters.netWealth)}</b>
              </div>
            </div>

            <div class="prose">
              <p>
                A homeowning household in {where} holds {multiple(housingGap)} what a renting
                household holds. Comparing yourself to the average household here, without knowing
                which side of that line you are on, tells you very little.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="block" aria-labelledby="dist-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">The whole distribution</p>
        <h2 id="dist-title">What each fifth owns</h2>
        <p>
          These are group averages, not the boundaries between groups — the ECB publishes the
          former and not the latter.
        </p>
      </header>

      <div class="tablewrap" tabindex="0" role="region" aria-label="Net wealth by group" data-reveal>
        <table>
          <caption class="vh">
            Average net wealth per household by group, {Where}, {formatPeriod(c.period)}
          </caption>
          <thead>
            <tr>
              <th scope="col">Group</th>
              <th scope="col" class="n">Average net wealth</th>
            </tr>
          </thead>
          <tbody>
            {c.groups.filter((g) => g.kind === 'quintile').map((g) => (
              <tr>
                <th scope="row">{g.label}</th>
                <td class:list={['n', g.netWealth < 0 && 'negative']}>{euro(g.netWealth)}</td>
              </tr>
            ))}
            {byCode.D10 && (
              <tr class="emphasis">
                <th scope="row">Top 10%</th>
                <td class="n">{euro(byCode.D10.netWealth)}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      {
        negativeBottom && (
          <div class="limits" data-reveal>
            <b>The bottom fifth of households in {where} has negative net wealth</b>
            <p>
              On average {euro(bottomQuintile.netWealth)}. They owe more than they own. This is not
              unusual across Europe and it is not a rounding artefact: mortgages, student loans and
              consumer credit can exceed everything a young household has managed to accumulate.
            </p>
          </div>
        )
      }
    </div>
  </section>

  {
    biggest && (
      <section class="block" aria-labelledby="comp-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">Where the middle keeps its money</p>
            <h2 id="comp-title">The balance sheet of a middle household</h2>
            <p>
              Everything below adds up to the net wealth of a household in the middle fifth of
              {' '}{where} — assets first, then what is owed against them.
            </p>
          </header>

          <div class="tablewrap" tabindex="0" role="region" aria-label="Balance sheet of the middle fifth" data-reveal>
            <table>
              <caption class="vh">Middle 20% of households, average per household</caption>
              <tbody>
                {middle.map((p) => (
                  <tr class={p.side === 'liability' ? 'liability' : undefined}>
                    <th scope="row">{p.label}</th>
                    <td class:list={['n', p.value < 0 && 'negative']}>{euro(p.value)}</td>
                  </tr>
                ))}
                <tr class="emphasis">
                  <th scope="row">Net wealth</th>
                  <td class="n">{euro(byCode.Q3?.netWealth)}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="prose" data-reveal>
            {/*
              Eén regel, geen regelafbrekingen tussen de stukken. Afgebroken stond er
              "…assets  at €308,192 , followed by…": de afbreking na </strong> werd een
              spatie bovenop de {' '}, en de afbreking vóór het tweede stuk werd een
              spatie vóór de komma. Op alle 21 landpagina's tegelijk.
            */}
            <p>
              For this household the largest holding is <strong>{biggest.label.toLowerCase()}</strong> at {euro(biggest.value)}{secondBiggest && <>, followed by {secondBiggest.label.toLowerCase()} at {euro(secondBiggest.value)}</>}.{totalDebt > 0 && <> Against that sits {euro(totalDebt)} of debt.</>}
            </p>
          </div>
        </div>
      </section>
    )
  }

  {
    survey && curve && (
      <section class="block" aria-labelledby="age-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">Age</p>
            <h2 id="age-title">
              {curve.flat
                ? `In ${where}, age barely moves this`
                : `In ${where}, wealth peaks at ${curve.peak.label}`}
            </h2>
            <p>
              Every figure in this section comes from the ECB's household survey, which is a
              different measure from the rest of this page: it leaves the value of public and
              occupational pension plans out. The two cannot be read against each other, so this
              section compares only within itself.
            </p>
          </header>

          <div data-reveal>
            <ul class="agebars">
              {curve.bands.map((band) => (
                <li class:list={[{ 'is-peak': band.code === survey.peak }]}>
                  <span class="k mono">{band.code}</span>
                  <span class="bar">
                    <i style={`width:${((band.median / curve.peak.median) * 100).toFixed(1)}%`} />
                  </span>
                  <span class="v num">{euro(band.median, { compact: true })}</span>
                  <span class="avg mono">avg {euro(band.mean, { compact: true })}</span>
                </li>
              ))}
            </ul>

            <div class="prose">
              <p>
                {curve.flat ? (
                  <>
                    The middle household in {where} is worth {euro(curve.youngest.median)} in the
                    {' '}{curve.youngest.label} group and {euro(curve.peak.median)} at its highest,
                    {' '}{curve.peak.label} — only {multiple(curve.climb)} as much. That is one of the
                    flattest curves in this survey, and it means a national figure here describes a
                    30-year-old almost as well as a 60-year-old. In most countries it does not.
                  </>
                ) : (
                  <>
                    The middle household climbs from {euro(curve.youngest.median)} in the
                    {' '}{curve.youngest.label} group to {euro(curve.peak.median)} at
                    {' '}{curve.peak.label}, {multiple(curve.climb)} as much — steeper than
                    {steeperThan === ageIndex.countries.length - 1
                      ? ' in every other country here'
                      : ` in ${steeperThan} of the other ${ageIndex.countries.length - 1}`}.
                    {curve.fall === null ? (
                      <> It never turns back down: the oldest group is the highest one.</>
                    ) : (
                      <> After the peak it falls back to {euro(curve.oldest.median)} by
                      {' '}{curve.oldest.label}.</>
                    )}
                  </>
                )}
              </p>
              <p>
                {sharePeak === 1
                  ? `${Where} is the only country in this survey whose highest group is ${curve.peak.label}.`
                  : `${sharePeak} of the ${ageIndex.countries.length} countries here peak at ${curve.peak.label}.`}
                {' '}The average for each group sits above the middle everywhere — in the
                {' '}{curve.youngest.label} group it is {multiple(curve.youngest.mean / curve.youngest.median)} the
                middle, because a small number of large fortunes pull it up.
                {' '}<a href="/wealth/by-age/">All {ageIndex.countries.length} countries side by side</a>.
              </p>
            </div>

            <p class="panel-source panel-source--light" style="margin-top:22px">
              {ageIndex.source.publisher}, {ageIndex.source.survey}, wave {ageIndex.source.wave}.
              Fieldwork in {where} ran {fieldworkLabel(survey.fieldwork)}. Age is that of the
              household's reference person.
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section class="block" id="method" aria-labelledby="method-title">
    <div class="wrap method-grid">
      <header class="sec-head" data-reveal style="margin: 0">
        <p class="eyebrow mono">Method</p>
        <h2 id="method-title">How this is measured</h2>
        <p>
          Every number on this page is published by the European Central Bank or counted from
          those published numbers.
        </p>
      </header>

      <div data-reveal>
        <dl>
          <div>
            <dt>What the figures are</dt>
            <dd>
              Net wealth is all assets minus all liabilities, per household. Group figures are
              averages within each group, not the boundaries between them. Every component on this
              page reconciles against the ECB's own published net wealth total.
            </dd>
          </div>
          {euroArea && (
            <div>
              <dt>For context</dt>
              <dd>
                The median household across the whole euro area is worth {euro(euroArea.median)}.
              </dd>
            </div>
          )}
        </dl>

        <ul class="source-list">
          <li>
            <strong>Source</strong>
            <span>
              <a href="https://data.ecb.europa.eu/" data-method-link>European Central Bank</a>,
              Distributional Wealth Accounts, {formatPeriod(c.period)}
            </span>
          </li>
          {survey && (
            <li>
              <strong>Age section only</strong>
              <span>
                <a href={ageIndex.source.url} data-method-link>{ageIndex.source.survey}</a>, wave
                {' '}{ageIndex.source.wave}, fieldwork {fieldworkLabel(survey.fieldwork)}. A separate
                measure: public and occupational pensions are not counted in it.
              </span>
            </li>
          )}
        </ul>
      </div>
    </div>
  </section>

  <script>
    import { track, EVENTS } from '../../../lib/analytics.js';

    for (const link of document.querySelectorAll('[data-method-link]')) {
      link.addEventListener('click', () => track(EVENTS.methodologyOpened, { from: 'wealth-country' }));
    }
  </script>
</BaseV2>
