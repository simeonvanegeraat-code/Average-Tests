---
import { localeOf, localePaths, linkTo } from '../../lib/locales.js';
import { ui, fill } from '../../lib/ui.js';
import { siteIdentity } from '../../lib/schema.js';
import BaseV2 from '../../layouts/BaseV2.astro';
import { frontDoor } from '../../lib/front-door.js';
import LifeFigure from '../../components/LifeFigure.astro';
import { notes, NOTES_LINK, noteDate } from '../../lib/notes.js';

/**
 * De voordeur.
 *
 * Herbouwd op 20 november 2026, na Simeons oordeel: "de indeling is niet logisch en ik
 * voel me niet geroepen om ergens op te klikken". De oude versie opende met een stelling
 * ("A European average describes almost nobody"), een bol die versiering was, en een
 * keuzelijst met een knop die op de plek zelf niets veranderde. Plan:
 * research/next-round-plan.md §2.
 *
 * Nu, van boven naar beneden:
 *
 *  1. Een vraag en de landkeuze, meteen. Wie een land kiest, ziet alles eronder omslaan.
 *  2. De levenslijn: vier leeftijden op één as, de EU en je eigen land. Stond al in de
 *     ontwerpnotitie van oktober en was nooit gebouwd.
 *  3. Elk cijfer per levensfase: zonder land de EU met het laagste en hoogste land, met
 *     een land de rang ("7th earliest of 31").
 *  4. Drie feiten: waar Europa het verst uiteenloopt, of waar je land opvalt.
 *  5. De artikelen, en wat deze site niet doet.
 *
 * Alle getallen en zinnen komen uit src/lib/front-door.js, op de server. Het script
 * onderaan verzet alleen tekst en posities die daar al klaarstaan.
 */

const lang = localeOf(Astro.url.pathname);
const NOTES = notes(lang);
const site = siteIdentity(lang, Astro.site);
const t = ui(lang).home;
const door = frontDoor(lang);
const { europe } = door;

const title = t.pageTitle;
const description = fill(t.pageDescription, { count: door.metricCount });
const clientJson = JSON.stringify({ europe, countries: door.countries }).replace(/</g, '\\u003c');

export function getStaticPaths() {
  return localePaths();
}
---

<BaseV2 title={title} description={description} canonical="/">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        ...site.website,
        description:
          'Country-by-country comparisons of how Europeans live, built from figures published by Eurostat, the OECD and the European Central Bank.',
        publisher: site.organisation,
      })}
    />
  </Fragment>

  <section class="hero door-hero">
    <div class="wrap">
      <p class="eyebrow mono">{fill(t.eyebrow, { count: door.metricCount })}</p>
      <h1 data-reveal>{t.newTitle}</h1>
      <p class="lead">{fill(t.newLead, { count: door.metricCount })}</p>

      <form class="pick" data-pick autocomplete="off" onsubmit="return false">
        <label class="pick-label" for="pick-country">{t.pickYourCountry}</label>
        <select id="pick-country" name="country" data-pick-country>
          <option value="">{t.europe}</option>
          {door.codes.map((c) => <option value={c.code}>{c.name}</option>)}
        </select>
        <p class="hint">{t.nothingLeaves}</p>
      </form>
    </div>
  </section>

  {/*
    De levensloop als vier figuurtjes (21 november 2026, Simeons idee): ze blijven staan,
    draaien rond, en wisselen van plek als een land de momenten in een andere volgorde
    leeft. Dat gebeurt echt: in 7 van de 28 landen eindigen de gezonde jaren vóór het
    pensioen begint, in 4 komt het eerste kind vóór de helft het huis uit is. De volgorde
    en de zin eronder komen uit src/lib/front-door.js.
  */}
  <section class="block" aria-labelledby="life-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.lifeEyebrow}</p>
        <h2 id="life-title" data-life-title data-europe={t.lifeTitleEurope} data-country={t.lifeTitleCountry}>{t.lifeTitleEurope}</h2>
        <p>{t.lifeLeadFigures}</p>
      </header>

      <figure class="figs" data-reveal>
        <ol class="figs-row" data-figs data-eu-word={t.euWord} data-eu-name={ui(lang).metricPage.europeanUnion}>
          {europe.order.map((key, n) => {
            const s = europe.stops.find((x) => x.key === key)!;
            return (
              <li class="fig-card hued" style={`--h:${s.hue}`} data-fig={s.key}>
                <a href={s.path}>
                  <span class="fig-n mono" data-fig-n>{n + 1}</span>
                  <span class="fig-turn"><LifeFigure stop={s.key as any} /></span>
                  <span class="fig-age num"><span data-fig-value>{s.value}</span>{' '}<small>{t.yearsUnit}</small></span>
                  <span class="fig-label">{s.label}</span>
                  <span class="fig-sub" data-fig-sub>{ui(lang).metricPage.europeanUnion}</span>
                  <span class="fig-diff" data-fig-diff></span>
                </a>
              </li>
            );
          })}
        </ol>
        <p class="figs-story" data-figs-story aria-live="polite">{europe.story}</p>
        <figcaption>{t.lifeNote}</figcaption>
      </figure>
    </div>
  </section>

  <section class="block" aria-labelledby="ranks-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.ranksEyebrow}</p>
        <h2 id="ranks-title" data-ranks-title data-europe={fill(t.ranksTitleEurope, { count: door.metricCount })} data-country={t.ranksTitleCountry}>
          {fill(t.ranksTitleEurope, { count: door.metricCount })}
        </h2>
        <p data-ranks-lead data-europe={t.ranksLeadEurope} data-country={t.ranksLeadCountry}>{t.ranksLeadEurope}</p>
      </header>

      <div class="phases" data-reveal>
        {europe.phases.map((phase) => (
          <div class="phase">
            <h3 class="mono">{phase.label}</h3>
            <ul>
              {phase.rows.map((row) => (
                <li>
                  <a class="rankrow hued" href={row.path} style={`--h:${row.hue}`} data-row={row.key}>
                    <span class="k">{row.label}</span>
                    <span class="v num"><span data-row-value>{row.value}</span> <small>{row.unit}</small></span>
                    <span class="rank-note" data-row-note>{row.note}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.factsEyebrow}</p>
        <h2 id="facts-title" data-facts-title data-europe={t.factsTitleEurope} data-country={t.factsTitleCountry}>{t.factsTitleEurope}</h2>
      </header>

      <div class="facts" data-reveal data-facts data-open-it={t.openIt}>
        {europe.facts.map((f) => (
          <a class="fact hued" href={f.path} style={`--h:${f.hue}`}>
            <span class="k mono">{f.label}</span>
            <p>{f.text}</p>
            <span class="arr">{t.openIt}{' '}<span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {
    NOTES.length > 0 && (
      <section class="block" aria-labelledby="latest-title">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="eyebrow mono">{t.latest}</p>
            <h2 id="latest-title">{t.whatWeWorkedOut}</h2>
            <p>{t.whereADatasetTurned}</p>
          </header>

          <div class="notelist" data-reveal>
            {NOTES.slice(0, 3).map((note) => (
              <a class="noteitem hued" href={linkTo(note.path, lang)} style={`--h:${note.hue}`}>
                <p class="eyebrow mono">{noteDate(note.published, { locale: lang })}</p>
                <h3>{note.title}</h3>
                <p>{note.teaser}</p>
                <span class="arr">{t.openIt}{' '}<span aria-hidden="true">→</span></span>
              </a>
            ))}
          </div>

          {NOTES.length > 3 && (
            <p class="more"><a href={linkTo(NOTES_LINK, lang)}>{fill(ui(lang).shell.allNotesCount, { count: NOTES.length })}{' '}<span aria-hidden="true">→</span></a></p>
          )}
        </div>
      </section>
    )
  }

  <section class="block" aria-labelledby="honest-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow mono">{t.whatThisIsNot}</p>
        <h2 id="honest-title">{t.anAverageIsA}</h2>
        <p>
          {t.honestLead}{' '}
          <a href={linkTo('/method/', lang)}>{t.methodPageLink}</a>{' '}{t.honestTail}
        </p>
      </header>
    </div>
  </section>

  <script type="application/json" id="door-data" set:html={clientJson} />

  <script>
    import { readProfile, mergeProfile } from '../../lib/profile.js';

    /**
     * De landkeuze. Alles wat hier verandert, staat al klaar in #door-data: per land de
     * tekst, de rang en de positie op de as. Dit script rekent niets uit.
     */
    const holder = document.getElementById('door-data');
    const select = document.querySelector<HTMLSelectElement>('[data-pick-country]');

    if (holder && select) {
      const data = JSON.parse(holder.textContent ?? '{}');
      const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel);
      const $$ = <T extends Element = HTMLElement>(sel: string) => [...document.querySelectorAll<T>(sel)];
      const fill = (text: string, values: Record<string, string | number>) =>
        text.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
      const titled = (el: HTMLElement | null, country: any, extra: Record<string, string | number> = {}) => {
        if (!el) return;
        el.textContent = country
          ? fill(el.dataset.country ?? '', { where: country.where, ...extra })
          : (el.dataset.europe ?? '');
        if (country) el.textContent = el.textContent.charAt(0).toUpperCase() + el.textContent.slice(1);
      };

      /** Het Europese beeld zoals de server het schreef, om naar terug te kunnen. */
      const europeRows = Object.fromEntries(
        $$('[data-row]').map((a) => [
          a.dataset.row,
          {
            value: a.querySelector('[data-row-value]')?.textContent ?? '',
            note: a.querySelector('[data-row-note]')?.textContent ?? '',
            href: a.getAttribute('href') ?? '',
          },
        ]),
      );
      const factsBox = $('[data-facts]');
      const europeFacts = factsBox?.innerHTML ?? '';

      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /** Eén draai om de as, de opmaak van het figuurtje blijft staan. */
      function spin(li: HTMLElement, delay: number, duration = 800) {
        li.querySelector('.lf')?.animate([{ transform: 'rotateY(0deg)' }, { transform: 'rotateY(360deg)' }], { duration, delay, easing: 'cubic-bezier(.3,.7,.2,1)' });
      }

      function show(code: string, animateIt = true) {
        const country = code ? data.countries[code] : null;

        // De figuurtjes: waarde, volgorde, en draaien waar de volgorde verandert.
        const figRow = $('[data-figs]');
        if (figRow) {
          const cards = Object.fromEntries($$('[data-fig]').map((li) => [li.dataset.fig, li]));
          const before = new Map(Object.entries(cards).map(([k, el]) => [k, el.getBoundingClientRect()]));
          const was = $$('[data-fig]').map((li) => li.dataset.fig);
          const order: string[] = country ? country.order : data.europe.order;
          order.forEach((key, n) => {
            const li = cards[key];
            if (!li) return;
            figRow.append(li);
            const eu = data.europe.stops.find((s: any) => s.key === key);
            const own = country?.stops.find((s: any) => s.key === key);
            li.querySelector('[data-fig-n]')!.textContent = String(n + 1);
            li.querySelector('[data-fig-value]')!.textContent = own ? own.value : eu.value;
            li.querySelector('[data-fig-sub]')!.textContent = own ? `${figRow.dataset.euWord} ${eu.value}` : (figRow.dataset.euName ?? '');
            li.querySelector('[data-fig-diff]')!.textContent = own && own.value !== '—' ? own.diff : '';
            li.toggleAttribute('data-swapped', data.europe.order.indexOf(key) !== n);
            li.toggleAttribute('data-empty', Boolean(own && own.value === '—'));
          });
          if (animateIt && !still) {
            order.forEach((key, n) => {
              const li = cards[key];
              if (!li) return;
              const from = before.get(key)!;
              const to = li.getBoundingClientRect();
              const moved = was.indexOf(key) !== n;
              if (from.left !== to.left || from.top !== to.top) {
                li.animate([{ transform: `translate(${from.left - to.left}px, ${from.top - to.top}px)` }, { transform: 'none' }], { duration: 650, easing: 'cubic-bezier(.2,.8,.2,1)' });
              }
              spin(li, moved ? 450 : n * 90, moved ? 900 : 700);
            });
          }
        }
        const story = $('[data-figs-story]');
        if (story) story.textContent = country ? country.story : data.europe.story;
        titled($('[data-life-title]'), country);

        // Elk cijfer: de rang in plaats van de spreiding.
        for (const row of $$('[data-row]')) {
          const key = row.dataset.row ?? '';
          const cell = country?.phases.flatMap((p: any) => p.rows).find((r: any) => r.key === key);
          const base = europeRows[key];
          row.querySelector('[data-row-value]')!.textContent = cell ? cell.value : base.value;
          row.querySelector('[data-row-note]')!.textContent = cell ? cell.note : base.note;
          row.setAttribute('href', cell ? cell.path : base.href);
          row.toggleAttribute('data-top', Boolean(cell?.top));
          row.toggleAttribute('data-empty', Boolean(country && cell && cell.value === '—'));
        }
        const ranksTitle = $('[data-ranks-title]');
        titled(ranksTitle, country);
        titled($('[data-ranks-lead]'), country);

        // Drie feiten.
        titled($('[data-facts-title]'), country);
        if (factsBox) {
          if (!country) factsBox.innerHTML = europeFacts;
          else {
            factsBox.innerHTML = '';
            const template = document.createElement('template');
            for (const f of country.facts) {
              template.innerHTML = '<a class="fact"><span class="k mono"></span><p></p><span class="arr"></span></a>';
              const a = template.content.firstElementChild as HTMLAnchorElement;
              a.href = f.path;
              a.querySelector('.k')!.textContent = f.label;
              a.querySelector('p')!.textContent = f.text;
              a.querySelector('.arr')!.textContent = `${factsBox.dataset.openIt ?? ''} →`;
              factsBox.append(a);
            }
          }
        }
      }

      /** Eén keer ronddraaien als de figuurtjes in beeld komen. */
      const figRowForEntrance = $('[data-figs]');
      if (figRowForEntrance && !still && 'IntersectionObserver' in window) {
        const seen = new IntersectionObserver((entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          seen.disconnect();
          $$('[data-fig]').forEach((li, n) => spin(li, 200 + n * 260));
        }, { threshold: 0.35 });
        seen.observe(figRowForEntrance);
      }

      select.addEventListener('change', () => {
        show(select.value);
        if (select.value) mergeProfile({ country: select.value });
        document.dispatchEvent(new CustomEvent('ha:country', { detail: { code: select.value } }));
      });

      const saved = readProfile();
      if (typeof saved.country === 'string' && data.countries[saved.country]) {
        select.value = saved.country;
        show(saved.country, false);
      }
    }
  </script>

  {/*
    Globaal en niet scoped: de feitkaartjes van een gekozen land maakt het script, en die
    dragen het kenmerk niet waarmee Astro scoped stijlen aan elementen koppelt. Op 20
    november stonden ze daardoor als kale onderstreepte links. De namen zijn uniek voor
    deze pagina.
  */}
  <style is:global>
    .door-hero { padding-bottom: clamp(28px, 4vw, 48px); }
    .door-hero h1 { max-width: 16ch; }
    .door-hero .lead { max-width: 60ch; }

    .pick { margin-top: 30px; max-width: 34rem; }
    .pick-label { display: block; margin-bottom: 10px; font: 500 0.72rem/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-2); }
    .pick select {
      width: 100%; padding: 16px 20px; border: 2px solid var(--line-strong);
      border-radius: 999px; background: var(--surface); color: var(--text);
      font: 700 1.15rem/1.2 var(--font-sans); cursor: pointer;
    }
    .pick select:focus-visible { outline: 2px solid var(--data); outline-offset: 2px; }
    .pick .hint { margin-top: 10px; }

    /* De levensloop in vier figuurtjes */
    .figs { margin: 0; }
    .figs-row { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    @media (max-width: 760px) { .figs-row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } }
    .fig-card a {
      position: relative; display: grid; justify-items: center; align-content: start; gap: 4px; height: 100%;
      padding: 14px 12px 18px; border: 1px solid var(--line); border-radius: var(--radius-md);
      background: var(--surface); color: var(--text); text-align: center; text-decoration: none;
      transition: border-color .3s, transform .3s var(--ease);
    }
    .fig-card a:hover { border-color: color-mix(in oklab, var(--data) 55%, var(--line)); transform: translateY(-3px); text-decoration: none; }
    .fig-card[data-swapped] a { outline: 2px solid var(--data); outline-offset: 3px; }
    .fig-card[data-empty] a { opacity: .5; }
    .fig-n { position: absolute; top: 12px; left: 12px; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: .76rem; font-weight: 700; background: var(--data); color: var(--bg); }
    .fig-turn { display: block; width: 100%; perspective: 600px; }
    .lf { display: block; width: 100%; max-width: 150px; height: auto; margin: 4px auto 0; color: var(--data); transform-style: preserve-3d; }
    .lf-disk { fill: color-mix(in oklab, var(--data) 18%, transparent); }
    .fig-age { margin-top: 4px; font: 800 clamp(1.7rem, 1.2rem + 1.6vw, 2.5rem)/1 var(--font-display); color: var(--data); letter-spacing: -.03em; }
    .fig-age small { font: 500 .72rem/1 var(--font-mono); color: var(--text-2); letter-spacing: .04em; }
    .fig-label { font-weight: 700; line-height: 1.25; }
    .fig-sub, .fig-diff { color: var(--text-2); font-size: .86rem; line-height: 1.4; }
    .fig-diff:empty { display: none; }
    .figs-story { margin-top: 20px; max-width: 62ch; min-height: 3.2em; font-size: 1.1rem; line-height: 1.5; }
    .figs figcaption { margin-top: 14px; max-width: 72ch; color: var(--text-2); font-size: .88rem; line-height: 1.55; }

    /* Elk cijfer, per levensfase */
    .phases { display: grid; gap: 28px 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
    .phase h3 { margin: 0 0 10px; font-size: .72rem; letter-spacing: .09em; text-transform: uppercase; color: var(--text-2); }
    .phase ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .rankrow {
      display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; align-items: baseline; padding: 14px 18px;
      border: 1px solid var(--line); border-left: 4px solid var(--data); border-radius: var(--radius-md);
      background: var(--surface); color: var(--text); text-decoration: none; transition: border-color .3s, transform .3s var(--ease);
    }
    .rankrow:hover { transform: translateX(3px); text-decoration: none; }
    .rankrow .k { font-weight: 700; }
    .rankrow .v { font: 800 1.35rem/1 var(--font-display); color: var(--data); text-align: right; white-space: nowrap; }
    .rankrow .rank-note { grid-column: 1 / -1; color: var(--text-2); font-size: .9rem; }
    .rankrow[data-top] .rank-note { color: var(--text); font-weight: 600; }
    .rankrow[data-empty] { opacity: .55; }

    /* Drie feiten */
    .facts { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
    .fact {
      display: flex; flex-direction: column; gap: 10px; padding: 22px 24px; border: 1px solid var(--line); border-radius: var(--radius-md);
      background: var(--surface); color: var(--text); text-decoration: none; transition: border-color .3s, transform .3s var(--ease);
    }
    .fact:hover { border-color: color-mix(in oklab, var(--data) 55%, var(--line)); transform: translateY(-3px); text-decoration: none; }
    .fact .k { font-size: .7rem; letter-spacing: .09em; text-transform: uppercase; color: var(--text-2); }
    .fact p { margin: 0; flex: 1 1 auto; font-size: 1.08rem; line-height: 1.5; }
    .fact .arr { font-weight: 600; font-size: .92rem; color: var(--data); }

    .notelist { display: grid; gap: 12px; }
    .noteitem { display: block; padding: 22px 24px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); color: var(--text); text-decoration: none; transition: border-color .3s, transform .3s var(--ease); }
    .noteitem:hover { border-color: color-mix(in oklab, var(--glow) 55%, var(--line)); transform: translateY(-3px); text-decoration: none; }
    .noteitem h3 { margin: 8px 0 10px; font-size: 1.3rem; letter-spacing: -.03em; }
    .noteitem p { max-width: 70ch; color: var(--text-2); line-height: 1.65; }
    .noteitem .arr { display: inline-block; margin-top: 14px; font-weight: 600; color: var(--data); }
    .more { margin-top: 16px; }
  </style>
</BaseV2>
