---
import { ui } from '../../../lib/ui.js';
import { localeOf, localePaths, linkTo } from '../../../lib/locales.js';
import BaseV2 from '../../../layouts/BaseV2.astro';

/** De taal van deze pagina; elke interne link hieronder draagt haar voorvoegsel. */
const lang = localeOf(Astro.url.pathname);
const t = ui(lang).contact;

const title = 'Contact — HumanAverage';
const description =
  'Questions, corrections and source suggestions for HumanAverage. Demonstrable errors are ' +
  'fixed and the correction is noted.';
/** Eén pad per taal. Zolang LOCALES alleen Engels bevat is dat precies dit pad. */
export function getStaticPaths() {
  return localePaths();
}

---

<BaseV2 title={title} description={description} canonical="/contact/">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">{t.contact}</p>
      <h1>{t.foundAMistakeTell}</h1>
      <p class="lead">
        {t.aSiteBuiltOn}
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap prose">
      <h2>{t.email}</h2>
      <p>
        <a class="btn" href="mailto:firenature23@gmail.com">firenature23@gmail.com</a>
      </p>
      <p>
        {t.thereIsNoContact}
      </p>

      <h2>{t.whatHelps}</h2>
      <ul>
        <li>
          <strong>About a specific result:</strong> the page, the country you chose, the value
          you entered and the answer you got back. That is enough to reproduce it exactly.
        </li>
        <li>
          <strong>About a figure you think is wrong:</strong> which number, and what you believe
          it should be. A source makes it far quicker to check — and if you are right, it gets
          corrected.
        </li>
        <li>
          <strong>About something not working:</strong> your device, browser and what you did
          just before it broke.
        </li>
        <li>
          <strong>Suggesting a dataset:</strong> a link to the data itself, not to an article
          about it. What works best is a series an agency publishes per country and keeps
          updating.
        </li>
      </ul>

      <h2>{t.whatThisIsNot}</h2>
      <div class="limits">
        <p>
          {t.humanaverageCannotAnswerMedical}
        </p>
      </div>

      <p>
        Background on who runs this and how it is funded is on the
        <a href={linkTo('/about/', lang)}>about page</a>. How the numbers are produced is on the
        <a href={linkTo('/method/', lang)}>method page</a>.
      </p>
    </div>
  </section>
</BaseV2>
