---
import { ui } from '../../../lib/ui.js';
import { localeOf, localePaths } from '../../../lib/locales.js';
import BaseV2 from '../../../layouts/BaseV2.astro';

/** De taal van deze pagina, en de vaste tekst erin. Zie src/lib/ui.js. */
const lang = localeOf(Astro.url.pathname);
const t = ui(lang).privacy;

/**
 * Dit beleid moet beschrijven wat de site fetitelijk doet, niet wat we van plan
 * zijn. Verandert er iets aan de verwerking — analytics, advertenties — dan gaat
 * deze pagina eerst om, en pas daarna de code.
 */
const updated = '25 October 2026';

const title = 'Privacy — HumanAverage';
const description =
  'What HumanAverage does and does not collect. No accounts, no analytics, no advertising ' +
  'code, and your measurements never leave your browser.';
/** Eén pad per taal. Zolang LOCALES alleen Engels bevat is dat precies dit pad. */
export function getStaticPaths() {
  return localePaths();
}

---

<BaseV2 title={title} description={description} canonical="/privacy/">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">{t.privacy}</p>
      <h1>{t.whatWeCollectAlmost}</h1>
      <p class="lead">
        {t.whatYouTypeIs}
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap prose">
      <p class="field-hint">Last updated: {updated}</p>

      <h2>{t.theValuesYouEnter}</h2>
      <p>
        {t.thePagesAskFor}
      </p>

      <h3>{t.whatYourBrowserRemembers}</h3>
      <p>
        {t.onTheEuropeanComparison}
      </p>

      <div class="limits">
        <p>
          <strong>Sharing a result.</strong> Where a page offers to copy your result, what lands
          on your clipboard is a short piece of text: your own figure, the published figure it was
          compared against, and the address of the page. No link carries your values in the web
          address, and nothing is sent anywhere — the copy happens in your browser and stops there.
          What you then paste, and to whom, is yours to decide.
        </p>
      </div>

      <h2>{t.analyticsAndCookies}</h2>
      <p>
        {t.thisSiteSetsNo}
      </p>
      <p>
        {t.thatMayChangeIf}
      </p>

      <h2>{t.technicallyNecessaryData}</h2>
      <p>
        As with virtually any website, the hosting provider processes technical request data:
        an IP address, the time, the page requested, browser information and errors. This is
        necessary to deliver the site securely. HumanAverage is hosted by
        <a href="https://vercel.com/legal/privacy-policy" rel="noopener">Vercel</a>.
      </p>
      <p>
        {t.weDoAlsoUse}
      </p>

      <h2>{t.externalLinks}</h2>
      <p>
        {t.weLinkToThe}
      </p>

      <h2>{t.email}</h2>
      <p>
        If you email <a href="mailto:firenature23@gmail.com">firenature23@gmail.com</a> we
        receive your address, your message and anything else you choose to include, and use it
        only to handle your question. Email is processed through Gmail, so Google's privacy
        policy also applies. Please do not send passwords, medical records or other sensitive
        information.
      </p>

      <h2>{t.yourRights}</h2>
      <p>
        Because we never receive your measurements, we cannot show you, correct or delete them —
        there is nothing on our side to act on. For questions about other data, about deleting
        an email you sent us, or about this policy, write to
        <a href="mailto:firenature23@gmail.com">firenature23@gmail.com</a>.
      </p>
    </div>
  </section>
</BaseV2>
